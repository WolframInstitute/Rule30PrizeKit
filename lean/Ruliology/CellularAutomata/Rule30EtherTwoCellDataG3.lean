def dataAllG3 (p φ : Nat) : List (Nat × Nat × Nat) := (dataTabG3.getD (p - 6) []).getD φ []

def checkAllG3 : Bool :=
  (List.range 2).all (fun i =>
    (List.range 4).all (fun φ =>
      let p := i + 6
      ((dataAllG3 p φ).length == Mfun p φ - p - 1) && checkRange (dataAllG3 p φ) p φ))

theorem checkAllG3_ok : checkAllG3 = true := by decide

theorem checkAllG3_range (p φ : Nat) (hp0 : 6 ≤ p) (hp1 : p ≤ 7) (hφ : φ < 4) :
    (dataAllG3 p φ).length = Mfun p φ - p - 1 ∧ checkRange (dataAllG3 p φ) p φ = true := by
  have h := checkAllG3_ok
  unfold checkAllG3 at h
  have h1 := List.all_eq_true.1 h (p - 6) (List.mem_range.2 (by omega))
  have h2 := List.all_eq_true.1 h1 φ (List.mem_range.2 hφ)
  rw [show p - 6 + 6 = p by omega] at h2
  simp only [Bool.and_eq_true] at h2
  exact ⟨beq_iff_eq.1 h2.1, h2.2⟩

