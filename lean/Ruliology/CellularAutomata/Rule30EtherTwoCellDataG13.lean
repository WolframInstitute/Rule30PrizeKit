def dataAllG13 (p φ : Nat) : List (Nat × Nat × Nat) := (dataTabG13.getD (p - 22) []).getD φ []

def checkAllG13 : Bool :=
  (List.range 9).all (fun i =>
    (List.range 4).all (fun φ =>
      let p := i + 22
      ((dataAllG13 p φ).length == Mfun p φ - p - 1) && checkRange (dataAllG13 p φ) p φ))

theorem checkAllG13_ok : checkAllG13 = true := by decide

theorem checkAllG13_range (p φ : Nat) (hp0 : 22 ≤ p) (hp1 : p ≤ 30) (hφ : φ < 4) :
    (dataAllG13 p φ).length = Mfun p φ - p - 1 ∧ checkRange (dataAllG13 p φ) p φ = true := by
  have h := checkAllG13_ok
  unfold checkAllG13 at h
  have h1 := List.all_eq_true.1 h (p - 22) (List.mem_range.2 (by omega))
  have h2 := List.all_eq_true.1 h1 φ (List.mem_range.2 hφ)
  rw [show p - 22 + 22 = p by omega] at h2
  simp only [Bool.and_eq_true] at h2
  exact ⟨beq_iff_eq.1 h2.1, h2.2⟩

