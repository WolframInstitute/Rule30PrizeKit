def dataAllG6 (p φ : Nat) : List (Nat × Nat × Nat) := (dataTabG6.getD (p - 11) []).getD φ []

def checkAllG6 : Bool :=
  (List.range 1).all (fun i =>
    (List.range 4).all (fun φ =>
      let p := i + 11
      ((dataAllG6 p φ).length == Mfun p φ - p - 1) && checkRange (dataAllG6 p φ) p φ))

theorem checkAllG6_ok : checkAllG6 = true := by decide

theorem checkAllG6_range (p φ : Nat) (hp0 : 11 ≤ p) (hp1 : p ≤ 11) (hφ : φ < 4) :
    (dataAllG6 p φ).length = Mfun p φ - p - 1 ∧ checkRange (dataAllG6 p φ) p φ = true := by
  have h := checkAllG6_ok
  unfold checkAllG6 at h
  have h1 := List.all_eq_true.1 h (p - 11) (List.mem_range.2 (by omega))
  have h2 := List.all_eq_true.1 h1 φ (List.mem_range.2 hφ)
  rw [show p - 11 + 11 = p by omega] at h2
  simp only [Bool.and_eq_true] at h2
  exact ⟨beq_iff_eq.1 h2.1, h2.2⟩

