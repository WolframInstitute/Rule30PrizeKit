theorem checked_leaf (n m f : Nat) (c : Leaf)
    (hm : c.length=m) (hf : c.gate=f) (hv : LeafValid n c) :
    checkTree n m f (.leaf c) = true := by simp [checkTree,hm,hf,hv]

theorem checked_branch (n m f : Nat) (lo hi : CoverTree)
    (el : ExtendValid m f false f) (eh : ExtendValid m f true (f+2^m))
    (hl : checkTree n (m+1) f lo = true) (hh : checkTree n (m+1) (f+2^m) hi = true) :
    checkTree n m f (.branch lo hi) = true := by simp [checkTree,el,eh,hl,hh]
