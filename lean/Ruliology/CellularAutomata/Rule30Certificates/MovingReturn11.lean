theorem linear_words (m : Nat) :
    ∃ L : List (List Bool),
      L.length ≤ 81 + m * 14 ∧
      ∀ (x : Int → Bool), orbit x 11 = x → ∀ origin : Int, rowWord x origin m ∈ L :=
  linear_words_of_strip potential_ok strip_window_in_states m

