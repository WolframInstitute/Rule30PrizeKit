module

/-!
# Rule 30: the width-13 strip certificate behind period 2 (data and kernel check)

Data for `Rule30PeriodTwoWidth13`. Under an alternating center column (black, white from some
time on), the columns `1..13` and the center form a strip whose state is a node `v < 2 ^ 14`:
`v % 2 ^ 13` codes columns `1..13` (bit `i` is column `i + 1`), `v / 2 ^ 13` is the center. One
step is `succN v f`, where the bit `f` is column `14`, left free (any right half).

The certificate assigns to each of the `16384` nodes a rank (`rk`), a mode (`md`) and a set of
states of a gap automaton (`lab`, a `60`-bit mask). The automaton `delta` reads the *kicks*
(white center, black column `1`) and accepts the gaps of `2`, `3`, `4` or `5` pairs of steps
whose consecutive pairs are `22 24 25 33 35 45 52 53 55` (mode `1`), or only the gap `4`
(mode `2`). `certOK` checks, at every node and for both values of the free bit, that the rank
does not decrease, and that a step inside one rank keeps a nonzero mode and maps the label of
the node into the label of its successor under the automaton. So along every infinite path the
rank is eventually constant, and from then on one automaton accepts the kicks.

`certOK_kernel`: the check, decided by the kernel (`decide +kernel`) in `16` chunks of `1024`
nodes.
-/

@[expose] public section

-- Sequential elaboration: the chunk checks would otherwise run in parallel and stack their memory.
set_option Elab.async false

namespace Ruliology.CellularAutomata.Rule30PeriodTwoWidth13

/-- Ranks and modes: bits `16 v … 16 v + 13` of `Rtab` are the rank of node `v`, bits
`16 v + 14`, `16 v + 15` its mode. -/
def Rtab : Nat := 

/-- Labels: bits `64 v … 64 v + 59` of `Ltab` are the automaton states allowed at node `v`. -/
def Ltab : Nat := 

/-- strip width: columns 1..J are exact, column J+1 is free at every step. -/
def J : Nat := 13
def M : Nat := 2 ^ J
def NN : Nat := 2 * M

/-- one step of the strip.  `v = x + M*ph`, `ph` = center value, `f` = free column `J+1`.
New column `i+1` = column `i` xor (column `i+1` or column `i+2`), column 0 = center. -/
def succN (v f : Nat) : Nat :=
  ((((v % M ||| (f <<< J)) <<< 1) ||| v / M) ^^^ ((v % M ||| (f <<< J)) ||| ((v % M ||| (f <<< J)) >>> 1))) % M
    + M * (1 - v / M)

/-- a kick: white center and black column 1. -/
def kick (v : Nat) : Bool := decide (v < M) && v % 2 == 1

def rk (v : Nat) : Nat := (Rtab >>> (16 * v)) % 16384
def md (v : Nat) : Nat := (Rtab >>> (16 * v + 14)) % 4
def lab (v : Nat) : Nat := (Ltab >>> (64 * v)) % 18446744073709551616

/-- allowed gaps (in pairs of time steps) for mode 1 (E2) and mode 2 (pure 4). -/
def gapOK (m g : Nat) : Bool := if m == 1 then (decide (2 ≤ g) && decide (g ≤ 5)) else g == 4

/-- allowed consecutive gap pairs: E2 = {22,24,25,33,35,45,52,53,55}; pure 4 = {44}. -/
def pairOK (m p g : Nat) : Bool :=
  if m == 1 then [(2,2),(2,4),(2,5),(3,3),(3,5),(4,5),(5,2),(5,3),(5,5)].contains (p, g)
  else (p == 4 && g == 4)

/-- the gap automaton.  States `q < 10`: no kick seen yet, `q` steps; `q = 10 + 10*pi + s`
(`q < 60`): `s` steps since the last kick, previous gap `pi + 1` pairs (`pi = 0`: unknown). -/
def delta (m q : Nat) (k : Bool) : Option Nat :=
  if q < 10 then (if k then some 10 else if q < 9 then some (q + 1) else none)
  else if q < 60 then
    if k then
      (if (q - 10) % 10 % 2 == 1 && decide (3 ≤ (q - 10) % 10) then
        (if gapOK m (((q - 10) % 10 + 1) / 2) &&
            ((q - 10) / 10 == 0 || pairOK m ((q - 10) / 10 + 1) (((q - 10) % 10 + 1) / 2))
         then some (10 + 10 * (((q - 10) % 10 + 1) / 2 - 1)) else none)
       else none)
    else (if (q - 10) % 10 < 9 then some (q + 1) else none)
  else none

def stOK (m : Nat) (k : Bool) (Lw : Nat) (q : Nat) : Bool :=
  match delta m q k with
  | some q' => Lw.testBit q'
  | none => false

def levelOK (m : Nat) (k : Bool) (Lu Lw : Nat) : Bool :=
  (List.range 60).all (fun q => !Lu.testBit q || stOK m k Lw q)

def edgeOK' (ru mu Lu w : Nat) : Bool :=
  Nat.ble ru (rk w) && (ru != rk w || (mu != 0 && md w == mu && levelOK mu (kick w) Lu (lab w)))

def nodeOK' (u ru mu Lu : Nat) : Bool :=
  (mu == 0 || Lu.testBit 0) && edgeOK' ru mu Lu (succN u 0) && edgeOK' ru mu Lu (succN u 1)

def nodeOK (u : Nat) : Bool := nodeOK' u (rk u) (md u) (lab u)

def certOK : Bool := (List.range NN).all nodeOK

/-! ## The check, in `16` chunks of `1024` nodes

Each chunk is a separate kernel check, so the kernel's cache is released between chunks. -/

/-- The check at the nodes `a, …, a + n - 1`. -/
def certRange (a n : Nat) : Bool := (List.range' a n).all nodeOK

theorem chunk0 : certRange (0 * 1024) 1024 = true := by decide +kernel
theorem chunk1 : certRange (1 * 1024) 1024 = true := by decide +kernel
theorem chunk2 : certRange (2 * 1024) 1024 = true := by decide +kernel
theorem chunk3 : certRange (3 * 1024) 1024 = true := by decide +kernel
theorem chunk4 : certRange (4 * 1024) 1024 = true := by decide +kernel
theorem chunk5 : certRange (5 * 1024) 1024 = true := by decide +kernel
theorem chunk6 : certRange (6 * 1024) 1024 = true := by decide +kernel
theorem chunk7 : certRange (7 * 1024) 1024 = true := by decide +kernel
theorem chunk8 : certRange (8 * 1024) 1024 = true := by decide +kernel
theorem chunk9 : certRange (9 * 1024) 1024 = true := by decide +kernel
theorem chunk10 : certRange (10 * 1024) 1024 = true := by decide +kernel
theorem chunk11 : certRange (11 * 1024) 1024 = true := by decide +kernel
theorem chunk12 : certRange (12 * 1024) 1024 = true := by decide +kernel
theorem chunk13 : certRange (13 * 1024) 1024 = true := by decide +kernel
theorem chunk14 : certRange (14 * 1024) 1024 = true := by decide +kernel
theorem chunk15 : certRange (15 * 1024) 1024 = true := by decide +kernel

theorem chunks_ok : ∀ i, i < 16 → certRange (i * 1024) 1024 = true
  | 0, _ => chunk0
  | 1, _ => chunk1
  | 2, _ => chunk2
  | 3, _ => chunk3
  | 4, _ => chunk4
  | 5, _ => chunk5
  | 6, _ => chunk6
  | 7, _ => chunk7
  | 8, _ => chunk8
  | 9, _ => chunk9
  | 10, _ => chunk10
  | 11, _ => chunk11
  | 12, _ => chunk12
  | 13, _ => chunk13
  | 14, _ => chunk14
  | 15, _ => chunk15
  | _ + 16, h => absurd h (by omega)

/-- The certificate holds at every node (kernel check, by chunks). -/
theorem certOK_kernel : certOK = true := by
  unfold certOK
  rw [List.all_eq_true]
  intro u hu
  have hu' : u < 16 * 1024 := List.mem_range.1 hu
  have h := chunks_ok (u / 1024) (by omega)
  unfold certRange at h
  rw [List.all_eq_true] at h
  exact h u (List.mem_range'_1.2 ⟨by omega, by omega⟩)

end Ruliology.CellularAutomata.Rule30PeriodTwoWidth13
