section
namespace Ruliology.CellularAutomata.Rule30Certificates.RequiredGapFactor
open Ruliology.CellularAutomata Rule30StripCertificates Rule30FastImage Ruliology.CellularAutomata.Rule30RequiredGapLogic.RunFamilies
open Ruliology.CellularAutomata.Rule30RequiredGapLogic.StripInclusion (sub sub_mem)
set_option maxHeartbeats 0
theorem union_iff (h:Nat) (xs:List Nat) (r:Nat) : (union h xs).testBit r=true ↔ ∃i,i∈xs ∧ (group i h).testBit r=true :=by
  induction xs with
  | nil=>simp [union]
  | cons x xs ih=>
    rw [union,Nat.testBit_or,Bool.or_eq_true,ih];constructor
    · rintro (a|⟨i,hi,hm⟩)
      · exact ⟨x,List.mem_cons_self,a⟩
      · exact ⟨i,List.mem_cons_of_mem _ hi,hm⟩
    · rintro ⟨i,hi,h⟩;rcases List.mem_cons.mp hi with rfl|a
      · exact Or.inl h
      · exact Or.inr ⟨i,a,h⟩
def falseMask := bm 0 19 &&& (bm 1 19 ||| bm 2 19)
def bandColor (i:Nat) := decide (i=2)
def colorMask (c:Bool) := if c then fullSet 19 ^^^ falseMask else falseMask
theorem mask_color {r:Nat} (hr:r<2^19) (c:Bool) (h:(colorMask c).testBit r=true) : pulseColor r=c :=by
  cases c <;> simp [colorMask,falseMask,Rule30FastImage.testBit_fullSet,hr,Nat.testBit_and,Nat.testBit_or,Nat.testBit_xor,testBit_bm] at h <;>
    cases a:r.testBit 0 <;> cases b:r.testBit 1 <;> cases d:r.testBit 2 <;> simp_all [pulseColor]
private theorem levels : (List.range 3).all (fun h=>warm 0 h==fullSet 19 && warm 7 h==upper 0 h && upper 4 h==0 &&
    sub (upper 0 h) (upper 1 h ||| union h allHot) &&
    (List.range 3).all (fun j=>sub (upper (j+1) h) (upper (j+2) h ||| colorMask (bandColor (j+1)))))=true :=by decide +kernel
theorem level_data (h:Nat) (hh:h<3) :
    warm 0 h=fullSet 19 ∧ warm 7 h=upper 0 h ∧ upper 4 h=0 ∧ sub (upper 0 h) (upper 1 h ||| union h allHot)=true ∧
    ∀i,1≤i→i≤3→sub (upper i h) (upper (i+1) h ||| colorMask (bandColor i))=true :=by
  have z:=List.all_eq_true.mp levels h (List.mem_range.mpr hh)
  simp only [Bool.and_eq_true,beq_iff_eq] at z
  refine ⟨z.1.1.1.1,z.1.1.1.2,z.1.1.2,z.1.2,?_⟩
  intro i lo hi;obtain ⟨j,rfl⟩:=Nat.exists_eq_succ_of_ne_zero (show i≠0 by omega);exact List.all_eq_true.mp z.2 j (List.mem_range.mpr (by omega))
theorem uniform {i h r:Nat} (hh:h<3) (lo:1≤i) (hi:i≤3) (hr:r<2^19) (yes:(upper i h).testBit r=true)
    (no:¬(upper (i+1) h).testBit r=true) : pulseColor r=bandColor i :=by
  have inc:=sub_mem ((level_data h hh).2.2.2.2 i lo hi) yes
  rw [Nat.testBit_or,Bool.or_eq_true] at inc;exact mask_color hr _ (inc.resolve_left no)
theorem hot {h r:Nat} (hh:h<3) (yes:(upper 0 h).testBit r=true) (no:¬(upper 1 h).testBit r=true) :
    ∃i:Fin 6,(group i.val h).testBit r=true :=by
  have inc:=sub_mem (level_data h hh).2.2.2.1 yes
  rw [Nat.testBit_or,Bool.or_eq_true] at inc
  obtain ⟨i,hi,e⟩:=(union_iff h allHot r).mp (inc.resolve_left no)
  exact ⟨⟨i,List.mem_range.mp hi⟩,e⟩
private theorem separate : (List.range 3).all (fun h=>(List.range 6).all (fun i=>(List.range 6).all
    (fun j=>i==j || (group i h &&& group j h)==0)))=true :=by decide +kernel
theorem unique_group {i j:Fin 6} {r h:Nat} (hh:h<3) (u:(group i.val h).testBit r=true) (v:(group j.val h).testBit r=true) : i=j :=by
  have z:=List.all_eq_true.mp (List.all_eq_true.mp (List.all_eq_true.mp separate _ (List.mem_range.mpr hh)) _ (List.mem_range.mpr i.isLt)) _ (List.mem_range.mpr j.isLt)
  rw [Bool.or_eq_true] at z;rcases z with a|b
  · exact Fin.ext (beq_iff_eq.mp a)
  · have bits:=congrArg (fun n:Nat=>n.testBit r) (beq_iff_eq.mp b);simp [Nat.testBit_and,u,v] at bits
private theorem groupColorData : (List.range 3).all (fun h=>(List.range 6).all (fun i=>sub (group i h) (colorMask (colors i))))=true :=by decide +kernel
theorem group_color (i:Fin 6) {r h:Nat} (hh:h<3) (hr:r<2^19) (m:(group i.val h).testBit r=true):pulseColor r=colors i.val :=
  mask_color hr _ (sub_mem (List.all_eq_true.mp (List.all_eq_true.mp groupColorData _ (List.mem_range.mpr hh)) _ (List.mem_range.mpr i.isLt)) m)
theorem kids_bound (i:Fin 6) (q k:Nat) (hq:q∈alphabet) (h:k∈dest i.val q) : k<6 :=by
  have data : (List.range 6).all (fun a=>alphabet.all (fun l=>(dest a l).all (fun b=>decide (b<6))))=true :=by decide +kernel
  exact of_decide_eq_true (List.all_eq_true.mp (List.all_eq_true.mp (List.all_eq_true.mp data _ (List.mem_range.mpr i.isLt)) q hq) k h)
theorem child_of_out (i j:Fin 6) (h q r:Nat) (hq:q∈alphabet) (bound:next h q<3) (inside:(out i.val h q).testBit r=true)
    (no:¬(upper 1 (next h q)).testBit r=true) (member:(group j.val (next h q)).testBit r=true) : j.val∈dest i.val q :=by
  rw [out,Nat.testBit_or,Bool.or_eq_true] at inside
  obtain ⟨k,hk,key⟩:=(union_iff _ _ r).mp (inside.resolve_left no)
  have same: (⟨k,kids_bound i q k hq hk⟩:Fin 6)=j:=unique_group bound key member
  simpa only [←same] using hk
end Ruliology.CellularAutomata.Rule30Certificates.RequiredGapFactor

