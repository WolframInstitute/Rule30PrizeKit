section
namespace Ruliology.CellularAutomata.Rule30Certificates.RequiredGapFactor
open Ruliology.CellularAutomata Ruliology.CellularAutomata.Rule30RequiredGapLogic.RunFamilies Rule30FastImage Rule30StripCertificates
set_option maxHeartbeats 0
set_option maxRecDepth 20000
theorem wAll (i h:Nat) (hi:i<7) (hh:h<3) : Physical (warm i h) h (fun q=>warm (i+1) (next h q)) :=by
  match i,h with
  | 0,0=>exact pw0_0
  | 0,1=>exact pw0_1
  | 0,2=>exact pw0_2
  | 1,0=>exact pw1_0
  | 1,1=>exact pw1_1
  | 1,2=>exact pw1_2
  | 2,0=>exact pw2_0
  | 2,1=>exact pw2_1
  | 2,2=>exact pw2_2
  | 3,0=>exact pw3_0
  | 3,1=>exact pw3_1
  | 3,2=>exact pw3_2
  | 4,0=>exact pw4_0
  | 4,1=>exact pw4_1
  | 4,2=>exact pw4_2
  | 5,0=>exact pw5_0
  | 5,1=>exact pw5_1
  | 5,2=>exact pw5_2
  | 6,0=>exact pw6_0
  | 6,1=>exact pw6_1
  | 6,2=>exact pw6_2
  | i+7,_=>omega
  | _,h+3=>omega
theorem uAll (i h:Nat) (hi:i<4) (hh:h<3) : Physical (upper i h) h (fun q=>upper i (next h q)) :=by
  match i,h with
  | 0,0=>exact pu0_0
  | 0,1=>exact pu0_1
  | 0,2=>exact pu0_2
  | 1,0=>exact pu1_0
  | 1,1=>exact pu1_1
  | 1,2=>exact pu1_2
  | 2,0=>exact pu2_0
  | 2,1=>exact pu2_1
  | 2,2=>exact pu2_2
  | 3,0=>exact pu3_0
  | 3,1=>exact pu3_1
  | 3,2=>exact pu3_2
  | i+4,_=>omega
  | _,h+3=>omega
theorem vAll (i h:Nat) (hi:i<6) (hh:h<3) : Physical (group i h) h (out i h) :=by
  match i,h with
  | 0,0=>exact pv0_0
  | 0,1=>exact pv0_1
  | 0,2=>exact pv0_2
  | 1,0=>exact pv1_0
  | 1,1=>exact pv1_1
  | 1,2=>exact pv1_2
  | 2,0=>exact pv2_0
  | 2,1=>exact pv2_1
  | 2,2=>exact pv2_2
  | 3,0=>exact pv3_0
  | 3,1=>exact pv3_1
  | 3,2=>exact pv3_2
  | 4,0=>exact pv4_0
  | 4,1=>exact pv4_1
  | 4,2=>exact pv4_2
  | 5,0=>exact pv5_0
  | 5,1=>exact pv5_1
  | 5,2=>exact pv5_2
  | i+6,_=>omega
  | _,h+3=>omega
end Ruliology.CellularAutomata.Rule30Certificates.RequiredGapFactor

