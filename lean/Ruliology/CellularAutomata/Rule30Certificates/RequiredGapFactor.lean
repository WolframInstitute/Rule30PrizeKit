section
namespace Ruliology.CellularAutomata.Rule30Certificates.RequiredGapFactor
open Ruliology.CellularAutomata.Rule30RequiredGapLogic.RunFamilies
noncomputable def color (i:Fin 6) := colors i.val
noncomputable def edge (i:Fin 6) (q:Nat) (j:Fin 6) := j.val∈dest i.val q
noncomputable def pairCheck (i j:Nat) :=
  !(F i).testBit j || (((!(B i).testBit j) || (colors i==colors j)) &&
    alphabet.all (fun q=>(dest i q).all (fun k=>(dest j q).all
       (fun l=>(F k).testBit l && (!(B k).testBit l || (B i).testBit j)))))
noncomputable def rowCheck (i:Nat) := (F i).testBit i && (B i).testBit i && (List.range 6).all (pairCheck i)
end Ruliology.CellularAutomata.Rule30Certificates.RequiredGapFactor

end

section
namespace Ruliology.CellularAutomata.Rule30Certificates.RequiredGapFactor
set_option maxRecDepth 12000
set_option maxHeartbeats 0
theorem pair_data (i:Nat) (h:i<6) : rowCheck i=true :=by
  match i with
  | 0=>decide +kernel
  | 1=>decide +kernel
  | 2=>decide +kernel
  | 3=>decide +kernel
  | 4=>decide +kernel
  | 5=>decide +kernel
  | i+6=>omega
end Ruliology.CellularAutomata.Rule30Certificates.RequiredGapFactor

