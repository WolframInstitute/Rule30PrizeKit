private meta def digit (c : UInt8) : Nat :=
  let n := c.toNat
  if 65 ≤ n && n ≤ 90 then n-65 else if 97 ≤ n && n ≤ 122 then n-97+26
  else if 48 ≤ n && n ≤ 57 then n-48+52 else if n=43 then 62 else if n=47 then 63 else 64
/-- Integers use five little-endian payload bits; the sixth bit means another digit follows. -/
private meta def readCode (s : ByteArray) (p : Nat) : Option (Nat × Nat) := Id.run do
  let mut p := p
  let mut n := 0
  let mut bits := 0
  while h : p < s.size do
    let d := digit s[p]
    if d >= 64 then return none
    n := n ||| ((d % 32) <<< bits)
    p := p+1
    if d < 32 then return some (n,p)
    bits := bits+5
  return none
/-- Reconstruct one kernel Nat literal from dictionary indices and run lengths. -/
private meta def unpack (raw : String) : Option Nat := do
  let s := raw.toUTF8
  let mut blocks : Array Nat := #[]
  let mut i := 0
  while i < s.size do
    let (code, p) ← readCode s i
    let v ← words64[code/2]?
    let (copies, stop) ← if code%2=0 then some (1,p) else do
      let (extra,q) ← readCode s p
      pure (extra+2,q)
    for _ in [:copies] do blocks := blocks.push v
    i := stop
  let mut shift := 64
  while blocks.size > 1 do
    let mut next : Array Nat := #[]
    for j in [:(blocks.size+1)/2] do
      next := next.push (blocks[2*j]! ||| (blocks.getD (2*j+1) 0 <<< shift))
    blocks := next
    shift := 2*shift
  return blocks.getD 0 0
elab "stripMask% " raw:str : term => do
  let some result := unpack raw.getString | throwErrorAt raw "invalid rank-mask encoding"
  return mkNatLit result
end Ruliology.CellularAutomata.Rule30Certificates.RequiredGapFactor.MaskEncoding
