module

public import Ruliology.CellularAutomata.Rule30MovingStrip

/-!
Certificate data and kernel-checked RUP refutation for moving return period 3.
-/

@[expose] public section

namespace Ruliology.CellularAutomata.Rule30Certificates.MovingReturn03

open Ruliology.CellularAutomata.Rule30RingOrbits
open Ruliology.CellularAutomata.Rule30MovingStrip

set_option linter.all false
set_option maxRecDepth 1000000
set_option maxHeartbeats 0

abbrev p : Nat := 3
abbrev q : Nat := 12
abbrev cols : Nat := 6
abbrev offset : Nat := 1
abbrev w : Nat := 1
def states : List Nat := [0]
def base : List Nat := [1]
def slope : List Nat := [0]
def formula : List (List Nat) := stripFormula p q cols offset w states

-- Bit-mask clause database
noncomputable def M0 : Nat → Nat := (branch (nat_lit 3) (branch (nat_lit 1) (branch (nat_lit 0) (fun _ => nat_lit ) (fun _ => nat_lit )) (branch (nat_lit 2) (fun _ => nat_lit ) (fun _ => nat_lit ))) (branch (nat_lit 5) (branch (nat_lit 4) (fun _ => nat_lit ) (fun _ => nat_lit )) (branch (nat_lit 6) (fun _ => nat_lit ) (fun _ => nat_lit 0x2000000000000000020000000000000000000000000000000000100001000000000000000000000000000000000080000000000000000000001000000000000000010000000000000))))
noncomputable def get_M : Nat → Nat := M0

