def lastBands : List Nat := stages.getLastD firstBands

theorem cover_certificate : walk firstBands stages = true := by decide +kernel

/-- The even bit of each pair holds the current cell; the odd bit holds its neighbour
one site closer to the wall. The current cell feeds the next inverse layer. -/
def advance (b : Bool) (s : Nat) : Nat :=
  ((s &&& 85) <<< 1) ||| ((((s <<< 2) ||| b.toNat) ^^^ (s ||| (s >>> 1))) &&& 85)

def scan : Nat → Nat → Nat → Nat
  | 0, _, s => s
  | n+1, u, s => scan n (u >>> 1) (advance (u.testBit 0) s)

def closes (p : Nat) : Bool :=
  chk (fun s => scan (p.log2+1) p s == 0) 0 8

theorem reset_certificate : lastBands.all closes = true := by decide +kernel

