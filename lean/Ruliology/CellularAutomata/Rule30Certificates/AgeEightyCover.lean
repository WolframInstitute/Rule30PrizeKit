/-! Outer prefix transitions and four-layer inverse resets for the age-80 theorem. -/

@[expose] public section

namespace Ruliology.CellularAutomata.Rule30Certificates.AgeEightyCover

open Rule30LateTwins

set_option maxHeartbeats 0
set_option maxRecDepth 8192

def prefixOf (p u : Nat) : Bool :=
  u >>> (u.log2 - p.log2) == p

def covered (ps : List Nat) (u : Nat) : Bool := ps.any (prefixOf · u)

def links (ps ns : List Nat) : Bool :=
  ps.all fun p => covered ns (R (2*p)) && covered ns (R (2*p+1))

def walk (ps : List Nat) : List (List Nat) → Bool
  | [] => true
  | ns :: rest => links ps ns && walk ns rest

