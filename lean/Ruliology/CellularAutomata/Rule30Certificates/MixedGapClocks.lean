theorem entry (q : Nat) (h : Safe q) : Sub (mac q (fullSet 12)) F := by
  obtain rfl|many := h
  · exact sub_trans start7_cap (subset (by decide +kernel))
  · exact start_after _ many

theorem stableF (q : Nat) (h : Safe q) : Sub (mac q F) F := by
  have inc : Sub F (fullSet 12) := subset (by decide +kernel)
  exact sub_trans (mono inc _) (entry q h)

theorem stableE (q : Nat) (h : Safe q) : Sub (mac q E) E := by
  obtain rfl|many := h
  · exact sub_trans inside7_cap (subset (by decide +kernel))
  · exact inside_after _ many

theorem reset (q : Nat) (h : 22≤q) : Sub (mac q F) E := long_after q h

private theorem black_from_two (n : Nat) (h : 2≤n) : Const 12 (mac n E) true := by
  obtain ⟨k,rfl⟩ := Nat.exists_eq_add_of_le h
  clear h
  induction k with
  | zero => exact const_sub inside2_cap (constCheck_sound (by decide +kernel))
  | succ i ih => exact const_white (by decide) ih

theorem mask (n r : Nat) (h : r<2^12) (hr : (mac n E).testBit r=true) :
    r.testBit 0 = decide (2≤n) := by
  by_cases many : 2≤n
  · simpa only [decide_eq_true many] using black_from_two n many r h hr
  · obtain rfl|rfl : n=0 ∨ n=1 := by omega
    · exact const_sub inside0_cap (constCheck_sound (by decide +kernel)) r h hr
    · exact const_sub inside1_cap (constCheck_sound (by decide +kernel)) r h hr

