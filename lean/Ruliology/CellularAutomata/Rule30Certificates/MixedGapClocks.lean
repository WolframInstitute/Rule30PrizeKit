set_option maxRecDepth 16384
set_option maxHeartbeats 0
set_option exponentiation.threshold 8192

def W : Nat → Nat → Nat
  | 0,A => A
  | n+1,A => image 12 false (W n A)

def mac (n A : Nat) := W n (image 12 true A)
def Safe (q : Nat) : Prop := q=7 ∨ 9≤q

def F : Nat := 
def E : Nat := 

private theorem subset {A B : Nat} (h : A &&& B=A) : Sub A B := by
  intro s hs
  have v := congrArg (fun n : Nat => n.testBit s) h
  simpa only [Nat.testBit_and,hs,Bool.true_and] using v

private theorem step {A B : Nat} (c : Bool) (h : Sub A B) :
    Sub (image 12 c A) (image 12 c B) := imageAux_mono h (2^12)

private theorem walk {q A B V : Nat} (h : Sub (mac q A) B)
    (ok : covers 12 false B V=true) : Sub (mac (q+1) A) V :=
  sub_trans (step false h) (covers_sound ok)

private theorem pump {q t A U : Nat} (h : Sub (mac q A) U)
    (ok : covers 12 false U U=true) (hi : q≤t) : Sub (mac t A) U := by
  obtain ⟨k,rfl⟩ := Nat.exists_eq_add_of_le hi
  clear hi
  induction k with
  | zero => exact h
  | succ i ih => exact sub_trans (step false ih) (covers_sound ok)

private theorem mono {A B : Nat} (h : Sub A B) (q : Nat) : Sub (mac q A) (mac q B) := by
  induction q with
  | zero => exact step true h
  | succ q ih => exact step false ih

