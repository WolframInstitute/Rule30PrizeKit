module

public import Ruliology.CellularAutomata.Rule30Prize
public import Ruliology.CellularAutomata.Rule30GateTrap
public meta import Lean.Elab.Term

/-! Time masks for trapped-gate runs, checked under the packed double step and both exterior choices of the width-45 ladder. -/
@[expose] public section

namespace Ruliology.CellularAutomata.Rule30RunWindow
open Rule30DrivenPrefix

structure Window where
  width : Nat
  codes : List Nat
  deriving Inhabited, Repr, DecidableEq

def Holds (d : Window) (r : Nat) : Prop := r % 2 ^ d.width ∈ d.codes

def Trace (r : Nat) : List Window → Prop
  | [] => True
  | d :: ds => Holds d r ∧ Trace (double r) ds

end Ruliology.CellularAutomata.Rule30RunWindow

namespace Ruliology.CellularAutomata.Rule30TrappedRuns
open Rule30GateTrap Rule30RunWindow

def block : List Nat := [5,5,5,5,3]
def headsOf (g : List Nat) : List Bool :=
  true :: g.flatMap fun k => List.replicate (k-1) false ++ [true]
def closed (n : Nat) : List Bool := headsOf (3 :: (List.replicate n block).flatten)
def five : List Bool := headsOf (List.replicate 5 block).flatten

def entry (c : Option Bool) : Window :=
  ⟨16, match c with
       | none => trapCodes
       | some b => trapCodes.filter fun x => x.testBit 0 == b⟩

def colours : List (Option Bool) := none :: none :: (closed 4).map some
def initial : List Window := colours.map entry

end Ruliology.CellularAutomata.Rule30TrappedRuns

set_option maxRecDepth 100000
set_option maxHeartbeats 0
set_option Elab.async false
namespace Ruliology.CellularAutomata.Rule30TrappedRunMasks
open Rule30DrivenPrefix
/-- Leaves describe the sample times a prefix may reach. Each node stores the intersection
of its children as a lower bound and their union as an upper bound. Branches read spatial
bits from low to high. The table checks these bounds before they can be used. -/
inductive Tree where
  | leaf (m : Nat)
  | node (low high : Nat) (zero one : Tree)
  deriving Inhabited
def Tree.low : Tree → Nat
  | .leaf m => m
  | .node lo _ _ _ => lo
def Tree.high : Tree → Nat
  | .leaf m => m
  | .node _ hi _ _ => hi
def Tree.child (a : Tree) (b : Bool) : Tree :=
  match a with
  | .leaf _ => a
  | .node _ _ l r => if b then r else l
def Tree.follow (a : Tree) (row : Nat) : Nat → Tree
  | 0 => a
  | k+1 => (a.follow row k).child (row.testBit k)
def Tree.valid : Tree → Bool
  | .leaf _ => true
  | .node lo hi a b => (lo == a.low &&& b.low) && (hi == a.high ||| b.high) && a.valid && b.valid
def Tree.value (a : Tree) (r j : Nat) : Nat :=
  match a with
  | .leaf m => m
  | .node _ _ l h => if r.testBit j then h.value r (j+1) else l.value r (j+1)
/-- Every time set in a is also set in b. -/
def subset (a b : Nat) : Bool := (a &&& b) == a
def nextCode (p k : Nat) (bit : Bool) := if bit then p+2^(k+2) else p
/-- p contains k+2 input bits and fixes k output bits of the double step. Splitting
on the next input bit determines the next output bit. A branch closes as soon as every
possible source time, shifted through a matching output colour, is allowed at the target.
At zero fuel only the same containment test can succeed. -/
def check (colours : Nat) (a b : Tree) (k p : Nat) : Nat → Bool
  | 0 => subset ((a.high <<< 1) &&& colours) b.low
  | n+1 =>
    if subset ((a.high <<< 1) &&& colours) b.low then true else
    let visit (bit : Bool) := let q := nextCode p k bit
      check colours (a.child bit) (b.child ((double q).testBit k)) (k+1) q n
    visit false && visit true
/-- The sixteen four-bit starts fix both the first output colour and the first two output bits. -/
def checkAt (table : Tree) (white black k p : Nat) : Bool :=
  let out := double p
  check (if out.testBit 0 then black else white) (table.follow p k) (table.follow out (k-2)) (k-2) p 46

theorem Tree.bounds {a : Tree} (h : a.valid = true) (r k t : Nat) :
    (a.low.testBit t = true → (a.value r k).testBit t = true) ∧
    ((a.value r k).testBit t = true → a.high.testBit t = true) := by
  induction a generalizing k with
  | leaf m => exact ⟨id,id⟩
  | node lo hi a b ia ib =>
    simp only [Tree.valid, Bool.and_eq_true, beq_iff_eq] at h
    obtain ⟨⟨⟨rfl,rfl⟩,va⟩,vb⟩ := h
    have ba := ia va (k+1)
    have bb := ib vb (k+1)
    simp only [Tree.low,Tree.high,Tree.value,Nat.testBit_and,Nat.testBit_or,Bool.and_eq_true,Bool.or_eq_true]
    cases e : r.testBit k
    · simp only [Bool.false_eq_true,ite_false]; exact ⟨fun p => ba.1 p.1,fun p => Or.inl (ba.2 p)⟩
    · simp only [ite_true]; exact ⟨fun p => bb.1 p.2,fun p => Or.inr (bb.2 p)⟩

theorem Tree.child_valid {a : Tree} (va : a.valid = true) (b : Bool) :
    (a.child b).valid = true := by
  cases a with
  | leaf => rfl
  | node lo hi l r =>
    simp only [Tree.valid,Bool.and_eq_true] at va
    cases b
    · exact va.1.2
    · exact va.2

theorem Tree.child_value (a : Tree) (r k : Nat) :
    (a.child (r.testBit k)).value r (k+1) = a.value r k := by
  cases a with
  | leaf => rfl
  | node lo hi l h => cases e : r.testBit k <;> simp [Tree.child,Tree.value,e]

theorem Tree.follow_valid {a : Tree} (va : a.valid = true) (r k : Nat) :
    (a.follow r k).valid = true := by
  induction k with
  | zero => exact va
  | succ k ih => exact Tree.child_valid ih _

theorem Tree.follow_value (a : Tree) (r k : Nat) :
    (a.follow r k).value r k = a.value r 0 := by
  induction k with
  | zero => rfl
  | succ k ih => rw [Tree.follow,Tree.child_value,ih]

theorem Tree.follow_congr (a : Tree) (r s k : Nat) (h : ∀ i, i<k → r.testBit i = s.testBit i) :
    a.follow r k = a.follow s k := by
  induction k with
  | zero => rfl
  | succ k ih =>
    simp only [Tree.follow]
    rw [ih (fun i hi => h i (by omega)),h k (by omega)]

theorem Tree.follow_mod (a : Tree) (r k : Nat) : a.follow (r%2^k) k = a.follow r k :=
  a.follow_congr _ _ _ (fun i hi => by simp [Nat.testBit_mod_two_pow,hi])

theorem extend_code (r k : Nat) :
    nextCode (r%2^(k+2)) k (r.testBit (k+2)) = r%2^(k+3) := by
  have expand : r%2^(k+3) = r%2^(k+2) + 2^(k+2)*(r/2^(k+2)%2) := Nat.mod_pow_succ
  rw [expand]
  unfold nextCode
  rw [Nat.testBit_eq_decide_div_mod_eq]
  have small := Nat.mod_lt (r / 2^(k+2)) (by decide : 0<2)
  by_cases bit : r / 2^(k+2) % 2 = 1
  · simp [bit]
  · have zero : r / 2^(k+2) % 2 = 0 := by omega
    simp [zero]

theorem double_low (r n i : Nat) (hi : i<n) :
    (double (r%2^(n+2))).testBit i = (double r).testBit i := by
  have h := congrArg (fun v : Nat => v.testBit i) (double_prefix r n)
  simpa [Nat.testBit_mod_two_pow,hi] using h.symm

theorem subset_sound {a b : Nat} (h : subset a b = true) {t : Nat} (ht : a.testBit t = true) :
    b.testBit t = true := by
  have eq := congrArg (fun v : Nat => v.testBit t) (beq_iff_eq.mp h : a &&& b = a)
  simpa [Nat.testBit_and,ht] using eq

theorem easy {a b : Tree} (va : a.valid = true) (vb : b.valid = true) (r d t : Nat)
    {colours : Nat} (ok : subset ((a.high <<< 1) &&& colours) b.low = true)
    (ha : (a.value r (d+2)).testBit t = true) (hc : colours.testBit (t+1) = true) :
    (b.value (double r) d).testBit (t+1) = true := by
  apply (b.bounds vb _ _ _).1
  apply subset_sound ok
  have hi := (a.bounds va _ _ _).2 ha
  simp [Nat.testBit_and,Nat.testBit_shiftLeft,hi,hc]

theorem check_sound (n : Nat) {a b : Tree} {colours k p : Nat}
    (ok : check colours a b k p n = true) (va : a.valid = true) (vb : b.valid = true)
    (r t : Nat) (hp : p=r%2^(k+2))
    (ha : (a.value r (k+2)).testBit t = true) (hc : colours.testBit (t+1) = true) :
    (b.value (double r) k).testBit (t+1) = true := by
  induction n generalizing a b k p with
  | zero => exact easy va vb r k t ok ha hc
  | succ n ih =>
    simp only [check] at ok
    split at ok
    · rename_i h; exact easy va vb r k t h ha hc
    · let bit := r.testBit (k+2)
      let q := nextCode p k bit
      have hq : q=r%2^((k+1)+2) := by simpa [q,bit,hp,Nat.add_assoc] using extend_code r k
      have dbit : (double q).testBit k = (double r).testBit k := by
        rw [hq];exact double_low r (k+1) k (by omega)
      have next : check colours (a.child bit) (b.child ((double q).testBit k)) (k+1) q n = true := by
        rcases Bool.and_eq_true_iff.mp ok with ⟨l,h⟩
        cases hbit : bit <;> simpa only [q,hbit] using (by first | exact l | exact h)
      rw [dbit] at next
      have hstart : ((a.child bit).value r ((k+1)+2)).testBit t = true := by
        change ((a.child (r.testBit (k+2))).value r ((k+2)+1)).testBit t = true
        rwa [Tree.child_value]
      have fin := ih next (a.child_valid va _) (b.child_valid vb _) hq hstart
      simpa only [Tree.child_value] using fin

theorem bit_of_congr {x y n i : Nat} (e : x%2^n = y%2^n) (hi : i<n) :
    x.testBit i = y.testBit i := by
  have eq := congrArg (fun v : Nat => v.testBit i) e
  simpa [Nat.testBit_mod_two_pow,hi] using eq

def Tree.depth : Tree → Nat
  | .leaf _ => 0
  | .node _ _ a b => max a.depth b.depth + 1

theorem Tree.value_congr (a : Tree) {r s w : Nat} (e : r%2^w=s%2^w) (k : Nat)
    (hw : k+a.depth ≤ w) : a.value r k = a.value s k := by
  induction a generalizing k with
  | leaf => rfl
  | node lo hi a b ia ib =>
    simp only [Tree.depth] at hw
    have h1 := Nat.le_max_left a.depth b.depth
    have h2 := Nat.le_max_right a.depth b.depth
    have bit := bit_of_congr e (show k<w by omega)
    change (if r.testBit k then b.value r (k+1) else a.value r (k+1)) =
      (if s.testBit k then b.value s (k+1) else a.value s (k+1))
    rw [bit,ia (k+1) (by omega),ib (k+1) (by omega)]

theorem step_all {a : Tree} {white black : Nat} (va : a.valid = true)
    (ok : (List.range 16).all (fun p => checkAt a white black 4 p) = true) (r t : Nat)
    (ha : (a.value r 0).testBit t = true)
    (hc : (if (double r).testBit 0 then black else white).testBit (t+1) = true) :
    (a.value (double r) 0).testBit (t+1) = true := by
  let p := r % 2^4
  have chk := List.all_eq_true.mp ok p (List.mem_range.mpr (Nat.mod_lt r (by decide : 0<16)))
  have eqOut (i : Nat) (hi : i<2) : (double p).testBit i = (double r).testBit i :=
    double_low r 2 i hi
  have ofol := a.follow_congr (double p) (double r) 2 eqOut
  change check (if (double p).testBit 0 then black else white)
    (a.follow p 4) (a.follow (double p) 2) 2 p 46 = true at chk
  rw [ofol,eqOut 0 (by decide),show a.follow p 4 = a.follow r 4 from a.follow_mod r 4] at chk
  have out := check_sound 46 chk (a.follow_valid va r 4) (a.follow_valid va (double r) 2)
    r t rfl (by simpa only [Tree.follow_value] using ha) hc
  simpa only [Tree.follow_value] using out

open Rule30GateTrap Rule30RunWindow Rule30TrappedRuns

/-- Bit i marks a sample at which the gate may have the given colour. Both colours
are allowed for the two initial samples. masks_match checks these literals against the word. -/
def whiteMask : Nat := 138010345777479667103722077147
def blackMask : Nat := 178902304279577683270453724199
def colourMask (b : Bool) : Nat := if b then blackMask else whiteMask
def fits : Option Bool → Bool → Bool
  | none, _ => true
  | some b, a => a == b

private theorem masks_match : ∀ i : Fin 98, ∀ b : Bool,
    (colourMask b).testBit i.val = fits (colours.getD i.val none) b := by decide +kernel

private theorem fits_entry {r : Nat} {c : Option Bool} (h : Holds (entry c) r) :
    fits c (r.testBit 0) = true := by
  cases c with
  | none => rfl
  | some b =>
    change (r%2^16) ∈ trapCodes.filter (fun x => x.testBit 0 == b) at h
    have sel := (List.mem_filter.mp h).2
    simpa [fits, Nat.testBit_mod_two_pow] using sel

/-- A surviving sequence would carry bit 0 to bit 97. A different representative is
allowed at each edge provided the two 45-bit windows agree with the proposed path. -/
theorem reject {a : Tree} (va : a.valid = true) (width : a.depth ≤ 45)
    (start : trapCodes.all (fun x => (a.follow x 16).low.testBit 0) = true)
    (last : a.high.testBit 97 = false)
    (ok : (List.range 16).all (fun p => checkAt a whiteMask blackMask 4 p) = true)
    (row : Nat → Nat)
    (link : ∀ i, ∃ x, x%2^45=row i%2^45 ∧ double x%2^45=row (i+1)%2^45)
    (frames : ∀ i, i<98 → Holds (entry (colours.getD i none)) (row i)) : False := by
  have reached (i : Nat) (hi : i<98) : (a.value (row i) 0).testBit i = true := by
    induction i with
    | zero =>
      have hr := frames 0 (by decide)
      change row 0 % 2^16 ∈ trapCodes at hr
      have base := List.all_eq_true.mp start _ hr
      rw [Tree.follow_mod] at base
      have at0 := ((a.follow (row 0) 16).bounds (a.follow_valid va _ _) (row 0) 16 0).1 base
      simpa only [Tree.follow_value] using at0
    | succ i ih =>
      obtain ⟨x, same, next⟩ := link i
      have before := a.value_congr same 0 (by simpa using width)
      have after := a.value_congr next 0 (by simpa using width)
      have gate := bit_of_congr next (show 0<45 by decide)
      have col := fits_entry (frames (i+1) hi)
      rw [← masks_match ⟨i+1,hi⟩ ((row (i+1)).testBit 0)] at col
      have batch := step_all va ok x i (by rw [before];exact ih (by omega))
        (by change (colourMask ((double x).testBit 0)).testBit (i+1) = true; rwa [gate])
      rwa [after] at batch
  have bit := (a.bounds va _ _ 97).2 (reached 97 (by decide))
  simp [last] at bit

private theorem shift_iterate (r : Nat) : ∀ i, iterate (double r) i = iterate r (i+1)
  | 0 => rfl
  | i+1 => congrArg double (shift_iterate r i)

private theorem frame_at {r : Nat} {ds : List Window} (h : Trace r ds) (i : Nat) (hi : i<ds.length) :
    Holds ds[i] (iterate r i) := by
  induction ds generalizing r i with
  | nil => simp at hi
  | cons d ds ih =>
    cases i with
    | zero => exact h.1
    | succ i =>
      have step := ih (r := double r) h.2 i (by simpa using hi)
      rw [shift_iterate] at step
      exact step

theorem physical_frames {r : Nat} (h : Trace r initial) (i : Nat) (hi : i<98) :
    Holds (entry (colours.getD i none)) (iterate r i) := by
  have e : i<colours.length := by simpa only [show colours.length=98 by decide] using hi
  have le : i<initial.length := by simpa [initial] using e
  simpa [initial, List.getD_eq_getElem?_getD,List.getElem?_eq_getElem e] using frame_at h i le

