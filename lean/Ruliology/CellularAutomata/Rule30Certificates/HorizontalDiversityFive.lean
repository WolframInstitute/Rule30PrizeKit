abbrev State := Fin 374
abbrev Prefix := Fin 256

private def label (s : State) := (labels >>> (32*s.val)) % 2^32

def next (s : State) (c o : Bool) : State :=
  Fin.ofNat 374 ((edges >>> (9*(4*s.val + 2*c.toNat + o.toNat))) % 512)

private def prefixCons (b : Bool) (q : Prefix) : Prefix :=
  Fin.ofNat 256 (128*b.toNat + q.val/2)

private def forecast : List Bool → Prefix
  | [] => 0
  | b::bs => prefixCons b (forecast bs)

private def weightRow (s : State) := weights.getD s.val 0

/-- Work in radix 2^20. The unused high bits keep the weighted additions carry-free. -/
private def digit (x i : Nat) := (x >>> (20*i)) % 2^20

private theorem digit_lt (x i : Nat) : digit x i < 2^20 := Nat.mod_lt _ (by decide)

private theorem digit_and (x y i : Nat) : digit (x &&& y) i = digit x i &&& digit y i := by
  simp only [digit, Nat.shiftRight_and_distrib, Nat.and_mod_two_pow]

private theorem digit_xor (x y i : Nat) : digit (x ^^^ y) i = digit x i ^^^ digit y i := by
  simp only [digit, Nat.shiftRight_xor_distrib, ←Nat.and_two_pow_sub_one_eq_mod, Nat.and_xor_distrib_right]

private theorem digit_shift (v k j : Nat) : digit (v >>> (20*k)) j = digit v (k+j) := by
  simp only [digit, Nat.mul_add, Nat.shiftRight_add]

private theorem full_lane (x i : Nat) : digit x i &&& (2^20-1) = digit x i :=
  Nat.and_two_pow_sub_one_of_lt_two_pow (digit_lt x i)

/-- Each selection mask chooses a whole digit at its current index or at an offset. -/
private def route : List (Nat × Nat) → Nat → Nat
  | [], x => x
  | (d,m)::steps, x =>
    let y := route steps x
    y ^^^ ((y ^^^ (y >>> (20*d))) &&& m)

private def address : List (Nat × Nat) → Nat → Nat
  | [], i => i
  | (d,m)::steps, i => address steps (if digit m i = 0 then i else d+i)

private def validRoute : List (Nat × Nat) → Nat → Bool
  | [], _ => true
  | (d,m)::steps, i =>
    if digit m i = 0 then validRoute steps i
    else decide (digit m i = 2^20-1) && validRoute steps (d+i)

private theorem route_get (steps : List (Nat × Nat)) (x i : Nat) (valid : validRoute steps i = true) :
    digit (route steps x) i = digit x (address steps i) := by
  induction steps generalizing i with
  | nil => rfl
  | cons step steps ih =>
    obtain ⟨d,m⟩ := step
    by_cases off : digit m i = 0
    · simp only [validRoute,off,ite_true] at valid
      simpa only [route,address,digit_xor,digit_and,off,ite_true,Nat.and_zero,Nat.xor_zero] using ih i valid
    · simp only [validRoute,off,ite_false,Bool.and_eq_true,decide_eq_true_eq] at valid
      have masked (y z j : Nat) : (digit y i ^^^ digit z j) &&& (2^20-1) = digit y i ^^^ digit z j :=
        Nat.and_two_pow_sub_one_of_lt_two_pow (Nat.xor_lt_two_pow (digit_lt _ _) (digit_lt _ _))
      rw [address, ite_eq_right off]
      simp only [route,digit_xor,digit_and,digit_shift,valid.1,masked,
        ←Nat.xor_assoc, Nat.xor_self, Nat.zero_xor]
      exact ih (d+i) valid.2

/-- The quotient and remainder at one radix digit, used in the carry proof. -/
private theorem split_digit (v : Nat) : digit v 0 + 1048576*(v >>> 20) = v := by
  simpa [digit,Nat.shiftRight_eq_div_pow] using Nat.mod_add_div v 1048576

private theorem packed_le {n x y z d : Nat} (eq : 32*(x+y)+d = 39*z)
    (bounded : ∀ j<n, digit x j≤1023 ∧ digit y j≤1023 ∧ digit z j≤1023 ∧ digit d j≤65535)
    {i : Nat} (hi : i<n) : 32*(digit x i+digit y i) ≤ 39*digit z i := by
  induction n generalizing x y z d i with
  | zero => omega
  | succ n ih =>
    obtain ⟨bx,by',bz,bd⟩ := bounded 0 (by omega)
    have hx := split_digit x
    have hy := split_digit y
    have hz := split_digit z
    have hd := split_digit d
    have tail : 32*((x>>>20)+(y>>>20))+(d>>>20) = 39*(z>>>20) := by omega
    cases i with
    | zero => omega
    | succ i =>
      have shift (v j : Nat) : digit (v>>>20) j = digit v (j+1) := by
        simpa [Nat.add_comm] using digit_shift v 1 j
      have bounds (j : Nat) (hj : j<n) :
          digit (x>>>20) j≤1023 ∧ digit (y>>>20) j≤1023 ∧
          digit (z>>>20) j≤1023 ∧ digit (d>>>20) j≤65535 := by
        simpa only [shift] using bounded (j+1) (by omega)
      simpa only [shift] using ih tail bounds (i:=i) (by omega)

private def allBelow (f : Nat → Bool) : Nat → Bool
  | 0 => true
  | n+1 => f n && allBelow f n

private theorem allBelow_at {f : Nat → Bool} {n i : Nat}
    (ok : allBelow f n = true) (hi : i<n) : f i = true := by
  induction n with
  | zero => omega
  | succ n ih =>
    obtain ⟨last, rest⟩ := Bool.and_eq_true_iff.mp ok
    by_cases eq : i=n
    · exact eq ▸ last
    · exact ih rest (by omega)

private def W (q : Prefix) (s : State) : Nat := digit (weightRow s) q.val

private def accepts (s : State) (a b c d e : Bool) : Bool :=
  (label s).testBit (a.toNat + 2*b.toNat + 4*c.toNat + 8*d.toNat + 16*e.toNat)

set_option maxRecDepth 100000
set_option maxHeartbeats 1500000000

private def pack (a b d e f : Bool) : Nat :=
  a.toNat + 2*b.toNat + 4*d.toNat + 8*e.toNat + 16*f.toNat

private def stripStep (x : Nat) (c g : Bool) : Nat :=
  let v := c.toNat + 2*x + 64*g.toNat
  (v ^^^ ((v >>> 1) ||| (v >>> 2))) % 32

private theorem pack_spec : ∀ (a b d e f : Bool),
    pack a b d e f < 32 ∧ (pack a b d e f).testBit 0 = a := by decide +kernel

private theorem stripStep_spec : ∀ (a b d e f c g : Bool),
    stripStep (pack a b d e f) c g =
      pack (rule c a b) (rule a b d) (rule b d e) (rule d e f) (rule e f g) := by decide +kernel

private def acceptsStep (source zeroTarget oneTarget : Nat) (c : Bool) (x : Nat) : Bool :=
  let target := if c || x.testBit 0 then oneTarget else zeroTarget
  !source.testBit x || (target.testBit (stripStep x c false) && target.testBit (stripStep x c true))

private def stateStep (s : State) (c : Bool) : Bool :=
  allBelow (acceptsStep (label s)
    (label (next s c false)) (label (next s c true)) c) 32

private theorem all_state_steps : allBelow (fun i =>
    let s := Fin.ofNat 374 i
    stateStep s false && stateStep s true) 374 = true := by decide +kernel

private theorem transition_sound (s : State) (c a b d e f g : Bool)
    (accepted : accepts s a b d e f = true) :
    accepts (next s c (c || a)) (rule c a b) (rule a b d) (rule b d e) (rule d e f) (rule e f g) = true := by
  have eq : Fin.ofNat 374 s.val = s := Fin.ext (Nat.mod_eq_of_lt s.isLt)
  have both := allBelow_at all_state_steps s.isLt
  change (stateStep _ false && stateStep _ true) = true at both
  rw [eq] at both
  have ok : stateStep s c = true := by
    cases c
    · exact (Bool.and_eq_true_iff.mp both).1
    · exact (Bool.and_eq_true_iff.mp both).2
  have input := pack_spec a b d e f
  have h := allBelow_at ok input.1
  change (label s).testBit (pack a b d e f) = true at accepted
  simp only [acceptsStep, accepted, input.2, Bool.not_true, Bool.false_or, Bool.and_eq_true] at h
  change (label (next s c (c || a))).testBit (pack (rule c a b) (rule a b d) (rule b d e) (rule d e f) (rule e f g)) = true
  rw [←stripStep_spec]
  cases arm : c || a <;> cases g <;> simp [arm] at h ⊢
  all_goals first | exact h.1 | exact h.2

private theorem initial_accepts : ∀ a b d e f, accepts 0 a b d e f = true := by decide +kernel
private theorem empty_rejects : ∀ a b d e f, accepts 1 a b d e f = false := by decide +kernel

/-- Gather even-numbered digits into the first 128 slots. An initial one-digit
shift gathers the odd digits. Each stage moves selected lanes by a power of two. -/
private def stages : List (Nat × Nat) := [
  (64, ),
  (32, ),
  (16, ),
  (8, ),
  (4, ),
  (2, ),
  (1, )]

/-- The target prefix is r for a white center and 128+r for a black center. -/
private theorem addresses : ∀ i : Fin 128,
    validRoute stages i.val = true ∧ address stages i.val = 2*i.val := by decide +kernel

private def windowMask : Nat := 2^2560-1
private def smallMask : Nat := 
private def slackMask : Nat := 

private theorem masks : ∀ i : Fin 128, digit windowMask i.val = 2^20-1 ∧
    digit smallMask i.val = 1023 ∧ digit slackMask i.val = 65535 := by decide +kernel

private def crop (x : Nat) := x &&& windowMask

private theorem crop_digit (x : Nat) (i : Fin 128) : digit (crop x) i.val = digit x i.val := by
  rw [crop, digit_and, (masks i).1, full_lane]

private def halfRow (s : State) (parity : Nat) := crop (route stages (weightRow s >>> (20*parity)))
private def parentRow (s : State) (c : Bool) := crop (weightRow s >>> (20*(128*c.toNat)))

private theorem half_digit (s : State) (e : Nat) (i : Fin 128) :
    digit (halfRow s e) i.val = digit (weightRow s) (e+2*i.val) := by
  rw [halfRow,crop_digit,route_get _ _ _ (addresses i).1,(addresses i).2,digit_shift]

private theorem parent_digit (s : State) (c : Bool) (i : Fin 128) :
    digit (parentRow s c) i.val = digit (weightRow s) (128*c.toNat+i.val) := by
  rw [parentRow,crop_digit,digit_shift]

/-- The nonnegative difference encodes 128 slacks. Masking verifies that
each fits in 16 bits. The weighted identity then has no carries in radix 2^20. -/
private def compareRows (x y z : Nat) : Bool :=
  let slack := 39*z-32*(x+y)
  (x &&& smallMask == x) && (y &&& smallMask == y) && (z &&& smallMask == z) &&
    (slack &&& slackMask == slack) && (32*(x+y)+slack == 39*z)

private theorem fits_digit {v mask : Nat} (eq : v &&& mask = v) (j : Nat) :
    digit v j ≤ digit mask j := by
  have h := congrArg (fun u => digit u j) eq
  rw [digit_and] at h
  rw [← h]
  exact Nat.and_le_right

private theorem compareRows_sound {x y z : Nat} (ok : compareRows x y z = true) (i : Fin 128) :
    32*(digit x i.val+digit y i.val) ≤ 39*digit z i.val := by
  simp only [compareRows, Bool.and_eq_true, beq_iff_eq] at ok
  obtain ⟨⟨⟨⟨hx,hy⟩,hz⟩,hd⟩,eq⟩ := ok
  apply packed_le (n:=128) eq _ i.isLt
  intro j hj
  obtain ⟨_,small,slack⟩ := masks ⟨j,hj⟩
  exact ⟨small ▸ fits_digit hx j, small ▸ fits_digit hy j,
    small ▸ fits_digit hz j, slack ▸ fits_digit hd j⟩

private def checkState (s : State) (c : Bool) (e : Nat) :=
  compareRows (halfRow (next s c false) e) (halfRow (next s c true) e) (parentRow s c)

private theorem checked : allBelow (fun i =>
    let s := Fin.ofNat 374 i
    (checkState s false 0 && checkState s false 1) &&
    (checkState s true 0 && checkState s true 1)) 374 = true := by decide +kernel

private theorem potential_step (s : State) (q : Prefix) (c : Bool) :
    32*(W q (next s c false) + W q (next s c true)) ≤ 39*W (prefixCons c q) s := by
  have eq : Fin.ofNat 374 s.val = s := Fin.ext (Nat.mod_eq_of_lt s.isLt)
  have h := allBelow_at checked s.isLt
  change ((checkState _ false 0 && checkState _ false 1) &&
    (checkState _ true 0 && checkState _ true 1)) = true at h
  rw [eq] at h
  simp only [Bool.and_eq_true] at h
  let r : Fin 128 := ⟨q.val/2,by have := q.isLt; omega⟩
  have parity : q.val%2=0 ∨ q.val%2=1 := by omega
  have ok : checkState s c (q.val%2) = true := by
    rcases parity with p|p <;> rw [p] <;> cases c
    · exact h.1.1
    · exact h.2.1
    · exact h.1.2
    · exact h.2.2
  have budget := compareRows_sound ok r
  rw [half_digit,half_digit,parent_digit] at budget
  have child : q.val%2+2*r.val=q.val := Nat.mod_add_div _ _
  have parent : (prefixCons c q).val = 128*c.toNat+r.val := by
    apply Nat.mod_eq_of_lt
    have := q.isLt
    cases c <;> simp <;> omega
  simpa only [W, child, parent] using budget

private theorem initial_potential : ∀ (q : Prefix), W q 0 ≤ 900 := by decide +kernel
private theorem terminal_potential : ∀ (s : State), s ≠ 1 → 100 ≤ W 0 s := by decide +kernel

/-- Candidate lists are indexed by the prescribed center word and the current strip state. -/
def words : List Bool → State → List (List Bool)
  | [], s => if s = 1 then [] else [[]]
  | c::bs, s =>
    (words bs (next s c false)).map (false :: ·) ++
    (words bs (next s c true)).map (true :: ·)

/-- Every listed path pays for its two possible mask extensions with the same fixed
center continuation. The right boundary of the five-cell strip is arbitrary. -/
private theorem bound (c : List Bool) (s : State) :
    100 * (words c s).length * 32^c.length ≤ W (forecast c) s * 39^c.length := by
  induction c generalizing s with
  | nil =>
    by_cases h : s = 1
    · simp [words,h]
    · simpa [words,h,forecast] using terminal_potential s h
  | cons b bs ih =>
    let t := next s b false
    let u := next s b true
    have h := Nat.add_le_add (ih t) (ih u)
    have budget := potential_step s (forecast bs) b
    simp only [words,List.length_append,List.length_map,List.length_cons,forecast,Nat.pow_succ]
    change 100 * ((words bs t).length + (words bs u).length) * (32^bs.length*32) ≤ _
    calc
      _ = 32 * (100 * (words bs t).length * 32^bs.length +
          100 * (words bs u).length * 32^bs.length) := by simp [Nat.mul_add,Nat.add_mul]; ac_rfl
      _ ≤ 32 * (W (forecast bs) t * 39^bs.length + W (forecast bs) u * 39^bs.length) :=
        Nat.mul_le_mul_left 32 h
      _ = (32*(W (forecast bs) t + W (forecast bs) u))*39^bs.length := by rw [Nat.mul_assoc, Nat.add_mul]
      _ ≤ (39*W (prefixCons b (forecast bs)) s)*39^bs.length := Nat.mul_le_mul_right _ budget
      _ = _ := by ac_rfl

theorem masked_word_count (c : List Bool) :
    (words c 0).length * 32^c.length ≤ 9 * 39^c.length := by
  have h := Nat.le_trans (bound c 0) (Nat.mul_le_mul_right (39^c.length) (initial_potential (forecast c)))
  rw [Nat.mul_assoc] at h
  omega

private theorem mem_strip (x : Int → Bool) (t n : Nat) (s : State)
    (hs : accepts s (evol x t 1) (evol x t 2) (evol x t 3) (evol x t 4) (evol x t 5) = true) :
    segment (fun k => evol x k 0 || evol x k 1) t n ∈ words (segment (fun k => evol x k 0) t n) s := by
  induction n generalizing t s with
  | zero =>
    have h : s ≠ 1 := by
      rintro rfl
      rw [empty_rejects] at hs
      contradiction
    simp [Ruliology.CellularAutomata.Rule30Certificates.HorizontalDiversity.segment,words,h]
  | succ n ih =>
    have hn := transition_sound s (evol x t 0) _ _ _ _ _ (evol x t 6) hs
    have hm := ih (t+1) _ hn
    simp only [Ruliology.CellularAutomata.Rule30Certificates.HorizontalDiversity.segment,words,List.mem_append,List.mem_map]
    cases h : evol x t 0 || evol x t 1
    · exact Or.inl ⟨_, by simpa only [h] using hm, rfl⟩
    · exact Or.inr ⟨_, by simpa only [h] using hm, rfl⟩

/-- All actual Rule 30 histories are covered, for every initial row and start time. -/
theorem observations_mem (x : Int → Bool) (t n : Nat) :
    segment (fun k => evol x k 0 || evol x k 1) t n ∈ words (segment (fun k => evol x k 0) t n) 0 :=
  mem_strip x t n 0 (initial_accepts _ _ _ _ _)


/-- Uniform conditional support bound, directly quantified over genuine Rule 30 histories.
For each prescribed center word there is one list shared by every initial row and age. -/
theorem genuine_channel_bound (c : List Bool) :
    ∃ candidates : List (List Bool), candidates.length * 32^c.length ≤ 9 * 39^c.length ∧
      ∀ (x : Int → Bool) (t : Nat), segment (fun k => evol x k 0) t c.length = c →
        segment (fun k => evol x k 0 || evol x k 1) t c.length ∈ candidates := by
  refine ⟨words c 0, masked_word_count c, ?_⟩
  intro x t hc
  simpa only [hc] using observations_mem x t c.length

