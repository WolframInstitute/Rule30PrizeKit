@[expose] public section

/-! Rank certificate for the seven-white one-black center clock. -/
namespace Ruliology.CellularAutomata.Rule30MixedGapClocks.Seven
open Ruliology.CellularAutomata Rule30StripCertificates

def clock : List Bool := [false, false, false, false, false, false, false, true]
def cert : Cert where
  w := clock
  b := 12
  nranks := 771
  rankP := 
  posP := 
  perP := 
  wordP := 

set_option maxRecDepth 110000
set_option maxHeartbeats 0
set_option Elab.async false

def phaseEdges (φ : Nat) : Bool :=
  (Rule30Jen.allLists cert.b).all fun s =>
    [false, true].all fun x => cert.edgeOK φ s (lin3 (cert.wAt φ :: (s ++ [x])))

def phaseCounters (φ : Nat) : Bool :=
  (Rule30Jen.allLists cert.b).all fun s => decide (cert.ps φ s < cert.m (cert.rk φ s))


theorem edges0 : phaseEdges 0 = true := by decide +kernel

theorem edges1 : phaseEdges 1 = true := by decide +kernel

theorem edges2 : phaseEdges 2 = true := by decide +kernel

theorem edges3 : phaseEdges 3 = true := by decide +kernel

theorem counters0 : phaseCounters 0 = true := by decide +kernel

theorem counters1 : phaseCounters 1 = true := by decide +kernel

theorem counters2 : phaseCounters 2 = true := by decide +kernel

theorem counters3 : phaseCounters 3 = true := by decide +kernel

end Ruliology.CellularAutomata.Rule30MixedGapClocks.Seven
