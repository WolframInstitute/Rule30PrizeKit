noncomputable def getWord_P (idx : Nat) : Nat := get_P idx

noncomputable def getClause (i : Nat) : Nat :=
  strictNat i fun i => Nat.land
    (Nat.shiftRight (get_M (Nat.div i (nat_lit 32))) (Nat.mul (Nat.mod i (nat_lit 32)) (nat_lit 176))) (nat_lit 0xffffffffffffffffffffffffffffffffffffffffffff)


def transitionRow (t : Nat) : List (List Nat) := (List.range (q-2)).flatMap fun i => sixClauses (vid q t i) (vid q t (i+1)) (vid q t (i+2)) (vid q (t+1) i)
theorem formula_part0 : checkFormula getClause (transitionRow 0) 0 = true := by decide +kernel
theorem formula_part1 : checkFormula getClause (transitionRow 1) 96 = true := by decide +kernel
theorem formula_part2 : checkFormula getClause (transitionRow 2) 192 = true := by decide +kernel
theorem formula_part3 : checkFormula getClause (transitionRow 3) 288 = true := by decide +kernel
theorem formula_part4 : checkFormula getClause (periodFormula p q cols) 384 = true := by decide +kernel
theorem formula_part5 : checkFormula getClause (states.map (forbid q offset w)) 404 = true := by decide +kernel
theorem formula_shape : formula = (transitionRow 0) ++ (transitionRow 1) ++ (transitionRow 2) ++ (transitionRow 3) ++ (periodFormula p q cols) ++ (states.map (forbid q offset w)) := by
  simp only [formula, stripFormula, transitionFormula, show List.range p = [0, 1, 2, 3] from rfl, List.flatMap_cons, List.flatMap_nil, List.append_nil, List.append_assoc, transitionRow]
theorem formula_ok : checkFormula getClause formula 0 = true := by
  rw [formula_shape]
  apply checkFormula_append_ok formula_part0
  apply checkFormula_append_ok formula_part1
  apply checkFormula_append_ok formula_part2
  apply checkFormula_append_ok formula_part3
  apply checkFormula_append_ok formula_part4
  exact formula_part5
theorem rup_ok0 : replayPackedN getClause getWord_P 32 412 0 = true := by decide +kernel
theorem rup_ok1 : replayPackedN getClause getWord_P 30 444 32 = true := by decide +kernel
theorem nil_ok : Nat.beq (getClause 473) 0 = true := by decide +kernel

theorem unsat : ∀ assign : Nat → Bool, ¬ (∀ c ∈ formula, Models assign c) := by
  intro a hm
  have hk0 : Known getClause a 412 := initial_known formula_ok hm
  have hk1 : Known getClause a 444 := replayPackedN_sound 32 412 0 hk0 rup_ok0
  have hk2 : Known getClause a 474 := replayPackedN_sound 30 444 32 hk1 rup_ok1
  exact unsat_of_known_nil nil_ok hk2

theorem strip_window_in_states (x : Int → Bool) (hx : orbit x p = x) (origin : Int) :
    ∃ s ∈ states, Matches x origin w s :=
  finite_strip_forces (by decide) (by decide) (by decide) unsat x hx origin

theorem potential_exact_ok : checkPotential w states base slope 8 2 = true := by decide +kernel
theorem potential_ok : checkPotential w states base slope 81 14 = true := by decide +kernel

theorem linear_words (m : Nat) :
    ∃ L : List (List Bool),
      L.length ≤ 81 + m * 14 ∧
      ∀ (x : Int → Bool), orbit x 4 = x → ∀ origin : Int, rowWord x origin m ∈ L :=
  linear_words_of_strip potential_ok strip_window_in_states m

