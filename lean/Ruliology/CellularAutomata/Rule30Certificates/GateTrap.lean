/-! ## Windows, bitmaps and the double step -/

/-- The window coded by `n`: bit `i` of `n` is column `i + 1`. -/
def decode (n : Nat) : List Bool := seg (fun i => n.testBit i) 16

/-- The windows of the trap. -/
def trap : List (List Bool) := trapCodes.map decode
/-- The windows of layer 1. -/
def layer1 : List (List Bool) := layer1Codes.map decode
/-- The windows of layer 2. -/
def layer2 : List (List Bool) := layer2Codes.map decode
/-- The windows of layer 3. -/
def layer3 : List (List Bool) := layer3Codes.map decode
/-- The windows of layer 4. -/
def layer4 : List (List Bool) := layer4Codes.map decode

/-- A list of windows as a bitmap: bit `encList w` is set for each window `w` of the list. -/
def mask : List (List Bool) → Nat
  | [] => 0
  | s :: rest => 2 ^ encList s ||| mask rest

/-- Membership in a bitmap. -/
def inM (M : Nat) (w : List Bool) : Bool := M.testBit (encList w)

/-- The double step from an odd time: column `0` is white, then black, and `x1`, `x2` are the two
values of column `17`. -/
def step2 (s : List Bool) (x1 x2 : Bool) : List Bool :=
  lin3 (true :: (lin3 (false :: (s ++ [x1])) ++ [x2]))

/-- `P` holds after the double step from `s`, for all four values of column `17`. -/
def allSucc (P : List Bool → Bool) (s : List Bool) : Bool :=
  P (step2 s false false) && P (step2 s false true) && P (step2 s true false) &&
    P (step2 s true true)

/-! ## The checks -/

/-- The trap is closed under the double step, for every value of column `17`. -/
def trapClosed : Bool := trap.all (allSucc (inM (mask trap)))
/-- Two steps after a black cell of column `1`: white, in `layer1`. -/
def afterBlack : Bool := trap.all (fun s => !(s.headD false) ||
  allSucc (fun w => !(w.headD false) && inM (mask layer1) w) s)
/-- Then white, in `layer2`. -/
def secondStep : Bool := layer1.all (allSucc (fun w => !(w.headD false) && inM (mask layer2) w))
/-- Then black (a gap of `3`), or white and in `layer3`. -/
def thirdStep : Bool := layer2.all (allSucc (fun w => w.headD false || inM (mask layer3) w))
/-- Then white, in `layer4`. -/
def fourthStep : Bool := layer3.all (allSucc (fun w => !(w.headD false) && inM (mask layer4) w))
/-- Then black (a gap of `5`). -/
def fifthStep : Bool := layer4.all (allSucc (fun w => w.headD false))

theorem trapClosed_ok : trapClosed = true := by decide +kernel
theorem afterBlack_ok : afterBlack = true := by decide +kernel
theorem secondStep_ok : secondStep = true := by decide +kernel
theorem thirdStep_ok : thirdStep = true := by decide +kernel
theorem fourthStep_ok : fourthStep = true := by decide +kernel
theorem fifthStep_ok : fifthStep = true := by decide +kernel

/-! ## The entry of the empty right half -/

/-- `n` steps of the driven row from time `t`, on an explicit list of the cells `1, 2, …`: each
step uses the color of column `0` and makes the list one cell shorter. -/
def evolve : Nat → Nat → List Bool → List Bool
  | _, 0, l => l
  | t, n + 1, l => evolve (t + 1) n (lin3 (altCol t :: l))

/-- From the white row at time `0`, the window at time `293` is `decode entryCode`. -/
theorem evolve_293 : evolve 0 293 (List.replicate 309 false) = decode entryCode := by
  decide +kernel

/-- The window of the empty right half at time `293` is in the trap. -/
theorem entry_mem : decode entryCode ∈ trap := List.mem_map_of_mem (by decide +kernel)

end Ruliology.CellularAutomata.Rule30GateTrap
