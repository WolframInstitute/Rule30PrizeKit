module
public import Ruliology.CellularAutomata.Rule30Prize

/-! A ranked certificate for the five-row reset-free spatial presentation.
The theorem is about encoded paths. The translation from arbitrary reset-free
Rule30 rows is a separate premise, not silently assumed here. -/
@[expose] public section
namespace Ruliology.CellularAutomata.Rule30ResetFreeCore
set_option maxRecDepth 30000
set_option maxHeartbeats 100000000

def iterate (g : Nat → Nat) (s : Nat) : Nat → Nat
  | 0 => s
  | n+1 => g (iterate g s n)

structure Ranked where
  bound : Nat
  next : Nat → Bool → Nat
  dead : Nat → Nat
  rank : Nat → Nat
  rankBound : Nat
  core : Nat → Prop
  coreDec : DecidablePred core
  successor : Nat → Nat
  output : Nat → Bool

attribute [instance] Ranked.coreDec

def NodeOK (G : Ranked) (s : Nat) : Prop :=
  (0<G.dead s → ∀ b,G.next s b<G.bound →
    0<G.dead (G.next s b) ∧ G.dead (G.next s b)<G.dead s) ∧
  (G.dead s=0 → ¬G.core s → 0<G.rank s ∧
    ∀ b,G.next s b<G.bound → G.dead (G.next s b)=0 → G.rank (G.next s b)<G.rank s) ∧
  (G.core s → G.core (G.successor s) ∧
    G.output (iterate G.successor s 5)=G.output s ∧
    ∀ b,G.next s b<G.bound → G.dead (G.next s b)=0 → G.next s b=G.successor s) ∧
  G.rank s≤G.rankBound

instance (G : Ranked) (s : Nat) : Decidable (NodeOK G s) := by
  unfold NodeOK
  infer_instance

def Path (G : Ranked) (v : Nat → Nat) (b : Nat → Bool) : Prop :=
  ∀ n,v n<G.bound ∧ G.next (v n) (b n)=v (n+1)

theorem path_dead_zero (G : Ranked) (valid : ∀ s,s<G.bound → NodeOK G s)
    (v : Nat → Nat) (b : Nat → Bool) (path : Path G v b) : ∀ n,G.dead (v n)=0 := by
  intro n
  by_cases zero : G.dead (v n)=0
  · exact zero
  · have descent : ∀ k,0<G.dead (v (n+k)) ∧ G.dead (v (n+k))+k≤G.dead (v n) := by
      intro k
      induction k with
      | zero => simpa only [Nat.add_zero] using And.intro (show 0<G.dead (v n) by omega) (Nat.le_refl _)
      | succ k ih =>
        have node := (valid _ (path (n+k)).1).1 ih.1 (b (n+k)) (by rw [(path (n+k)).2];exact (path (n+k+1)).1)
        rw [(path (n+k)).2] at node
        constructor
        · simpa only [Nat.add_succ] using node.1
        · simpa only [Nat.add_succ] using (show G.dead (v (n+k+1))+(k+1)≤G.dead (v n) by omega)
    have last := descent (G.dead (v n))
    omega

theorem path_reaches_core (G : Ranked) (valid : ∀ s,s<G.bound → NodeOK G s)
    (v : Nat → Nat) (b : Nat → Bool) (path : Path G v b) :
    ∃ N,N≤G.rank (v 0) ∧ G.core (v N) := by
  have safe := path_dead_zero G valid v b path
  have reaches : ∀ r n,G.rank (v n)≤r → ∃ m,n≤m ∧ m≤n+r ∧ G.core (v m) := by
    intro r
    induction r with
    | zero =>
      intro n bound
      by_cases core : G.core (v n)
      · exact ⟨n,by omega,by omega,core⟩
      · have pos := (valid _ (path n).1).2.1 (safe n) core
        omega
    | succ r ih =>
      intro n bound
      by_cases core : G.core (v n)
      · exact ⟨n,by omega,by omega,core⟩
      · have node := (valid _ (path n).1).2.1 (safe n) core
        have lower := node.2 (b n) (by rw [(path n).2];exact (path (n+1)).1)
          (by rw [(path n).2];exact safe (n+1))
        rw [(path n).2] at lower
        obtain ⟨m,hm,hmupper,hcore⟩ := ih (n+1) (by omega)
        exact ⟨m,by omega,by omega,hcore⟩
  obtain ⟨N,_,hbound,h⟩ := reaches (G.rank (v 0)) 0 (by omega)
  exact ⟨N,by omega,h⟩

theorem path_eventually_five (G : Ranked) (valid : ∀ s,s<G.bound → NodeOK G s)
    (v : Nat → Nat) (b : Nat → Bool) (path : Path G v b) :
    ∃ N,N≤G.rankBound ∧ ∀ n,N≤n → G.output (v (n+5))=G.output (v n) := by
  have safe := path_dead_zero G valid v b path
  have advance : ∀ n,G.core (v n) →
      G.core (v (n+1)) ∧ v (n+1)=G.successor (v n) := by
    intro n core
    have node := (valid _ (path n).1).2.2.1 core
    have eq := node.2.2 (b n) (by rw [(path n).2];exact (path (n+1)).1)
      (by rw [(path n).2];exact safe (n+1))
    rw [(path n).2] at eq
    exact ⟨by rw [eq];exact node.1,eq⟩
  obtain ⟨N,hbound,hN⟩ := path_reaches_core G valid v b path
  have tail : ∀ k,G.core (v (N+k)) := by
    intro k
    induction k with
    | zero => simpa only [Nat.add_zero] using hN
    | succ k ih => simpa only [Nat.add_succ] using (advance (N+k) ih).1
  refine ⟨N,by have cap := (valid _ (path 0).1).2.2.2;omega,?_⟩
  intro n hn
  have c0 : G.core (v n) := by
    have h := tail (n-N)
    simpa only [show N+(n-N)=n by omega] using h
  have e1 := advance n c0
  have e2 := advance (n+1) e1.1
  have e3 := advance (n+1+1) e2.1
  have e4 := advance (n+1+1+1) e3.1
  have e5 := advance (n+1+1+1+1) e4.1
  have walk : v (n+5)=iterate G.successor (v n) 5 := by
    change v (n+1+1+1+1+1)=_
    rw [e5.2,e4.2,e3.2,e2.2,e1.2]
    rfl
  rw [walk]
  exact ((valid _ (path n).1).2.2.1 c0).2.1

def checkAll (G : Ranked) : Nat → Bool
  | 0 => true
  | n+1 => checkAll G n && decide (NodeOK G n)

theorem checkAll_sound (G : Ranked) : ∀ n,checkAll G n=true → ∀ s,s<n → NodeOK G s := by
  intro n
  induction n with
  | zero => intro _ s hs;omega
  | succ n ih =>
    intro checked s hs
    have pair := Bool.and_eq_true_iff.mp checked
    by_cases old : s<n
    · exact ih pair.1 s old
    · have eq : s=n := by omega
      subst s
      exact of_decide_eq_true pair.2

def prevBit (d : Nat) : Bool := decide (d=1) || decide (3≤d)
def currentBit (d : Nat) : Bool := decide (2≤d)
def runMod (d : Nat) : Nat := if d=2 ∨ d=4 then 1 else if d=5 then 2 else 0
def digit (s t : Nat) : Nat := s/(6^t)%6
def nextAtom (d : Nat) (bit : Bool) : Nat :=
  if bit then
    if currentBit d then 3+(runMod d+1)%3 else 2
  else if currentBit d then 1 else 0
def nextAux (s : Nat) (top : Bool) : Nat → Nat → Nat
  | 0,total => total
  | t+1,total =>
    let bit := if t=4 then top else xor (currentBit (digit s (t+1)))
      (currentBit (digit s t) || prevBit (digit s t))
    if bit=false ∧ runMod (digit s t)=1 then 7776
    else nextAux s top t (total+6^t*nextAtom (digit s t) bit)
def nextState (s : Nat) (top : Bool) : Nat := nextAux s top 5 0


def deadData : Nat := 
def rankData : Nat := 
def coreStates : List Nat := [0, 3, 4, 5, 1131, 1841, 3271, 4076, 6786]
def successor (s : Nat) : Nat :=
  if s=0 then 0 else if s=3 then 4 else if s=4 then 5 else if s=5 then 3 else if s=1131 then 3271 else if s=1841 then 1131 else if s=3271 then 6786 else if s=4076 then 1841 else if s=6786 then 4076 else 0
def graph : Ranked where
  bound := 7776
  next := nextState
  dead s := (deadData >>> (8*s))%256
  rank s := (rankData >>> (8*s))%256
  rankBound := 7
  core s := s ∈ coreStates
  coreDec := fun _ => inferInstance
  successor := successor
  output s := currentBit (digit s 0)

theorem all_nodes_checked : checkAll graph 7776=true := by decide +kernel

theorem graph_valid (s : Nat) (hs : s<7776) : NodeOK graph s :=
  checkAll_sound graph 7776 all_nodes_checked s hs

/-- Every infinite path in the exact five-row reset-free presentation has
an eventually5-periodic first-row output. The row/presentation completeness
translation is separate from this encoded-path theorem. -/
theorem encoded_path_eventually_five (v : Nat → Nat) (b : Nat → Bool)
    (path : Path graph v b) :
    ∃ N,N≤7 ∧ ∀ n,N≤n → graph.output (v (n+5))=graph.output (v n) :=
  path_eventually_five graph graph_valid v b path

theorem encoded_path_five_from_seven (v : Nat → Nat) (b : Nat → Bool)
    (path : Path graph v b) : ∀ n,7≤n → graph.output (v (n+5))=graph.output (v n) := by
  obtain ⟨N,hN,tail⟩ := encoded_path_eventually_five v b path
  intro n hn
  exact tail n (by omega)

theorem zero_path : Path graph (fun _ => 0) (fun _ => false) := by
  intro n
  dsimp only [graph]
  exact ⟨by decide,by rfl⟩

/-! ## Semigroup law for `iterate`, multi-period `5 * k` output invariance, and period-`15` return on `coreStates` -/

/-- **Semigroup Law for `iterate`, Multi-Period `5 * k` Output Invariance, and Period-`15` Return on `coreStates` (`iterate_add_and_encoded_path_five_mul_and_core15`).** -/
theorem iterate_add_and_encoded_path_five_mul_and_core15
    (g : Nat → Nat) (s m n k : Nat) (v : Nat → Nat) (b : Nat → Bool) :
    iterate g s (m + n) = iterate g (iterate g s m) n ∧
    (Path graph v b → 7 ≤ n → graph.output (v (n + 5 * k)) = graph.output (v n)) ∧
    (∀ c ∈ coreStates, iterate successor c 15 = c) := by
  refine ⟨?_, fun hpath hn => ?_, by decide⟩
  · induction n with
    | zero => rfl
    | succ n ih => rw [Nat.add_succ, iterate, iterate, ih]
  · induction k with
    | zero => simp
    | succ k ih =>
      rw [show n + 5 * (k + 1) = (n + 5 * k) + 5 by omega,
          encoded_path_five_from_seven v b hpath (n + 5 * k) (by omega), ih]

end Ruliology.CellularAutomata.Rule30ResetFreeCore
