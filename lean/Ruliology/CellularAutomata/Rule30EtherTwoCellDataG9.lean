def dataAllG9 (p φ : Nat) : List (Nat × Nat × Nat) := (dataTabG9.getD (p - 14) []).getD φ []

def checkAllG9 : Bool :=
  (List.range 2).all (fun i =>
    (List.range 4).all (fun φ =>
      let p := i + 14
      ((dataAllG9 p φ).length == Mfun p φ - p - 1) && checkRange (dataAllG9 p φ) p φ))

theorem checkAllG9_ok : checkAllG9 = true := by decide

theorem checkAllG9_range (p φ : Nat) (hp0 : 14 ≤ p) (hp1 : p ≤ 15) (hφ : φ < 4) :
    (dataAllG9 p φ).length = Mfun p φ - p - 1 ∧ checkRange (dataAllG9 p φ) p φ = true := by
  have h := checkAllG9_ok
  unfold checkAllG9 at h
  have h1 := List.all_eq_true.1 h (p - 14) (List.mem_range.2 (by omega))
  have h2 := List.all_eq_true.1 h1 φ (List.mem_range.2 hφ)
  rw [show p - 14 + 14 = p by omega] at h2
  simp only [Bool.and_eq_true] at h2
  exact ⟨beq_iff_eq.1 h2.1, h2.2⟩

