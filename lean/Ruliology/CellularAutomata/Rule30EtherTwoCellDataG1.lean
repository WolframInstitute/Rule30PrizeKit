def dataAllG1 (p φ : Nat) : List (Nat × Nat × Nat) := (dataTabG1.getD (p - 3) []).getD φ []

def checkAllG1 : Bool :=
  (List.range 2).all (fun i =>
    (List.range 4).all (fun φ =>
      let p := i + 3
      ((dataAllG1 p φ).length == Mfun p φ - p - 1) && checkRange (dataAllG1 p φ) p φ))

theorem checkAllG1_ok : checkAllG1 = true := by decide

theorem checkAllG1_range (p φ : Nat) (hp0 : 3 ≤ p) (hp1 : p ≤ 4) (hφ : φ < 4) :
    (dataAllG1 p φ).length = Mfun p φ - p - 1 ∧ checkRange (dataAllG1 p φ) p φ = true := by
  have h := checkAllG1_ok
  unfold checkAllG1 at h
  have h1 := List.all_eq_true.1 h (p - 3) (List.mem_range.2 (by omega))
  have h2 := List.all_eq_true.1 h1 φ (List.mem_range.2 hφ)
  rw [show p - 3 + 3 = p by omega] at h2
  simp only [Bool.and_eq_true] at h2
  exact ⟨beq_iff_eq.1 h2.1, h2.2⟩

