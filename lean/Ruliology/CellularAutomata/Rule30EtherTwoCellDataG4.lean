def dataAllG4 (p φ : Nat) : List (Nat × Nat × Nat) := (dataTabG4.getD (p - 8) []).getD φ []

def checkAllG4 : Bool :=
  (List.range 2).all (fun i =>
    (List.range 4).all (fun φ =>
      let p := i + 8
      ((dataAllG4 p φ).length == Mfun p φ - p - 1) && checkRange (dataAllG4 p φ) p φ))

theorem checkAllG4_ok : checkAllG4 = true := by decide

theorem checkAllG4_range (p φ : Nat) (hp0 : 8 ≤ p) (hp1 : p ≤ 9) (hφ : φ < 4) :
    (dataAllG4 p φ).length = Mfun p φ - p - 1 ∧ checkRange (dataAllG4 p φ) p φ = true := by
  have h := checkAllG4_ok
  unfold checkAllG4 at h
  have h1 := List.all_eq_true.1 h (p - 8) (List.mem_range.2 (by omega))
  have h2 := List.all_eq_true.1 h1 φ (List.mem_range.2 hφ)
  rw [show p - 8 + 8 = p by omega] at h2
  simp only [Bool.and_eq_true] at h2
  exact ⟨beq_iff_eq.1 h2.1, h2.2⟩

