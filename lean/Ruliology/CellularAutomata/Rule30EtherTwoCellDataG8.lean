def dataAllG8 (p φ : Nat) : List (Nat × Nat × Nat) := (dataTabG8.getD (p - 13) []).getD φ []

def checkAllG8 : Bool :=
  (List.range 1).all (fun i =>
    (List.range 4).all (fun φ =>
      let p := i + 13
      ((dataAllG8 p φ).length == Mfun p φ - p - 1) && checkRange (dataAllG8 p φ) p φ))

theorem checkAllG8_ok : checkAllG8 = true := by decide

theorem checkAllG8_range (p φ : Nat) (hp0 : 13 ≤ p) (hp1 : p ≤ 13) (hφ : φ < 4) :
    (dataAllG8 p φ).length = Mfun p φ - p - 1 ∧ checkRange (dataAllG8 p φ) p φ = true := by
  have h := checkAllG8_ok
  unfold checkAllG8 at h
  have h1 := List.all_eq_true.1 h (p - 13) (List.mem_range.2 (by omega))
  have h2 := List.all_eq_true.1 h1 φ (List.mem_range.2 hφ)
  rw [show p - 13 + 13 = p by omega] at h2
  simp only [Bool.and_eq_true] at h2
  exact ⟨beq_iff_eq.1 h2.1, h2.2⟩

