module
public import Ruliology.CellularAutomata.Rule30ZeroBoundary

/-! Finite-past strip certificates and a counterexample to a proposed rate.
No arbitrary-past-length closing theorem or Prize result is asserted. -/
@[expose] public section
namespace Ruliology.CellularAutomata.Rule30PastStrip
open Rule30ZeroBoundary
set_option maxRecDepth 100000
set_option maxHeartbeats 20000000

theorem common_future_recon (a b : Nat → Bool) (T : Nat)
    (h : ∀ t, T ≤ t → a t = b t) :
    ∀ k t, T ≤ t → recon a k t = recon b k t := by
  intro k t ht
  exact recon_local k t (fun j _ => h (t+j) (by omega))

/-- Two equal columns of the entire finite past strip are an absorbing state.
The future is shared, with no periodicity assumption. -/
theorem tail_of_strip_pair (a b : Nat → Bool) (T M : Nat)
    (future : ∀ t, T ≤ t → a t = b t)
    (h0 : ∀ t, t < T → recon a M t = recon b M t)
    (h1 : ∀ t, t < T → recon a (M+1) t = recon b (M+1) t) :
    ∀ k, M ≤ k → ∀ t, recon a k t = recon b k t := by
  have at0 : ∀ t, recon a M t = recon b M t := by
    intro t
    by_cases ht : t < T
    · exact h0 t ht
    · exact common_future_recon a b T future M t (by omega)
  have at1 : ∀ t, recon a (M+1) t = recon b (M+1) t := by
    intro t
    by_cases ht : t < T
    · exact h1 t ht
    · exact common_future_recon a b T future (M+1) t (by omega)
  have key : ∀ i, ∀ t,
      recon a (M+i) t = recon b (M+i) t ∧
      recon a (M+i+1) t = recon b (M+i+1) t := by
    intro i
    induction i with
    | zero => intro t; exact ⟨at0 t,at1 t⟩
    | succ i ih =>
        intro t
        constructor
        · simpa only [Nat.add_assoc] using (ih t).2
        · rw [show M+(i+1)+1 = (M+i)+2 by omega, recon_two, recon_two,
            (ih (t+1)).2,(ih t).2,(ih t).1]
  intro k hk t
  simpa only [Nat.add_sub_of_le hk] using (key (k-M) t).1

structure Triangle where
  horizon : Nat
  columns : List Nat

def cell (c : Triangle) (k t : Nat) : Bool :=
  Nat.testBit (c.columns[k]?.getD 0) t

def Valid (c : Triangle) (a : Nat → Bool) : Prop :=
  (∀ t : Fin c.horizon, cell c 0 t = false) ∧
  (∀ t : Fin c.horizon, 1+t.val < c.horizon → cell c 1 t = a t) ∧
  (∀ k t : Fin c.horizon, k.val+2+t.val < c.horizon →
    cell c (k.val+2) t = xor (cell c (k.val+1) (t.val+1))
      (cell c (k.val+1) t || cell c k t))

instance validDecidable (c : Triangle) (a : Nat → Bool) : Decidable (Valid c a) := by
  unfold Valid
  infer_instance

theorem triangle_sound (c : Triangle) (a : Nat → Bool) (h : Valid c a) :
    ∀ k t, k+t < c.horizon → cell c k t = recon a k t := by
  obtain ⟨wall,head,step⟩ := h
  have key : ∀ k,
      (∀ t, k+t < c.horizon → cell c k t = recon a k t) ∧
      (∀ t, k+1+t < c.horizon → cell c (k+1) t = recon a (k+1) t) := by
    intro k
    induction k with
    | zero =>
        constructor
        · intro t ht
          exact wall ⟨t,by omega⟩
        · intro t ht
          exact head ⟨t,by omega⟩ (by omega)
    | succ k ih =>
        refine ⟨ih.2,?_⟩
        intro t ht
        rw [show k+1+1 = k+2 by omega,step ⟨k,by omega⟩ ⟨t,by omega⟩ (by omega),
          recon_two,ih.2 (t+1) (by omega),ih.2 t (by omega),ih.1 t (by omega)]
  exact fun k t ht => (key k).1 t ht

def words : List Nat := [8,9,16,18,33,36,66,72,132,144]
def bitNat (b : Bool) : Nat := if b then 1 else 0
def window (g : Nat → Bool) (r : Nat) : Nat :=
  bitNat (g r) + 2*bitNat (g (r+1)) + 4*bitNat (g (r+2)) +
  8*bitNat (g (r+3)) + 16*bitNat (g (r+4)) + 32*bitNat (g (r+5)) +
  64*bitNat (g (r+6)) + 128*bitNat (g (r+7))
def GateLegal (g : Nat → Bool) : Prop := ∀ r, window g r ∈ words

theorem window_congr (a b : Nat → Bool) (r s : Nat)
    (h : ∀ j, j < 8 → a (r+j) = b (s+j)) : window a r = window b s := by
  unfold window
  have h0 := h 0 (by omega)
  simp only [Nat.add_zero] at h0
  rw [h0,h 1 (by omega),h 2 (by omega),h 3 (by omega),h 4 (by omega),
    h 5 (by omega),h 6 (by omega),h 7 (by omega)]

def future (r : Nat) : Bool :=
  if r < 100 then Nat.testBit 654331177868800777882986221700 r
  else decide ((r-100)%5=4)

private theorem future_prefix_legal : ∀ r : Fin 105, window future r ∈ words := by
  decide +kernel

theorem future_legal : GateLegal future := by
  intro r
  by_cases hr : r < 100
  · exact future_prefix_legal ⟨r,by omega⟩
  · have eq : window future r = window future (100+(r-100)%5) := by
      apply window_congr
      intro j hj
      unfold future
      rw [ite_eq_right (by omega),ite_eq_right (by omega)]
      have hm : (r+j-100)%5 = (100+(r-100)%5+j-100)%5 := by omega
      rw [hm]
    rw [eq]
    exact future_prefix_legal ⟨100+(r-100)%5,by omega⟩

def prepend (p : Nat) (g : Nat → Bool) (r : Nat) : Bool :=
  if r < 10 then Nat.testBit p r else g (r-10)
def oddTrace (g : Nat → Bool) (t : Nat) : Bool :=
  if t%2=0 then !(g (t/2)) else true

private theorem past_prefix_legal : ∀ p ∈ [132,528], ∀ r : Fin 10,
    window (prepend p future) r ∈ words := by decide +kernel

theorem both_pasts_legal : GateLegal (prepend 132 future) ∧ GateLegal (prepend 528 future) := by
  have key : ∀ p ∈ [132,528], GateLegal (prepend p future) := by
    intro p hp r
    by_cases hr : r < 10
    · exact past_prefix_legal p hp ⟨r,hr⟩
    · have eq : window (prepend p future) r = window future (r-10) := by
        apply window_congr
        intro j hj
        unfold prepend
        rw [ite_eq_right (by omega),show r+j-10 = r-10+j by omega]
      rw [eq]
      exact future_legal (r-10)
  exact ⟨key 132 (by decide),key 528 (by decide)⟩

