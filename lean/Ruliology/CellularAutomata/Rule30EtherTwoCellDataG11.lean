def dataAllG11 (p φ : Nat) : List (Nat × Nat × Nat) := (dataTabG11.getD (p - 18) []).getD φ []

def checkAllG11 : Bool :=
  (List.range 2).all (fun i =>
    (List.range 4).all (fun φ =>
      let p := i + 18
      ((dataAllG11 p φ).length == Mfun p φ - p - 1) && checkRange (dataAllG11 p φ) p φ))

theorem checkAllG11_ok : checkAllG11 = true := by decide

theorem checkAllG11_range (p φ : Nat) (hp0 : 18 ≤ p) (hp1 : p ≤ 19) (hφ : φ < 4) :
    (dataAllG11 p φ).length = Mfun p φ - p - 1 ∧ checkRange (dataAllG11 p φ) p φ = true := by
  have h := checkAllG11_ok
  unfold checkAllG11 at h
  have h1 := List.all_eq_true.1 h (p - 18) (List.mem_range.2 (by omega))
  have h2 := List.all_eq_true.1 h1 φ (List.mem_range.2 hφ)
  rw [show p - 18 + 18 = p by omega] at h2
  simp only [Bool.and_eq_true] at h2
  exact ⟨beq_iff_eq.1 h2.1, h2.2⟩

