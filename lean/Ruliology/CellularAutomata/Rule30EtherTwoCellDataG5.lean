def dataAllG5 (p φ : Nat) : List (Nat × Nat × Nat) := (dataTabG5.getD (p - 10) []).getD φ []

def checkAllG5 : Bool :=
  (List.range 1).all (fun i =>
    (List.range 4).all (fun φ =>
      let p := i + 10
      ((dataAllG5 p φ).length == Mfun p φ - p - 1) && checkRange (dataAllG5 p φ) p φ))

theorem checkAllG5_ok : checkAllG5 = true := by decide

theorem checkAllG5_range (p φ : Nat) (hp0 : 10 ≤ p) (hp1 : p ≤ 10) (hφ : φ < 4) :
    (dataAllG5 p φ).length = Mfun p φ - p - 1 ∧ checkRange (dataAllG5 p φ) p φ = true := by
  have h := checkAllG5_ok
  unfold checkAllG5 at h
  have h1 := List.all_eq_true.1 h (p - 10) (List.mem_range.2 (by omega))
  have h2 := List.all_eq_true.1 h1 φ (List.mem_range.2 hφ)
  rw [show p - 10 + 10 = p by omega] at h2
  simp only [Bool.and_eq_true] at h2
  exact ⟨beq_iff_eq.1 h2.1, h2.2⟩

