def dataAllG12 (p φ : Nat) : List (Nat × Nat × Nat) := (dataTabG12.getD (p - 20) []).getD φ []

def checkAllG12 : Bool :=
  (List.range 2).all (fun i =>
    (List.range 4).all (fun φ =>
      let p := i + 20
      ((dataAllG12 p φ).length == Mfun p φ - p - 1) && checkRange (dataAllG12 p φ) p φ))

theorem checkAllG12_ok : checkAllG12 = true := by decide

theorem checkAllG12_range (p φ : Nat) (hp0 : 20 ≤ p) (hp1 : p ≤ 21) (hφ : φ < 4) :
    (dataAllG12 p φ).length = Mfun p φ - p - 1 ∧ checkRange (dataAllG12 p φ) p φ = true := by
  have h := checkAllG12_ok
  unfold checkAllG12 at h
  have h1 := List.all_eq_true.1 h (p - 20) (List.mem_range.2 (by omega))
  have h2 := List.all_eq_true.1 h1 φ (List.mem_range.2 hφ)
  rw [show p - 20 + 20 = p by omega] at h2
  simp only [Bool.and_eq_true] at h2
  exact ⟨beq_iff_eq.1 h2.1, h2.2⟩

