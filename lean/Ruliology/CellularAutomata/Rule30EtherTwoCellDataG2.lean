def dataAllG2 (p φ : Nat) : List (Nat × Nat × Nat) := (dataTabG2.getD (p - 5) []).getD φ []

def checkAllG2 : Bool :=
  (List.range 1).all (fun i =>
    (List.range 4).all (fun φ =>
      let p := i + 5
      ((dataAllG2 p φ).length == Mfun p φ - p - 1) && checkRange (dataAllG2 p φ) p φ))

theorem checkAllG2_ok : checkAllG2 = true := by decide

theorem checkAllG2_range (p φ : Nat) (hp0 : 5 ≤ p) (hp1 : p ≤ 5) (hφ : φ < 4) :
    (dataAllG2 p φ).length = Mfun p φ - p - 1 ∧ checkRange (dataAllG2 p φ) p φ = true := by
  have h := checkAllG2_ok
  unfold checkAllG2 at h
  have h1 := List.all_eq_true.1 h (p - 5) (List.mem_range.2 (by omega))
  have h2 := List.all_eq_true.1 h1 φ (List.mem_range.2 hφ)
  rw [show p - 5 + 5 = p by omega] at h2
  simp only [Bool.and_eq_true] at h2
  exact ⟨beq_iff_eq.1 h2.1, h2.2⟩

