/-! ## 1. The Universal Backward Wave Cascade (`1^∞ → (100)^∞ → (011)^∞`) -/

/-- Exact bitwise duality between `bstep1` and `bstep0`: whenever `V.testBit i = true` at `2 ≤ i < K`,
the one-step backward preimage `X = bstep1 K V` satisfies the monotone NOR recurrence
`X.testBit i = !(X.testBit (i - 1) || X.testBit (i - 2))`. -/
theorem bstep1_nor_recurrence {K V i : Nat} (hi2 : 2 ≤ i) (hiK : i < K)
    (hV : V.testBit i = true) :
    (bstep1 K V).testBit i = !((bstep1 K V).testBit (i - 1) || (bstep1 K V).testBit (i - 2)) := by
  rw [bstep1_testBit_lt hiK, hV, ite_eq_right (by omega), ite_eq_right (by omega)]
  cases (bstep1 K V).testBit (i - 1) || (bstep1 K V).testBit (i - 2) <;> rfl

/-- Universal period-3 `(100)^∞` NOR wave for `bstep1`: whenever `V.testBit r = true` for all
`m ≤ r < K` (`2 ≤ m`), the upper bits of `X = bstep1 K V` lock into a strict period-3 wave
`X.testBit (i + 3) = X.testBit i` with at most one `true` bit in every consecutive pair. -/
theorem bstep1_nor_period_three {K m V i : Nat} (hm : 2 ≤ m) (hmi : m ≤ i) (hiK : i + 3 < K)
    (hones : ∀ r, m ≤ r → r < K → V.testBit r = true) :
    ((bstep1 K V).testBit i && (bstep1 K V).testBit (i + 1)) = false ∧
      (bstep1 K V).testBit (i + 3) = (bstep1 K V).testBit i := by
  have h1 : (bstep1 K V).testBit (i + 1) =
      !((bstep1 K V).testBit i || (bstep1 K V).testBit (i - 1)) := by
    have := bstep1_nor_recurrence (K := K) (V := V) (i := i + 1) (by omega) (by omega)
      (hones (i + 1) (by omega) (by omega))
    simpa [Nat.add_sub_cancel] using this
  have h2 : (bstep1 K V).testBit (i + 2) =
      !((bstep1 K V).testBit (i + 1) || (bstep1 K V).testBit i) := by
    have := bstep1_nor_recurrence (K := K) (V := V) (i := i + 2) (by omega) (by omega)
      (hones (i + 2) (by omega) (by omega))
    simpa [show i + 2 - 1 = i + 1 by omega, show i + 2 - 2 = i by omega] using this
  have h3 : (bstep1 K V).testBit (i + 3) =
      !((bstep1 K V).testBit (i + 2) || (bstep1 K V).testBit (i + 1)) := by
    have := bstep1_nor_recurrence (K := K) (V := V) (i := i + 3) (by omega) (by omega)
      (hones (i + 3) (by omega) (by omega))
    simpa [show i + 3 - 1 = i + 2 by omega, show i + 3 - 2 = i + 1 by omega] using this
  rw [h3, h2, h1]
  cases (bstep1 K V).testBit (i - 1) <;> cases (bstep1 K V).testBit i <;> decide

/-- **Every Type I primitive root enters the universal period-3 `(100)^∞` NOR wave at backward step 3.**
If `W < 2^k` (`4 ≤ k ≤ K`) is a Type I primitive root (so `U = bstep1 K W < 2^(k - 2)` and
`V = B_shift K W` has `V.testBit r = true` for all `k - 2 ≤ r < K`), then its 3-step backward
preimage `X = bstep1 K (B_shift K W)` satisfies `X.testBit (i + 3) = X.testBit i` for all
`k - 2 ≤ i` with `i + 3 < K`. -/
theorem typeI_step3_nor_wave {K k W i : Nat} (hk4 : 4 ≤ k) (hki : k - 2 ≤ i) (hiK : i + 3 < K)
    (hones : ∀ r, k - 2 ≤ r → r < K → (B_shift K W).testBit r = true) :
    ((bstep1 K (B_shift K W)).testBit i && (bstep1 K (B_shift K W)).testBit (i + 1)) = false ∧
      (bstep1 K (B_shift K W)).testBit (i + 3) = (bstep1 K (B_shift K W)).testBit i :=
  bstep1_nor_period_three (by omega) hki hiK hones

/-- At eight bits (`k = 8`), the three Type I primitive roots `201, 225, 253` realize the three
distinct phases `(false, false, true)`, `(true, false, false)`, and `(false, true, false)` of the
period-3 `(100)^∞` NOR wave at bits `(8, 9, 10)` of their 3-step preimage `bstep1 12 (B_shift 12 w)`. -/
theorem typeI_eight_bit_three_phases :
    (let X := bstep1 12 (B_shift 12 201); (X.testBit 8, X.testBit 9, X.testBit 10)) =
      (false, false, true) ∧
    (let X := bstep1 12 (B_shift 12 225); (X.testBit 8, X.testBit 9, X.testBit 10)) =
      (true, false, false) ∧
    (let X := bstep1 12 (B_shift 12 253); (X.testBit 8, X.testBit 9, X.testBit 10)) =
      (false, true, false) := by
  decide +kernel

/-- **Wave 2 to Wave 3 (`(100)^∞ → (011)^∞`) under `bstep1`:** if `Y` satisfies the backward NOR
recurrence `Y.testBit r = !(Y.testBit (r - 1) || Y.testBit (r - 2))` for `m ≤ r < K` (`2 ≤ m`),
then `Z = bstep1 K Y` is the exact bitwise complement `Z.testBit i = !Y.testBit i` for all
`m + 4 ≤ i < K`, and satisfies `(Z.testBit (i - 1) || Z.testBit i) = true`. -/
theorem wave_100_to_011_step1 {K m Y : Nat} (hm : 2 ≤ m)
    (hnor : ∀ r, m ≤ r → r < K → Y.testBit r = !(Y.testBit (r - 1) || Y.testBit (r - 2))) :
    ∀ d, m + 4 + d < K →
      (bstep1 K Y).testBit (m + 4 + d) = !(Y.testBit (m + 4 + d)) ∧
      ((bstep1 K Y).testBit (m + 3 + d) || (bstep1 K Y).testBit (m + 4 + d)) = true := by
  intro d
  induction d with
  | zero =>
    intro hK
    have hy0 : Y.testBit m = !(Y.testBit (m - 1) || Y.testBit (m - 2)) :=
      hnor m (by omega) (by omega)
    have hy1 : Y.testBit (m + 1) = !(Y.testBit m || Y.testBit (m - 1)) := by
      simpa [show m + 1 - 1 = m by omega, show m + 1 - 2 = m - 1 by omega] using
        hnor (m + 1) (by omega) (by omega)
    have hy2 : Y.testBit (m + 2) = !(Y.testBit (m + 1) || Y.testBit m) := by
      simpa [show m + 2 - 1 = m + 1 by omega, show m + 2 - 2 = m by omega] using
        hnor (m + 2) (by omega) (by omega)
    have hy3 : Y.testBit (m + 3) = !(Y.testBit (m + 2) || Y.testBit (m + 1)) := by
      simpa [show m + 3 - 1 = m + 2 by omega, show m + 3 - 2 = m + 1 by omega] using
        hnor (m + 3) (by omega) (by omega)
    have hy4 : Y.testBit (m + 4) = !(Y.testBit (m + 3) || Y.testBit (m + 2)) := by
      simpa [show m + 4 - 1 = m + 3 by omega, show m + 4 - 2 = m + 2 by omega] using
        hnor (m + 4) (by omega) (by omega)
    have hz0 : (bstep1 K Y).testBit m =
        xor (Y.testBit m) ((bstep1 K Y).testBit (m - 1) || (bstep1 K Y).testBit (m - 2)) := by
      rw [bstep1_testBit_lt (by omega), ite_eq_right (by omega), ite_eq_right (by omega)]
    have hz1 : (bstep1 K Y).testBit (m + 1) =
        xor (Y.testBit (m + 1)) ((bstep1 K Y).testBit m || (bstep1 K Y).testBit (m - 1)) := by
      rw [bstep1_testBit_lt (by omega), ite_eq_right (by omega), ite_eq_right (by omega)]
      simp
    have hz2 : (bstep1 K Y).testBit (m + 2) =
        xor (Y.testBit (m + 2)) ((bstep1 K Y).testBit (m + 1) || (bstep1 K Y).testBit m) := by
      rw [bstep1_testBit_lt (by omega), ite_eq_right (by omega), ite_eq_right (by omega)]
      simp [show m + 2 - 1 = m + 1 by omega, show m + 2 - 2 = m by omega]
    have hz3 : (bstep1 K Y).testBit (m + 3) =
        xor (Y.testBit (m + 3)) ((bstep1 K Y).testBit (m + 2) || (bstep1 K Y).testBit (m + 1)) := by
      rw [bstep1_testBit_lt (by omega), ite_eq_right (by omega), ite_eq_right (by omega)]
      simp [show m + 3 - 1 = m + 2 by omega, show m + 3 - 2 = m + 1 by omega]
    have hz4 : (bstep1 K Y).testBit (m + 4) =
        xor (Y.testBit (m + 4)) ((bstep1 K Y).testBit (m + 3) || (bstep1 K Y).testBit (m + 2)) := by
      rw [bstep1_testBit_lt (by omega), ite_eq_right (by omega), ite_eq_right (by omega)]
      simp [show m + 4 - 1 = m + 3 by omega, show m + 4 - 2 = m + 2 by omega]
    simp only [Nat.add_zero]
    rw [hz4, hz3, hz2, hz1, hz0, hy4, hy3, hy2, hy1, hy0]
    cases Y.testBit (m - 2) <;> cases Y.testBit (m - 1) <;>
      cases (bstep1 K Y).testBit (m - 2) <;> cases (bstep1 K Y).testBit (m - 1) <;> decide
  | succ d ih =>
    intro hK
    obtain ⟨hzd, hord⟩ := ih (by omega)
    have hstep : (bstep1 K Y).testBit (m + 4 + (d + 1)) =
        xor (Y.testBit (m + 4 + (d + 1)))
          ((bstep1 K Y).testBit (m + 4 + d) || (bstep1 K Y).testBit (m + 3 + d)) := by
      rw [bstep1_testBit_lt hK, ite_eq_right (by omega), ite_eq_right (by omega)]
      simp [show m + 4 + (d + 1) - 1 = m + 4 + d by omega,
        show m + 4 + (d + 1) - 2 = m + 3 + d by omega]
    rw [Bool.or_comm] at hord
    have hzd1 : (bstep1 K Y).testBit (m + 4 + (d + 1)) = !(Y.testBit (m + 4 + (d + 1))) := by
      rw [hstep, hord]
      cases Y.testBit (m + 4 + (d + 1)) <;> rfl
    refine ⟨hzd1, ?_⟩
    rw [show m + 3 + (d + 1) = m + 4 + d by omega, hzd, hzd1]
    have hynor := hnor (m + 4 + (d + 1)) (by omega) hK
    rw [show m + 4 + (d + 1) - 1 = m + 4 + d by omega] at hynor
    rw [hynor]
    cases Y.testBit (m + 4 + d) <;> cases Y.testBit (m + 4 + (d + 1) - 2) <;> decide

/-- **Wave 2 to Wave 3 (`(100)^∞ → (011)^∞`) under `bstep0`:** if `Y` satisfies the backward NOR
recurrence on `[m, K)` (`2 ≤ m`), then `Z = bstep0 K Y` also satisfies
`Z.testBit i = !Y.testBit i` for all `m + 4 ≤ i < K`. -/
theorem wave_100_to_011_step0 {K m Y : Nat} (hm : 2 ≤ m)
    (hnor : ∀ r, m ≤ r → r < K → Y.testBit r = !(Y.testBit (r - 1) || Y.testBit (r - 2))) :
    ∀ d, m + 4 + d < K →
      (bstep0 K Y).testBit (m + 4 + d) = !(Y.testBit (m + 4 + d)) ∧
      ((bstep0 K Y).testBit (m + 3 + d) || (bstep0 K Y).testBit (m + 4 + d)) = true := by
  intro d
  induction d with
  | zero =>
    intro hK
    have hy0 : Y.testBit m = !(Y.testBit (m - 1) || Y.testBit (m - 2)) :=
      hnor m (by omega) (by omega)
    have hy1 : Y.testBit (m + 1) = !(Y.testBit m || Y.testBit (m - 1)) := by
      simpa [show m + 1 - 1 = m by omega, show m + 1 - 2 = m - 1 by omega] using
        hnor (m + 1) (by omega) (by omega)
    have hy2 : Y.testBit (m + 2) = !(Y.testBit (m + 1) || Y.testBit m) := by
      simpa [show m + 2 - 1 = m + 1 by omega, show m + 2 - 2 = m by omega] using
        hnor (m + 2) (by omega) (by omega)
    have hy3 : Y.testBit (m + 3) = !(Y.testBit (m + 2) || Y.testBit (m + 1)) := by
      simpa [show m + 3 - 1 = m + 2 by omega, show m + 3 - 2 = m + 1 by omega] using
        hnor (m + 3) (by omega) (by omega)
    have hy4 : Y.testBit (m + 4) = !(Y.testBit (m + 3) || Y.testBit (m + 2)) := by
      simpa [show m + 4 - 1 = m + 3 by omega, show m + 4 - 2 = m + 2 by omega] using
        hnor (m + 4) (by omega) (by omega)
    have hz0 : (bstep0 K Y).testBit m =
        xor (Y.testBit m) ((bstep0 K Y).testBit (m - 1) || (bstep0 K Y).testBit (m - 2)) := by
      rw [bstep0_testBit_lt (by omega), ite_eq_right (by omega), ite_eq_right (by omega)]
    have hz1 : (bstep0 K Y).testBit (m + 1) =
        xor (Y.testBit (m + 1)) ((bstep0 K Y).testBit m || (bstep0 K Y).testBit (m - 1)) := by
      rw [bstep0_testBit_lt (by omega), ite_eq_right (by omega), ite_eq_right (by omega)]
      simp
    have hz2 : (bstep0 K Y).testBit (m + 2) =
        xor (Y.testBit (m + 2)) ((bstep0 K Y).testBit (m + 1) || (bstep0 K Y).testBit m) := by
      rw [bstep0_testBit_lt (by omega), ite_eq_right (by omega), ite_eq_right (by omega)]
      simp [show m + 2 - 1 = m + 1 by omega, show m + 2 - 2 = m by omega]
    have hz3 : (bstep0 K Y).testBit (m + 3) =
        xor (Y.testBit (m + 3)) ((bstep0 K Y).testBit (m + 2) || (bstep0 K Y).testBit (m + 1)) := by
      rw [bstep0_testBit_lt (by omega), ite_eq_right (by omega), ite_eq_right (by omega)]
      simp [show m + 3 - 1 = m + 2 by omega, show m + 3 - 2 = m + 1 by omega]
    have hz4 : (bstep0 K Y).testBit (m + 4) =
        xor (Y.testBit (m + 4)) ((bstep0 K Y).testBit (m + 3) || (bstep0 K Y).testBit (m + 2)) := by
      rw [bstep0_testBit_lt (by omega), ite_eq_right (by omega), ite_eq_right (by omega)]
      simp [show m + 4 - 1 = m + 3 by omega, show m + 4 - 2 = m + 2 by omega]
    simp only [Nat.add_zero]
    rw [hz4, hz3, hz2, hz1, hz0, hy4, hy3, hy2, hy1, hy0]
    cases Y.testBit (m - 2) <;> cases Y.testBit (m - 1) <;>
      cases (bstep0 K Y).testBit (m - 2) <;> cases (bstep0 K Y).testBit (m - 1) <;> decide
  | succ d ih =>
    intro hK
    obtain ⟨hzd, hord⟩ := ih (by omega)
    have hstep : (bstep0 K Y).testBit (m + 4 + (d + 1)) =
        xor (Y.testBit (m + 4 + (d + 1)))
          ((bstep0 K Y).testBit (m + 4 + d) || (bstep0 K Y).testBit (m + 3 + d)) := by
      rw [bstep0_testBit_lt hK, ite_eq_right (by omega), ite_eq_right (by omega)]
      simp [show m + 4 + (d + 1) - 1 = m + 4 + d by omega,
        show m + 4 + (d + 1) - 2 = m + 3 + d by omega]
    rw [Bool.or_comm] at hord
    have hzd1 : (bstep0 K Y).testBit (m + 4 + (d + 1)) = !(Y.testBit (m + 4 + (d + 1))) := by
      rw [hstep, hord]
      cases Y.testBit (m + 4 + (d + 1)) <;> rfl
    refine ⟨hzd1, ?_⟩
    rw [show m + 3 + (d + 1) = m + 4 + d by omega, hzd, hzd1]
    have hynor := hnor (m + 4 + (d + 1)) (by omega) hK
    rw [show m + 4 + (d + 1) - 1 = m + 4 + d by omega] at hynor
    rw [hynor]
    cases Y.testBit (m + 4 + d) <;> cases Y.testBit (m + 4 + (d + 1) - 2) <;> decide


/-- **Wave 3 to Wave 4 Period-Doubling (`(011)^∞ → (000101)^∞`, period `3 → 6`) under `bstep0`:**
if `Z` satisfies the backward NAND recurrence `Z.testBit r = !(Z.testBit (r - 1) && Z.testBit (r - 2))`
with `(Z.testBit (r - 1) || Z.testBit (r - 2)) = true` for `m ≤ r < K` (`2 ≤ m`), then
`W = bstep0 K Z` locks into a strict period-6 `(000101)^∞` wave
`(bstep0 K Z).testBit (i + 6) = (bstep0 K Z).testBit i` for all `m + 5 ≤ i` with `i + 6 < K`. -/
theorem wave_011_to_period6_step0 {K m Z i : Nat} (hm : 2 ≤ m) (hmi : m + 5 ≤ i) (hiK : i + 6 < K)
    (hnand : ∀ r, m ≤ r → r < K →
      Z.testBit r = !(Z.testBit (r - 1) && Z.testBit (r - 2)) ∧
      (Z.testBit (r - 1) || Z.testBit (r - 2)) = true) :
    (bstep0 K Z).testBit (i + 6) = (bstep0 K Z).testBit i := by
  have hz : ∀ off, off ≤ 11 →
      Z.testBit (i - 5 + off) = !(Z.testBit (i - 5 + off - 1) && Z.testBit (i - 5 + off - 2)) ∧
      (Z.testBit (i - 5 + off - 1) || Z.testBit (i - 5 + off - 2)) = true :=
    fun off hoff => hnand (i - 5 + off) (by omega) (by omega)
  have hw : ∀ off, off ≤ 11 →
      (bstep0 K Z).testBit (i - 5 + off) =
        xor (Z.testBit (i - 5 + off))
          ((bstep0 K Z).testBit (i - 5 + off - 1) || (bstep0 K Z).testBit (i - 5 + off - 2)) := by
    intro off hoff
    rw [bstep0_testBit_lt (by omega), ite_eq_right (by omega), ite_eq_right (by omega)]
  have h0 := (hz 0 (by omega)).1; have hor0 := (hz 0 (by omega)).2
  have h1 := (hz 1 (by omega)).1; have h2 := (hz 2 (by omega)).1
  have h3 := (hz 3 (by omega)).1; have h4 := (hz 4 (by omega)).1
  have h5 := (hz 5 (by omega)).1; have h6 := (hz 6 (by omega)).1
  have h7 := (hz 7 (by omega)).1; have h8 := (hz 8 (by omega)).1
  have h9 := (hz 9 (by omega)).1; have h10 := (hz 10 (by omega)).1
  have h11 := (hz 11 (by omega)).1
  have w0 := hw 0 (by omega); have w1 := hw 1 (by omega)
  have w2 := hw 2 (by omega); have w3 := hw 3 (by omega)
  have w4 := hw 4 (by omega); have w5 := hw 5 (by omega)
  have w6 := hw 6 (by omega); have w7 := hw 7 (by omega)
  have w8 := hw 8 (by omega); have w9 := hw 9 (by omega)
  have w10 := hw 10 (by omega); have w11 := hw 11 (by omega)
  simp only [Nat.add_zero, show i - 5 + 1 - 1 = i - 5 by omega,
    show i - 5 + 1 - 2 = i - 5 - 1 by omega,
    show i - 5 + 2 - 1 = i - 5 + 1 by omega, show i - 5 + 2 - 2 = i - 5 by omega,
    show i - 5 + 3 - 1 = i - 5 + 2 by omega, show i - 5 + 3 - 2 = i - 5 + 1 by omega,
    show i - 5 + 4 - 1 = i - 5 + 3 by omega, show i - 5 + 4 - 2 = i - 5 + 2 by omega,
    show i - 5 + 5 = i by omega, show i - 1 = i - 5 + 4 by omega, show i - 2 = i - 5 + 3 by omega,
    show i - 5 + 6 = i + 1 by omega, show i + 1 - 1 = i by omega, show i + 1 - 2 = i - 5 + 4 by omega,
    show i - 5 + 7 = i + 2 by omega, show i + 2 - 1 = i + 1 by omega, show i + 2 - 2 = i by omega,
    show i - 5 + 8 = i + 3 by omega, show i + 3 - 1 = i + 2 by omega, show i + 3 - 2 = i + 1 by omega,
    show i - 5 + 9 = i + 4 by omega, show i + 4 - 1 = i + 3 by omega, show i + 4 - 2 = i + 2 by omega,
    show i - 5 + 10 = i + 5 by omega, show i + 5 - 1 = i + 4 by omega, show i + 5 - 2 = i + 3 by omega,
    show i - 5 + 11 = i + 6 by omega, show i + 6 - 1 = i + 5 by omega, show i + 6 - 2 = i + 4 by omega]
    at h0 hor0 h1 h2 h3 h4 h5 h6 h7 h8 h9 h10 h11 w0 w1 w2 w3 w4 w5 w6 w7 w8 w9 w10 w11
  rw [w11, w10, w9, w8, w7, w6, w5, w4, w3, w2, w1, w0,
    h11, h10, h9, h8, h7, h6, h5, h4, h3, h2, h1, h0]
  revert hor0
  cases Z.testBit (i - 5 - 2) <;> cases Z.testBit (i - 5 - 1) <;>
    cases (bstep0 K Z).testBit (i - 5 - 2) <;> cases (bstep0 K Z).testBit (i - 5 - 1) <;> decide

/-! ## 2. Global Injectivity of `F_shift` and Disjoint Clone Rays -/

private theorem lt_two_pow_succ (n : Nat) : n < 2 ^ (n + 1) := by
  induction n with
  | zero => decide
  | succ n ih =>
    rw [Nat.pow_succ]
    omega

/-- **`F_shift` is globally injective on `Nat`.** -/
theorem F_shift_injective {V₁ V₂ : Nat} (heq : F_shift V₁ = F_shift V₂) : V₁ = V₂ := by
  have h1 : V₁ < 2 ^ (V₁ + V₂ + 1) :=
    Nat.lt_of_lt_of_le (lt_two_pow_succ V₁) (Nat.pow_le_pow_right (by omega) (by omega))
  have h2 : V₂ < 2 ^ (V₁ + V₂ + 1) :=
    Nat.lt_of_lt_of_le (lt_two_pow_succ V₂) (Nat.pow_le_pow_right (by omega) (by omega))
  have hb₁ := B_shift_F_shift (k := V₁ + V₂ + 1) (K := V₁ + V₂ + 5) (V := V₁)
    (by omega) h1 (by omega)
  have hb₂ := B_shift_F_shift (k := V₁ + V₂ + 1) (K := V₁ + V₂ + 5) (V := V₂)
    (by omega) h2 (by omega)
  exact hb₁.symm.trans ((congrArg (B_shift (V₁ + V₂ + 5)) heq).trans hb₂)

/-- **`F_shiftIter j` is globally injective on `Nat` for every `j : Nat`.** -/
theorem F_shiftIter_injective (j : Nat) {V₁ V₂ : Nat}
    (heq : F_shiftIter j V₁ = F_shiftIter j V₂) : V₁ = V₂ := by
  induction j with
  | zero => exact heq
  | succ j ih => exact ih (F_shift_injective heq)

/-- Iterated 2-step backward operator `B_shiftIter j K` recovers `W` from `F_shiftIter j W` at any
width `K ≥ k + 4 * j`. -/
def B_shiftIter : Nat → Nat → Nat → Nat
  | 0, _, W => W
  | j + 1, K, W => B_shiftIter j K (B_shift K W)

/-- **Exact Multi-Step Left-Inverse of `F_shiftIter`:** For any `k`-bit window `W < 2^k` (`k ≥ 1`),
`j : Nat`, and width `K ≥ k + 4 * j`, `B_shiftIter j K (F_shiftIter j W) = W`. -/
theorem B_shiftIter_F_shiftIter {K k W : Nat} (hk : 1 ≤ k) (hW : W < 2 ^ k)
    (j : Nat) (hK : k + 4 * j ≤ K) :
    B_shiftIter j K (F_shiftIter j W) = W := by
  induction j with
  | zero => rfl
  | succ j ih =>
    have hlt : F_shiftIter j W < 2 ^ (k + 4 * j) := F_shiftIter_lt hk hW j
    have hb := B_shift_F_shift (k := k + 4 * j) (K := K) (V := F_shiftIter j W)
      (by omega) hlt (by omega)
    simp only [F_shiftIter, B_shiftIter, hb]
    exact ih (by omega)

/-- **Disjoint Clone Rays Theorem:** if `W₁` and `W₂` are not in the image of `F_shift`, then their
clone rays `{F_shiftIter j₁ W₁}` and `{F_shiftIter j₂ W₂}` intersect if and only if
`j₁ = j₂` and `W₁ = W₂`. -/
theorem clone_ray_disjoint_of_primRoot {W₁ W₂ j₁ j₂ : Nat}
    (hprim₁ : ∀ V, F_shift V ≠ W₁) (hprim₂ : ∀ V, F_shift V ≠ W₂) :
    F_shiftIter j₁ W₁ = F_shiftIter j₂ W₂ ↔ j₁ = j₂ ∧ W₁ = W₂ := by
  constructor
  · intro heq
    induction j₁ generalizing j₂ with
    | zero =>
      cases j₂ with
      | zero => exact ⟨rfl, heq⟩
      | succ j₂ =>
        exfalso
        exact hprim₁ (F_shiftIter j₂ W₂) heq.symm
    | succ j₁ ih =>
      cases j₂ with
      | zero =>
        exfalso
        exact hprim₂ (F_shiftIter j₁ W₁) heq
      | succ j₂ =>
        obtain ⟨rfl, rfl⟩ := ih (F_shift_injective heq)
        exact ⟨rfl, rfl⟩
  · rintro ⟨rfl, rfl⟩
    rfl

/-! ## 3. Canonical Stripe-Prefix Defect Absorption & 16-Ray All-Length Mortality -/

/-- **Canonical Stripe-Prefix Defect Absorption Identity:** if the first `d` bits of `w` match
`stripe (m + 1 + j)` (`0 ≤ j < d`), absorbing those `d` stripe-matching bits into the stripe
prefix leaves the initial configuration `rowTail` identically unchanged:
`rowTail m w = rowTail (m + d) (w >>> d)`. -/
theorem rowTail_absorb_stripe (m d w : Nat)
    (hag : ∀ j, j < d → w.testBit j = stripe (m + 1 + j)) :
    rowTail m w = rowTail (m + d) (w >>> d) := by
  funext k
  unfold rowTail
  by_cases hkm : k ≤ m
  · rw [ite_eq_left hkm, ite_eq_left (by omega)]
  · by_cases hkd : k ≤ m + d
    · rw [ite_eq_right hkm, ite_eq_left hkd]
      have hj : k - m - 1 < d := by omega
      rw [hag (k - m - 1) hj, show m + 1 + (k - m - 1) = k by omega]
    · rw [ite_eq_right hkm, ite_eq_right hkd, Nat.testBit_shiftRight,
        show d + (k - (m + d) - 1) = k - m - 1 by omega]

/-- If `rowTail m w` agrees with `stripe` on `m + 1 .. m + d` (`j < d`) and deviates at an **even**
depth `m + d + 1`, then `m' = m + d` is **odd**, the shifted tail `w' = w >>> d` is **odd**
(`w' % 2 = 1`), and `rowTail m w = rowTail m' w'`. -/
theorem rowTail_even_defect_red (m d w : Nat)
    (hag : ∀ j, j < d → w.testBit j = stripe (m + 1 + j))
    (hne : w.testBit d ≠ stripe (m + 1 + d))
    (heven : (m + 1 + d) % 2 = 0) :
    (m + d) % 2 = 1 ∧ (w >>> d) % 2 = 1 ∧ rowTail m w = rowTail (m + d) (w >>> d) := by
  refine ⟨by omega, ?_, rowTail_absorb_stripe m d w hag⟩
  have hstr : stripe (m + 1 + d) = false := by
    unfold stripe
    rw [heven]
    rfl
  have hwd : w.testBit d = true := by
    rw [hstr] at hne
    cases h : w.testBit d
    · exfalso; exact hne h
    · rfl
  have ht0 : (w >>> d).testBit 0 = true := by
    rw [Nat.testBit_shiftRight, Nat.add_zero, hwd]
  rw [Nat.testBit_zero] at ht0
  exact decide_eq_true_eq.mp ht0

private theorem fin16_cases (u : Nat) (hu : u < 16) :
    u = 0 ∨ u = 1 ∨ u = 2 ∨ u = 3 ∨ u = 4 ∨ u = 5 ∨ u = 6 ∨ u = 7 ∨
    u = 8 ∨ u = 9 ∨ u = 10 ∨ u = 11 ∨ u = 12 ∨ u = 13 ∨ u = 14 ∨ u = 15 := by
  omega

/-- Every odd 5-bit front window `2 * u + 1` (`u < 16`) with `u ≠ 6` (`2 * u + 1 ≠ 13`) has a
certified width-32, horizon-31 closed cycle in the kit. -/
theorem cycle_five_bit_odd_31 (u : Fin 16) (hu : u.val ≠ 6) :
    ∃ L, Cycle 32 31 (2 * u.val + 1) 0 L := by
  rcases fin16_cases u.val u.isLt with
    h | h | h | h | h | h | h | h | h | h | h | h | h | h | h | h
  · rw [h]; exact ⟨4096, cyc_1_0⟩
  · rw [h]; exact ⟨16384, cyc_3_0⟩
  · rw [h]; exact ⟨65536, cyc_5_0⟩
  · rw [h]; exact ⟨16384, cyc_7_0⟩
  · rw [h]; exact ⟨4096, cyc4_9⟩
  · rw [h]; exact ⟨65536, cyc4_11⟩
  · exact absurd h hu
  · rw [h]; exact ⟨16384, cyc4_15⟩
  · rw [h]; exact ⟨16384, cyc5_17⟩
  · rw [h]; exact ⟨65536, cyc5_19⟩
  · rw [h]; exact ⟨32768, cyc5_21⟩
  · rw [h]; exact ⟨16384, cyc5_23⟩
  · rw [h]; exact ⟨16384, cyc5_25⟩
  · rw [h]; exact ⟨4096, cyc5_27⟩
  · rw [h]; exact ⟨65536, cyc5_29⟩
  · rw [h]; exact ⟨65536, cyc5_31⟩

/-- **15-Ray Horizon-31 All-Length Mortality Theorem:** for every `u : Fin 16` with `u.val ≠ 6`
(`2 * u.val + 1 ≠ 13`), every clone depth `j : Nat`, and every odd prefix length `m : Nat`,
the stripe-prefix configuration `rowTail m (F_shiftIter j (2 * u.val + 1))` turns depth `1` white
at an even time `t ≤ m + 31`. -/
theorem rowTail_fifteen_rays_31 (u : Fin 16) (hu : u.val ≠ 6) (j m : Nat) (hm : m % 2 = 1) :
    ∃ t, t ≤ m + 31 ∧ t % 2 = 0 ∧
      zrow (rowTail m (F_shiftIter j (2 * u.val + 1))) t 1 = false := by
  obtain ⟨L, hcyc⟩ := cycle_five_bit_odd_31 u hu
  have hu16 : u.val < 16 := u.isLt
  have hW32 : 2 * u.val + 1 < 2 ^ 5 := by omega
  have hodd : (2 * u.val + 1).testBit 0 = true := by
    rw [Nat.testBit_zero]
    exact decide_eq_true (by omega)
  exact (rowTail_F_shiftIter_sound (k := 5) (K := 32) (S := 31) (W := 2 * u.val + 1) (L := L)
    (by decide) hW32 hodd (by decide) (by decide) hcyc j m hm).2.2

/-- **16-Ray Horizon-45 All-Length Mortality Theorem:** for all 16 odd 5-bit roots `2 * u.val + 1`
(`u : Fin 16`), every clone depth `j : Nat`, and every odd prefix length `m : Nat`, the
stripe-prefix configuration `rowTail m (F_shiftIter j (2 * u.val + 1))` turns depth `1` white at
an even time `t ≤ m + 45`. -/
theorem rowTail_sixteen_rays_all_odd (u : Fin 16) (j m : Nat) (hm : m % 2 = 1) :
    ∃ t, t ≤ m + 45 ∧ t % 2 = 0 ∧
      zrow (rowTail m (F_shiftIter j (2 * u.val + 1))) t 1 = false := by
  by_cases hu : u.val = 6
  · rw [hu]
    simpa using (rowTail_ray13_all_odd j m hm).2.2
  · obtain ⟨t, ht, he, hz⟩ := rowTail_fifteen_rays_31 u hu j m hm
    exact ⟨t, by omega, he, hz⟩

