module

public import Ruliology.CellularAutomata.Rule30EtherThreeGate
public import Ruliology.CellularAutomata.Rule30MaskedJen

set_option Elab.async false
set_option maxRecDepth 200000
set_option maxHeartbeats 800000

@[expose] public section

namespace Ruliology.CellularAutomata
namespace Rule30EtherThreeGateLanguage

open Rule30Jen Rule30Ether Rule30EtherThree Rule30EtherThreeGate Rule30DrivenLeft

/-! ### 1. Bit-Window Encoding & Parametric Width-13 Rank + NFA Certificate -/

def rowW : Nat → (Nat → Bool) → Nat → List Bool
  | 0, _, _ => []
  | k + 1, f, p => f p :: rowW k f (p + 1)

theorem rowW_length : ∀ (k : Nat) (f : Nat → Bool) (p : Nat), (rowW k f p).length = k
  | 0, _, _ => rfl
  | k + 1, _, _ => by simp [rowW, rowW_length k]

def linStep : Bool → List Bool → Bool → List Bool
  | _, [], _ => []
  | prev, cur :: rest, ext => rule prev cur (rest.headD ext) :: linStep cur rest ext

theorem rowW_isR30_step {F : Nat → Nat → Bool} (hF : IsR30 F) (t : Nat) :
    ∀ (k p : Nat), rowW k (F (t + 1)) (p + 1) = linStep (F t p) (rowW k (F t) (p + 1)) (F t (p + 1 + k))
  | 0, _ => rfl
  | 1, p => congrArg (· :: []) (hF t p)
  | k + 2, p => by
    have ih := rowW_isR30_step hF t (k + 1) (p + 1)
    simp only [rowW, linStep] at ih ⊢
    rw [hF t p]; congr 1
    rw [show p + 1 + 1 + (k + 1) = p + 1 + (k + 2) by omega] at ih; exact ih

def encBits : List Bool → Nat
  | [] => 0
  | b :: bs => b.toNat + 2 * encBits bs

def decBits : Nat → Nat → List Bool
  | 0, _ => []
  | k + 1, n => (n % 2 == 1) :: decBits k (n / 2)

theorem decBits_length : ∀ (k n : Nat), (decBits k n).length = k
  | 0, _ => rfl
  | k + 1, n => by simp [decBits, decBits_length k (n / 2)]

theorem list_getD_ge : ∀ (xs : List Bool) (i : Nat) (d : Bool), xs.length ≤ i → xs.getD i d = d
  | [], _, _, _ => rfl
  | _ :: _, 0, _, h => by simp at h
  | _ :: xs, i + 1, d, h => list_getD_ge xs i d (by simp at h; omega)

theorem list_getD_append_left (lastB : Bool) :
    ∀ (bs : List Bool) (j : Nat), j < bs.length → (bs ++ [lastB]).getD j false = bs.getD j false
  | [], _, hj => by simp at hj
  | _ :: _, 0, _ => rfl
  | _ :: cs, j + 1, hj => list_getD_append_left lastB cs j (by simp at hj; omega)

theorem list_getD_append_last (lastB : Bool) :
    ∀ (bs : List Bool), (bs ++ [lastB]).getD bs.length false = lastB
  | [] => rfl
  | _ :: cs => list_getD_append_last lastB cs

theorem encBits_lt : ∀ (xs : List Bool), encBits xs < 2 ^ xs.length
  | [] => by decide
  | b :: bs => by
    have ih := encBits_lt bs
    have hb : b.toNat ≤ 1 := by cases b <;> decide
    simp only [encBits, List.length_cons, Nat.pow_succ]; omega

theorem decBits_encBits : ∀ (xs : List Bool), decBits xs.length (encBits xs) = xs
  | [] => rfl
  | b :: bs => by
    simp only [List.length_cons, encBits, decBits]
    have hmod : ((b.toNat + 2 * encBits bs) % 2 == 1) = b := by cases b <;> simp [Bool.toNat] <;> omega
    have hdiv : (b.toNat + 2 * encBits bs) / 2 = encBits bs := by cases b <;> simp [Bool.toNat] <;> omega
    rw [hmod, hdiv, decBits_encBits bs]

theorem decBits_encBits_of_len {xs : List Bool} {k : Nat} (hk : xs.length = k) :
    decBits k (encBits xs) = xs := by subst hk; exact decBits_encBits xs

theorem encBits_mod2 (b : Bool) (bs : List Bool) : (encBits (b :: bs) % 2 == 1) = b := by
  simp only [encBits]; cases b <;> simp [Bool.toNat] <;> omega

def oneStep13 (c0 ext : Bool) (s : Nat) : Nat := encBits (linStep c0 (decBits 13 s) ext)

def fastStep13 (c0 ext : Bool) (s : Nat) : Nat :=
  (((s <<< 1) ||| c0.toNat) ^^^ (s ||| (s >>> 1) ||| (ext.toNat <<< 12))) % 8192

theorem fastStep13_eq :
    ((List.range 8192).all fun s =>
      fastStep13 false false s == oneStep13 false false s &&
      fastStep13 false true s == oneStep13 false true s &&
      fastStep13 true false s == oneStep13 true false s &&
      fastStep13 true true s == oneStep13 true true s) = true := by decide +kernel

theorem fastStep13_eq_oneStep13 (c0 ext : Bool) {s : Nat} (hs : s < 8192) :
    fastStep13 c0 ext s = oneStep13 c0 ext s := by
  have h := List.all_eq_true.1 fastStep13_eq s (List.mem_range.2 hs)
  simp only [Bool.and_eq_true, beq_iff_eq] at h
  cases c0 <;> cases ext
  · exact h.1.1.1
  · exact h.1.1.2
  · exact h.1.2
  · exact h.2

def win13 (f : Nat → Bool) : Nat := encBits (rowW 13 f 1)

theorem win13_lt (f : Nat → Bool) : win13 f < 8192 := by
  unfold win13; have h := encBits_lt (rowW 13 f 1); rw [rowW_length] at h; simpa using h

theorem win13_col1 (f : Nat → Bool) : (win13 f % 2 == 1) = f 1 := by
  unfold win13 rowW; exact encBits_mod2 (f 1) (rowW 12 f 2)

theorem win13_step (x : Nat → Bool) (φ u : Nat) :
    win13 (half x φ (u + 1)) = fastStep13 (wordAt3 w001 (u + φ)) (half x φ u 14) (win13 (half x φ u)) := by
  rw [fastStep13_eq_oneStep13 _ _ (win13_lt _)]
  unfold win13 oneStep13
  have hr := rowW_isR30_step (drv_isR30 (fun t => wordAt3 w001 (t + φ)) x) u 13 0
  simp only [Nat.zero_add] at hr; unfold half
  rw [decBits_encBits_of_len (rowW_length 13 _ 1), hr, drv_col0 _ x u]

theorem drv_restart (c x : Nat → Bool) (t0 : Nat) :
    ∀ u p, drv c x (t0 + u) p = drv (fun u => c (t0 + u)) (drv c x t0) u p
  | 0, 0 => by simp [drv, drv_col0]
  | 0, p + 1 => by simp [drv]
  | u + 1, 0 => by simp [drv, Nat.add_assoc]
  | u + 1, p + 1 => by
    have h1 := drv_isR30 c x (t0 + u) p
    have h2 := drv_isR30 (fun v => c (t0 + v)) (drv c x t0) u p
    rw [show t0 + (u + 1) = (t0 + u) + 1 by omega, h1, h2,
      drv_restart c x t0 u p, drv_restart c x t0 u (p + 1), drv_restart c x t0 u (p + 2)]

theorem half_restart (x : Nat → Bool) (φ t0 u p : Nat) :
    half x φ (t0 + u) p = half (half x φ t0) ((t0 + φ) % 3) u p := by
  unfold half; rw [drv_restart]
  have hc : (fun v => wordAt3 w001 (t0 + v + φ)) = (fun v => wordAt3 w001 (v + (t0 + φ) % 3)) := by
    funext v; unfold wordAt3; rw [show (t0 + v + φ) % 3 = (v + (t0 + φ) % 3) % 3 by omega]
  rw [hc]

def allBelow13 (p : Nat → Bool) : Nat → Bool
  | 0 => true
  | n + 1 => allBelow13 p n && p n

theorem allBelow13_spec {p : Nat → Bool} : ∀ {n : Nat}, allBelow13 p n = true → ∀ i, i < n → p i = true
  | 0, _, _, hi => absurd hi (Nat.not_lt_zero _)
  | n + 1, h, i, hi => by
    simp only [allBelow13, Bool.and_eq_true] at h
    by_cases heq : i = n
    · subst heq; exact h.2
    · exact allBelow13_spec h.1 i (by omega)

theorem submask_bit {a b i : Nat} (h : (a &&& b == a) = true) (ha : a.testBit i = true) : b.testBit i = true := by
  have heq : a &&& b = a := beq_iff_eq.1 h
  rw [← heq, Nat.testBit_and, Bool.and_eq_true] at ha; exact ha.2

theorem disjoint_bit {a b i : Nat} (h : (a &&& b == 0) = true) (ha : a.testBit i = true) (hb : b.testBit i = true) : False := by
  have heq : a &&& b = 0 := beq_iff_eq.1 h
  have h1 : (a &&& b).testBit i = true := by rw [Nat.testBit_and, ha, hb]; rfl
  rw [heq] at h1; simp at h1

theorem min12_succ_le {k x y : Nat} (hk : k ≤ 12) (hx : k ≤ x) (hy : Nat.min 12 x + 1 ≤ y) : k + 1 ≤ y := by
  unfold Nat.min at hy; omega

def advOn0 : Nat := 7826378092596
def advOn1 : Nat := 62403844867969
def forbOn0 : Nat := 70506191519746
def forbOn1 : Nat := 1073875016

def seedMask (mr : Nat) (col1 : Bool) : Nat :=
  if mr == 7 then (if col1 then 0 else 1)
  else if mr == 8 then (if col1 then 4 else 0)
  else if mr == 13 then (if col1 then 277025652752 else 16781440)
  else 0

def reqInit (rm0 : Nat) (col1 : Bool) : Nat :=
  (if decide (7 ≤ rm0) then seedMask 7 col1 else 0) |||
  (if decide (8 ≤ rm0) then seedMask 8 col1 else 0) |||
  (if decide (13 ≤ rm0) then seedMask 13 col1 else 0)

structure W13Cert where
  pM : Nat
  pA : Nat
  pB : Nat
  nM : Nat
  nA : Nat
  nB : Nat

namespace W13Cert
variable (C : W13Cert)

def rM (s : Nat) : Nat := (C.pM >>> (4 * s)) &&& 15
def rA (s : Nat) : Nat := (C.pA >>> (4 * s)) &&& 15
def rB (s : Nat) : Nat := (C.pB >>> (4 * s)) &&& 15
def gM (s : Nat) : Nat := (C.nM >>> (47 * s)) &&& 140737488355327
def gA (s : Nat) : Nat := (C.nA >>> (47 * s)) &&& 140737488355327
def gB (s : Nat) : Nat := (C.nB >>> (47 * s)) &&& 140737488355327

def stepBtoM (vb w : Nat) : Bool :=
  if w % 2 == 1 then (vb &&& forbOn1 == 0) && (((vb &&& advOn1) <<< 1) &&& C.gM w == ((vb &&& advOn1) <<< 1))
  else (vb &&& forbOn0 == 0) && (((vb &&& advOn0) <<< 1) &&& C.gM w == ((vb &&& advOn0) <<< 1))

def mA_ok (s : Nat) : Bool :=
  let rm := Nat.min 12 (C.rM s) + 1
  decide (rm ≤ C.rA (fastStep13 false false s)) && decide (rm ≤ C.rA (fastStep13 false true s))

def AB_ok (s : Nat) : Bool :=
  let ra := C.rA s
  ra == 0 || (decide (ra ≤ C.rB (fastStep13 true false s)) && decide (ra ≤ C.rB (fastStep13 true true s)))

def BM_ok (s : Nat) : Bool :=
  let rb := C.rB s
  rb == 0 || (decide (rb ≤ C.rM (fastStep13 false false s)) && decide (rb ≤ C.rM (fastStep13 false true s)))

def nfaM_ok (s : Nat) : Bool :=
  let rm0 := C.rM s
  decide (rm0 < 7) || (let vm := C.gM s; let ri := reqInit rm0 (s % 2 == 1);
    (ri &&& vm == ri) &&
    (vm == 0 || ((vm &&& C.gA (fastStep13 false false s) == vm) && (vm &&& C.gA (fastStep13 false true s) == vm))))

def nfaA_ok (s : Nat) : Bool :=
  decide (C.rA s < 8) || (let va := C.gA s;
    va == 0 || ((va &&& C.gB (fastStep13 true false s) == va) && (va &&& C.gB (fastStep13 true true s) == va)))

def nfaB_ok (s : Nat) : Bool :=
  decide (C.rB s < 8) || (let vb := C.gB s;
    vb == 0 || (C.stepBtoM vb (fastStep13 false false s) && C.stepBtoM vb (fastStep13 false true s)))

def fullOK13 (s : Nat) : Bool :=
  C.mA_ok s && C.AB_ok s && C.BM_ok s && C.nfaM_ok s && C.nfaA_ok s && C.nfaB_ok s

theorem clauses {s : Nat} (hC : allBelow13 C.fullOK13 8192 = true) (hs : s < 8192) :
    C.mA_ok s = true ∧ C.AB_ok s = true ∧ C.BM_ok s = true ∧
    C.nfaM_ok s = true ∧ C.nfaA_ok s = true ∧ C.nfaB_ok s = true := by
  have h := allBelow13_spec hC s hs
  unfold fullOK13 at h; simp only [Bool.and_eq_true] at h
  exact ⟨h.1.1.1.1.1, h.1.1.1.1.2, h.1.1.1.2, h.1.1.2, h.1.2, h.2⟩

theorem cert_mA (hC : allBelow13 C.fullOK13 8192 = true) {s : Nat} (hs : s < 8192) (ext : Bool) :
    Nat.min 12 (C.rM s) + 1 ≤ C.rA (fastStep13 false ext s) := by
  have h := (C.clauses hC hs).1; unfold mA_ok at h
  simp only [Bool.and_eq_true, decide_eq_true_eq] at h
  cases ext; exact h.1; exact h.2

theorem cert_AB (hC : allBelow13 C.fullOK13 8192 = true) {s : Nat} (hs : s < 8192) (hra : C.rA s ≠ 0) (ext : Bool) :
    C.rA s ≤ C.rB (fastStep13 true ext s) := by
  have h := (C.clauses hC hs).2.1; unfold AB_ok at h
  rw [Bool.or_eq_true, beq_iff_eq] at h
  rcases h with h0 | h1
  · exact absurd h0 hra
  · simp only [Bool.and_eq_true, decide_eq_true_eq] at h1; cases ext; exact h1.1; exact h1.2

theorem cert_BM (hC : allBelow13 C.fullOK13 8192 = true) {s : Nat} (hs : s < 8192) (hrb : C.rB s ≠ 0) (ext : Bool) :
    C.rB s ≤ C.rM (fastStep13 false ext s) := by
  have h := (C.clauses hC hs).2.2.1; unfold BM_ok at h
  rw [Bool.or_eq_true, beq_iff_eq] at h
  rcases h with h0 | h1
  · exact absurd h0 hrb
  · simp only [Bool.and_eq_true, decide_eq_true_eq] at h1; cases ext; exact h1.1; exact h1.2

theorem rkM_phi1_le13 (hC : allBelow13 C.fullOK13 8192 = true) (x : Nat → Bool) :
    ∀ k, k ≤ 13 → k ≤ C.rM (win13 (half x 1 (3 * k)))
  | 0, _ => Nat.zero_le _
  | k + 1, hk => by
    have ih := rkM_phi1_le13 hC x k (by omega)
    have w0 : wordAt3 w001 (3 * k + 1) = false := by unfold wordAt3; rw [show (3 * k + 1) % 3 = 1 by omega]; rfl
    have w1 : wordAt3 w001 (3 * k + 1 + 1) = true := by unfold wordAt3; rw [show (3 * k + 2) % 3 = 2 by omega]; rfl
    have w2 : wordAt3 w001 (3 * k + 2 + 1) = false := by unfold wordAt3; rw [show (3 * k + 3) % 3 = 0 by omega]; rfl
    have s1_eq := win13_step x 1 (3 * k); rw [w0] at s1_eq
    have s2_eq := win13_step x 1 (3 * k + 1); rw [w1] at s2_eq
    have s3_eq := win13_step x 1 (3 * k + 2); rw [w2, show 3 * k + 2 + 1 = 3 * (k + 1) by omega] at s3_eq
    have hA : k + 1 ≤ C.rA (win13 (half x 1 (3 * k + 1))) := by
      rw [s1_eq]; exact min12_succ_le (by omega) ih (C.cert_mA hC (win13_lt _) _)
    have hB : k + 1 ≤ C.rB (win13 (half x 1 (3 * k + 2))) := by
      rw [s2_eq]; have hb := C.cert_AB hC (win13_lt (half x 1 (3 * k + 1))) (by omega) (half x 1 (3 * k + 1) 14); omega
    rw [s3_eq]; have hm2 := C.cert_BM hC (win13_lt (half x 1 (3 * k + 2))) (by omega) (half x 1 (3 * k + 2) 14); omega

theorem rkM_at_gate (hC : allBelow13 C.fullOK13 8192 = true) (x : Nat → Bool) (φ t1 k mr : Nat)
    (hph : (t1 + φ) % 3 = 1) (hmr : mr ≤ 13) (hk : mr ≤ k) :
    mr ≤ C.rM (win13 (half x φ (t1 + 3 * k))) := by
  have ht : t1 + 3 * k = (t1 + 3 * (k - mr)) + 3 * mr := by omega
  have hph0 : (t1 + 3 * (k - mr) + φ) % 3 = 1 := by omega
  rw [ht]
  have hr : half x φ ((t1 + 3 * (k - mr)) + 3 * mr) = half (half x φ (t1 + 3 * (k - mr))) 1 (3 * mr) := by
    funext p; rw [half_restart, hph0]
  rw [hr]; exact C.rkM_phi1_le13 hC _ mr hmr

theorem cert_nfa_seed (hC : allBelow13 C.fullOK13 8192 = true) {s i : Nat} (hs : s < 8192) (hrm : 7 ≤ C.rM s)
    (hi : (reqInit (C.rM s) (s % 2 == 1)).testBit i = true) :
    (C.gM s).testBit i = true := by
  have h := (C.clauses hC hs).2.2.2.1; unfold nfaM_ok at h
  rw [Bool.or_eq_true, decide_eq_true_eq] at h
  rcases h with hlt | hok
  · omega
  · simp only [Bool.and_eq_true] at hok; exact submask_bit hok.1 hi

theorem cert_nfa_step3 (hC : allBelow13 C.fullOK13 8192 = true) {x : Nat → Bool} {φ t i : Nat}
    (hph : (t + φ) % 3 = 1) (hrm : 7 ≤ C.rM (win13 (half x φ t)))
    (hbit : (C.gM (win13 (half x φ t))).testBit i = true) :
    7 ≤ C.rM (win13 (half x φ (t + 3))) ∧
    ((if half x φ (t + 3) 1 then forbOn1 else forbOn0).testBit i = false) ∧
    ((if half x φ (t + 3) 1 then advOn1 else advOn0).testBit i = true →
      (C.gM (win13 (half x φ (t + 3)))).testBit (i + 1) = true) := by
  have w0 : wordAt3 w001 (t + φ) = false := by unfold wordAt3; rw [hph]; rfl
  have w1 : wordAt3 w001 (t + 1 + φ) = true := by unfold wordAt3; rw [show (t + 1 + φ) % 3 = 2 by omega]; rfl
  have w2 : wordAt3 w001 (t + 2 + φ) = false := by unfold wordAt3; rw [show (t + 2 + φ) % 3 = 0 by omega]; rfl
  have eq1 : win13 (half x φ (t + 1)) = fastStep13 false (half x φ t 14) (win13 (half x φ t)) := by
    have e := win13_step x φ t; rw [w0] at e; exact e
  have eq2 : win13 (half x φ (t + 2)) = fastStep13 true (half x φ (t + 1) 14) (win13 (half x φ (t + 1))) := by
    have e := win13_step x φ (t + 1); rw [w1, show t + 1 + 1 = t + 2 by omega] at e; exact e
  have eq3 : win13 (half x φ (t + 3)) = fastStep13 false (half x φ (t + 2) 14) (win13 (half x φ (t + 2))) := by
    have e := win13_step x φ (t + 2); rw [w2, show t + 2 + 1 = t + 3 by omega] at e; exact e
  have hra : 8 ≤ C.rA (win13 (half x φ (t + 1))) := by
    rw [eq1]; exact min12_succ_le (by omega) hrm (C.cert_mA hC (win13_lt _) _)
  have hrb : 8 ≤ C.rB (win13 (half x φ (t + 2))) := by
    rw [eq2]; have hb := C.cert_AB hC (win13_lt (half x φ (t + 1))) (by omega) (half x φ (t + 1) 14); omega
  have hrm3 : 8 ≤ C.rM (win13 (half x φ (t + 3))) := by
    rw [eq3]; have hm2 := C.cert_BM hC (win13_lt (half x φ (t + 2))) (by omega) (half x φ (t + 2) 14); omega
  have hA_bit : (C.gA (win13 (half x φ (t + 1)))).testBit i = true := by
    have h := (C.clauses hC (win13_lt (half x φ t))).2.2.2.1; unfold nfaM_ok at h
    rw [Bool.or_eq_true, decide_eq_true_eq] at h
    rcases h with hlt | hok; · omega
    simp only [Bool.and_eq_true] at hok
    have hok2 := hok.2; rw [Bool.or_eq_true, beq_iff_eq] at hok2
    rcases hok2 with hz | hsub; · rw [hz] at hbit; simp at hbit
    simp only [Bool.and_eq_true] at hsub
    rw [eq1]; cases (half x φ t 14); exact submask_bit hsub.1 hbit; exact submask_bit hsub.2 hbit
  have hB_bit : (C.gB (win13 (half x φ (t + 2)))).testBit i = true := by
    have h := (C.clauses hC (win13_lt (half x φ (t + 1)))).2.2.2.2.1; unfold nfaA_ok at h
    rw [Bool.or_eq_true, decide_eq_true_eq] at h
    rcases h with hlt | hok; · omega
    rw [Bool.or_eq_true, beq_iff_eq] at hok
    rcases hok with hz | hsub; · rw [hz] at hA_bit; simp at hA_bit
    simp only [Bool.and_eq_true] at hsub
    rw [eq2]; cases (half x φ (t + 1) 14); exact submask_bit hsub.1 hA_bit; exact submask_bit hsub.2 hA_bit
  have hBM : C.stepBtoM (C.gB (win13 (half x φ (t + 2)))) (win13 (half x φ (t + 3))) = true := by
    have h := (C.clauses hC (win13_lt (half x φ (t + 2)))).2.2.2.2.2; unfold nfaB_ok at h
    rw [Bool.or_eq_true, decide_eq_true_eq] at h
    rcases h with hlt | hok; · omega
    rw [Bool.or_eq_true, beq_iff_eq] at hok
    rcases hok with hz | hsub; · rw [hz] at hB_bit; simp at hB_bit
    simp only [Bool.and_eq_true] at hsub
    rw [eq3]; cases (half x φ (t + 2) 14); exact hsub.1; exact hsub.2
  have hcol : (win13 (half x φ (t + 3)) % 2 == 1) = half x φ (t + 3) 1 := win13_col1 _
  unfold stepBtoM at hBM; rw [hcol] at hBM
  refine ⟨by omega, ?_, ?_⟩
  · cases hb : half x φ (t + 3) 1 <;> simp only [hb, Bool.false_eq_true, ↓reduceIte, Bool.and_eq_true] at hBM ⊢
    · by_cases hf : forbOn0.testBit i = true
      · exfalso; exact disjoint_bit hBM.1 hB_bit hf
      · exact Bool.eq_false_iff.2 hf
    · by_cases hf : forbOn1.testBit i = true
      · exfalso; exact disjoint_bit hBM.1 hB_bit hf
      · exact Bool.eq_false_iff.2 hf
  · intro hadv
    cases hb : half x φ (t + 3) 1 <;> simp only [hb, Bool.false_eq_true, ↓reduceIte, Bool.and_eq_true] at hBM hadv
    · have hsh : (((C.gB (win13 (half x φ (t + 2))) &&& advOn0) <<< 1)).testBit (i + 1) = true := by
        rw [Nat.testBit_shiftLeft, show i + 1 - 1 = i by omega, Nat.testBit_and, hB_bit, hadv]
        simp only [Bool.and_self, Bool.and_true, decide_eq_true_eq]; omega
      exact submask_bit hBM.2 hsh
    · have hsh : (((C.gB (win13 (half x φ (t + 2))) &&& advOn1) <<< 1)).testBit (i + 1) = true := by
        rw [Nat.testBit_shiftLeft, show i + 1 - 1 = i by omega, Nat.testBit_and, hB_bit, hadv]
        simp only [Bool.and_self, Bool.and_true, decide_eq_true_eq]; omega
      exact submask_bit hBM.2 hsh

end W13Cert

def tailSpecOK : Nat → List Bool → Bool → Bool
  | idx, [], lastB => (if lastB then forbOn1 else forbOn0).testBit idx
  | idx, b :: bs, lastB =>
    (if b then advOn1 else advOn0).testBit idx && tailSpecOK (idx + 1) bs lastB

def wordSpecOK (mr base : Nat) (pref : List Bool) (lastB : Bool) : Bool :=
  match pref with
  | [] => false
  | b0 :: bs =>
    (mr == 7 || mr == 8 || mr == 13) && decide (mr ≤ 13) &&
    (seedMask mr b0).testBit base && tailSpecOK base bs lastB

theorem W13Cert.run_tailSpec (C : W13Cert) (hC : allBelow13 C.fullOK13 8192 = true) {x : Nat → Bool} {φ : Nat} :
    ∀ (bs : List Bool) (lastB : Bool) (idx t : Nat),
      tailSpecOK idx bs lastB = true →
      (t + φ) % 3 = 1 →
      7 ≤ C.rM (win13 (half x φ t)) →
      (C.gM (win13 (half x φ t))).testBit idx = true →
      (∀ j, j < bs.length → half x φ (t + 3 * (j + 1)) 1 = bs.getD j false) →
      half x φ (t + 3 * (bs.length + 1)) 1 ≠ lastB
  | [], lastB, idx, t, hsp, hph, hrm, hbit, _, hlast => by
    simp only [tailSpecOK] at hsp
    have ⟨_, hno, _⟩ := C.cert_nfa_step3 hC hph hrm hbit
    simp only [List.length_nil, Nat.zero_add, Nat.mul_one] at hlast
    rw [hlast] at hno; rw [hsp] at hno; nomatch hno
  | b :: bs, lastB, idx, t, hsp, hph, hrm, hbit, hmid, hlast => by
    simp only [tailSpecOK, Bool.and_eq_true] at hsp
    have ⟨hrm', _, hadv⟩ := C.cert_nfa_step3 hC hph hrm hbit
    have hb0 : half x φ (t + 3) 1 = b := by simpa using hmid 0 (by simp)
    rw [hb0] at hadv
    refine C.run_tailSpec hC bs lastB (idx + 1) (t + 3) hsp.2 (by omega) hrm' (hadv hsp.1) ?_ ?_
    · intro j hj; have e := hmid (j + 1) (by simp; omega)
      rw [show t + 3 + 3 * (j + 1) = t + 3 * (j + 1 + 1) by omega]; simpa using e
    · simp only [List.length_cons] at hlast
      rw [show t + 3 + 3 * (bs.length + 1) = t + 3 * (bs.length + 1 + 1) by omega]; exact hlast

theorem W13Cert.avoids_by_wordSpec (C : W13Cert) (hC : allBelow13 C.fullOK13 8192 = true)
    {mr base : Nat} {pref : List Bool} {lastB : Bool}
    (hsp : wordSpecOK mr base pref lastB = true)
    (x : Nat → Bool) (φ t1 k : Nat) (hph : (t1 + φ) % 3 = 1) (hk : mr ≤ k) :
    ¬ ∀ i, i < (pref ++ [lastB]).length → half x φ (t1 + 3 * (k + i)) 1 = (pref ++ [lastB]).getD i false := by
  cases pref with
  | nil => simp [wordSpecOK] at hsp
  | cons b0 bs =>
    simp only [wordSpecOK, Bool.and_eq_true, decide_eq_true_eq] at hsp
    obtain ⟨⟨⟨hmr_or, hmr13⟩, hseed⟩, htail⟩ := hsp
    intro hp
    have ht_ph : (t1 + 3 * k + φ) % 3 = 1 := by omega
    have hrm0 : mr ≤ C.rM (win13 (half x φ (t1 + 3 * k))) := C.rkM_at_gate hC x φ t1 k mr hph hmr13 hk
    have hmr_ge7 : 7 ≤ mr := by
      simp only [Bool.or_eq_true, beq_iff_eq] at hmr_or; rcases hmr_or with (rfl | rfl) | rfl <;> omega
    have hb0 : half x φ (t1 + 3 * k) 1 = b0 := by simpa using hp 0 (by simp)
    have hri : (reqInit (C.rM (win13 (half x φ (t1 + 3 * k)))) (win13 (half x φ (t1 + 3 * k)) % 2 == 1)).testBit base = true := by
      rw [win13_col1, hb0]; unfold reqInit
      simp only [Nat.testBit_or, Bool.or_eq_true, beq_iff_eq] at hmr_or ⊢
      rcases hmr_or with (rfl | rfl) | rfl
      · left; left; rw [ite_eq_left (by simp; omega)]; exact hseed
      · left; right; rw [ite_eq_left (by simp; omega)]; exact hseed
      · right; rw [ite_eq_left (by simp; omega)]; exact hseed
    have hbit0 := C.cert_nfa_seed hC (win13_lt _) (by omega) hri
    refine C.run_tailSpec hC bs lastB base (t1 + 3 * k) htail ht_ph (by omega) hbit0 ?_ ?_
    · intro j hj
      have e := hp (j + 1) (by simp [List.length_append]; omega)
      rw [List.cons_append, List.getD_cons_succ, list_getD_append_left lastB bs j hj] at e
      rw [show t1 + 3 * k + 3 * (j + 1) = t1 + 3 * (k + (j + 1)) by omega]; exact e
    · have e := hp (bs.length + 1) (by simp [List.length_append])
      rw [List.cons_append, List.getD_cons_succ, list_getD_append_last lastB bs] at e
      rw [show t1 + 3 * k + 3 * (bs.length + 1) = t1 + 3 * (k + (bs.length + 1)) by omega]; exact e

/-! ### 2. Concrete Width-13 Certificate Instantiation & Forbidden Gate Language -/

def w13Cert : W13Cert :=
  { pM := ,
    pA := ,
    pB := ,
    nM := ,
    nA := ,
    nB :=  }

theorem w13Cert_ok : allBelow13 w13Cert.fullOK13 8192 = true := by decide +kernel

def gateForbidden14 : List (List Bool) :=
  [
   [false, true, false],
   [true, false, true],
   [true, false, false, true],
   [false, true, true, true, true, true],
   [false, false, false, false, true, true, true],
   [true, false, false, false, false, false, false],
   [false, true, true, true, false, false, false, true],
   [true, true, true, false, false, false, false, false],
   [true, true, true, false, false, false, true, true, true, false]]

theorem wspec_0 : wordSpecOK 7 0 [false, true] false = true := by decide +kernel
theorem wspec_1 : wordSpecOK 8 2 [true, false] true = true := by decide +kernel
theorem wspec_2 : wordSpecOK 13 4 [true, false, false] true = true := by decide +kernel
theorem wspec_3 : wordSpecOK 13 7 [false, true, true, true, true] true = true := by decide +kernel
theorem wspec_4 : wordSpecOK 13 12 [false, false, false, false, true, true] true = true := by decide +kernel
theorem wspec_5 : wordSpecOK 13 18 [true, false, false, false, false, false] false = true := by decide +kernel
theorem wspec_6 : wordSpecOK 13 24 [false, true, true, true, false, false, false] true = true := by decide +kernel
theorem wspec_7 : wordSpecOK 13 31 [true, true, true, false, false, false, false] false = true := by decide +kernel
theorem wspec_8 : wordSpecOK 13 38 [true, true, true, false, false, false, true, true, true] false = true := by decide +kernel

theorem gate_avoids_010_from_7 (x : Nat → Bool) (φ t1 k : Nat) (hph : (t1 + φ) % 3 = 1) (hk : 7 ≤ k) :
    ¬ ∀ i, i < 3 → half x φ (t1 + 3 * (k + i)) 1 = [false, true, false].getD i false :=
  w13Cert.avoids_by_wordSpec w13Cert_ok wspec_0 x φ t1 k hph hk

theorem gate_avoids_101_from_8 (x : Nat → Bool) (φ t1 k : Nat) (hph : (t1 + φ) % 3 = 1) (hk : 8 ≤ k) :
    ¬ ∀ i, i < 3 → half x φ (t1 + 3 * (k + i)) 1 = [true, false, true].getD i false :=
  w13Cert.avoids_by_wordSpec w13Cert_ok wspec_1 x φ t1 k hph hk

theorem gate_avoids_from_13 (x : Nat → Bool) (φ t1 k : Nat)
    (hph : (t1 + φ) % 3 = 1) (hk : 13 ≤ k) {pat : List Bool} (hpat : pat ∈ gateForbidden14) :
    ¬ ∀ i, i < pat.length → half x φ (t1 + 3 * (k + i)) 1 = pat.getD i false := by
  simp only [gateForbidden14, List.mem_cons, List.not_mem_nil, or_false] at hpat
  rcases hpat with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl
  · exact w13Cert.avoids_by_wordSpec w13Cert_ok wspec_0 x φ t1 k hph (by omega)
  · exact w13Cert.avoids_by_wordSpec w13Cert_ok wspec_1 x φ t1 k hph (by omega)
  · exact w13Cert.avoids_by_wordSpec w13Cert_ok wspec_2 x φ t1 k hph hk
  · exact w13Cert.avoids_by_wordSpec w13Cert_ok wspec_3 x φ t1 k hph hk
  · exact w13Cert.avoids_by_wordSpec w13Cert_ok wspec_4 x φ t1 k hph hk
  · exact w13Cert.avoids_by_wordSpec w13Cert_ok wspec_5 x φ t1 k hph hk
  · exact w13Cert.avoids_by_wordSpec w13Cert_ok wspec_6 x φ t1 k hph hk
  · exact w13Cert.avoids_by_wordSpec w13Cert_ok wspec_7 x φ t1 k hph hk
  · exact w13Cert.avoids_by_wordSpec w13Cert_ok wspec_8 x φ t1 k hph hk

theorem threeRuns_from_13 (x : Nat → Bool) (φ t1 k : Nat) (hph : (t1 + φ) % 3 = 1) (hk : 13 ≤ k) :
    (¬ ∀ i, i < 3 → half x φ (t1 + 3 * (k + i)) 1 = [false, true, false].getD i false) ∧
    (¬ ∀ i, i < 3 → half x φ (t1 + 3 * (k + i)) 1 = [true, false, true].getD i false) ∧
    (¬ ∀ i, i < 4 → half x φ (t1 + 3 * (k + i)) 1 = [true, false, false, true].getD i false) :=
  ⟨gate_avoids_010_from_7 x φ t1 k hph (by omega),
   gate_avoids_101_from_8 x φ t1 k hph (by omega),
   w13Cert.avoids_by_wordSpec w13Cert_ok wspec_2 x φ t1 k hph hk⟩

/-! ### 3. Constructive Finite-Support Sharpness Witnesses -/

def seedHalf (s p : Nat) : Bool :=
  if p = 0 then false else (decBits 56 s).getD (p - 1) false

theorem seedHalf_fin (s p : Nat) (hp : 56 < p) : seedHalf s p = false := by
  unfold seedHalf
  rw [ite_eq_right (by omega)]
  exact list_getD_ge (decBits 56 s) (p - 1) false (by rw [decBits_length]; omega)

theorem half_seedHalf_zero_right (s φ : Nat) :
    ∀ t p, 56 + t < p → half (seedHalf s) φ t p = false
  | 0, p, hp => by
    unfold half; rw [drv_init _ _ p (by omega)]; exact seedHalf_fin s p (by omega)
  | t + 1, p, hp => by
    obtain ⟨q, rfl⟩ : ∃ q, p = q + 1 := ⟨p - 1, by omega⟩
    have hstep := drv_isR30 (fun u => wordAt3 w001 (u + φ)) (seedHalf s) t q
    change drv _ _ (t + 1) (q + 1) = false
    rw [hstep]
    have z1 := half_seedHalf_zero_right s φ t q (by omega)
    have z2 := half_seedHalf_zero_right s φ t (q + 1) (by omega)
    have z3 := half_seedHalf_zero_right s φ t (q + 2) (by omega)
    unfold half at z1 z2 z3; rw [z1, z2, z3]; rfl

def simCone112 (s φ : Nat) : Nat → List Bool
  | 0 => rowW 112 (seedHalf s) 1
  | t + 1 => linStep (wordAt3 w001 (t + φ)) (simCone112 s φ t) false

theorem simCone112_eq_rowW (s φ : Nat) :
    ∀ t, t ≤ 55 → simCone112 s φ t = rowW 112 (half (seedHalf s) φ t) 1
  | 0, _ => by
    unfold simCone112
    have h0 : ∀ k p, 1 ≤ p → rowW k (seedHalf s) p = rowW k (half (seedHalf s) φ 0) p := by
      intro k; induction k with
      | zero => intros; rfl
      | succ k ih =>
        intro p hp; simp only [rowW]; unfold half
        rw [drv_init _ _ p hp, ih (p + 1) (by omega)]; rfl
    exact h0 112 1 (by omega)
  | t + 1, ht => by
    simp only [simCone112]
    have hr := rowW_isR30_step (drv_isR30 (fun u => wordAt3 w001 (u + φ)) (seedHalf s)) t 112 0
    have hc0 : drv (fun u => wordAt3 w001 (u + φ)) (seedHalf s) t 0 = wordAt3 w001 (t + φ) := drv_col0 _ _ t
    have hzr : drv (fun u => wordAt3 w001 (u + φ)) (seedHalf s) t (1 + 112) = false :=
      half_seedHalf_zero_right s φ t 113 (by omega)
    simp only [Nat.zero_add] at hr
    rw [simCone112_eq_rowW s φ t (by omega)]; unfold half; rw [hr, hc0, hzr]

theorem simGate_eq (s φ t : Nat) (ht : t ≤ 55) :
    half (seedHalf s) φ t 1 = (simCone112 s φ t).headD false := by
  rw [simCone112_eq_rowW s φ t ht]; rfl

def checkSeedPat (s φ t1 k : Nat) (pat : List Bool) : Bool :=
  (List.range pat.length).all fun i =>
    (simCone112 s φ (t1 + 3 * (k + i))).headD false == pat.getD i false

theorem sharp_checks :
    checkSeedPat 28019895720264040 1 0 6 [false, true, false] = true ∧
    checkSeedPat 28019895720264040 1 0 7 [true, false, true] = true ∧
    checkSeedPat 37798575422366226 1 0 12 [true, false, false, true] = true ∧
    checkSeedPat 42377824023171520 0 1 11 [true, false, false, true] = true ∧
    checkSeedPat 25371749320308543 2 2 11 [true, false, false, true] = true := by
  decide +kernel

theorem sharp_threeRuns_witnesses :
    (∃ x, (∀ p, 56 < p → x p = false) ∧
      (∀ i, i < 3 → half x 1 (0 + 3 * (6 + i)) 1 = [false, true, false].getD i false) ∧
      (∀ i, i < 3 → half x 1 (0 + 3 * (7 + i)) 1 = [true, false, true].getD i false)) ∧
    (∃ x, (∀ p, 56 < p → x p = false) ∧
      ∀ i, i < 4 → half x 1 (0 + 3 * (12 + i)) 1 = [true, false, false, true].getD i false) ∧
    (∃ x, (∀ p, 56 < p → x p = false) ∧
      ∀ i, i < 4 → half x 0 (1 + 3 * (11 + i)) 1 = [true, false, false, true].getD i false) ∧
    (∃ x, (∀ p, 56 < p → x p = false) ∧
      ∀ i, i < 4 → half x 2 (2 + 3 * (11 + i)) 1 = [true, false, false, true].getD i false) := by
  obtain ⟨c1, c2, c3, c4, c5⟩ := sharp_checks
  refine ⟨⟨seedHalf 28019895720264040, seedHalf_fin _, ?_, ?_⟩,
          ⟨seedHalf 37798575422366226, seedHalf_fin _, ?_⟩,
          ⟨seedHalf 42377824023171520, seedHalf_fin _, ?_⟩,
          ⟨seedHalf 25371749320308543, seedHalf_fin _, ?_⟩⟩
  · intro i hi; rw [simGate_eq _ _ _ (by omega)]
    exact beq_iff_eq.1 (List.all_eq_true.1 c1 i (List.mem_range.2 hi))
  · intro i hi; rw [simGate_eq _ _ _ (by omega)]
    exact beq_iff_eq.1 (List.all_eq_true.1 c2 i (List.mem_range.2 hi))
  · intro i hi; rw [simGate_eq _ _ _ (by omega)]
    exact beq_iff_eq.1 (List.all_eq_true.1 c3 i (List.mem_range.2 hi))
  · intro i hi; rw [simGate_eq _ _ _ (by omega)]
    exact beq_iff_eq.1 (List.all_eq_true.1 c4 i (List.mem_range.2 hi))
  · intro i hi; rw [simGate_eq _ _ _ (by omega)]
    exact beq_iff_eq.1 (List.all_eq_true.1 c5 i (List.mem_range.2 hi))

/-! ### 4. Eternal Bounded Oscillation & Periodic Gate Classification -/

theorem gate_next_black_within_six (x : Nat → Bool) (φ t1 k : Nat)
    (hph : (t1 + φ) % 3 = 1) (hk : 13 ≤ k) (hb : half x φ (t1 + 3 * k) 1 = true) :
    ∃ d, 1 ≤ d ∧ d ≤ 6 ∧ half x φ (t1 + 3 * (k + d)) 1 = true := by
  apply Classical.byContradiction
  intro hall
  refine gate_avoids_from_13 x φ t1 k hph hk
    (pat := [true, false, false, false, false, false, false]) (by simp [gateForbidden14]) ?_
  intro i hi; simp only [List.length_cons, List.length_nil] at hi
  rcases (by omega : i = 0 ∨ i = 1 ∨ i = 2 ∨ i = 3 ∨ i = 4 ∨ i = 5 ∨ i = 6) with
    rfl | rfl | rfl | rfl | rfl | rfl | rfl
  · rw [Nat.add_zero]; exact hb
  all_goals
    cases h : half x φ (t1 + 3 * (k + _)) 1
    · rfl
    · exfalso; exact hall ⟨_, by omega, by omega, h⟩

theorem gate_next_white_within_five (x : Nat → Bool) (φ t1 k : Nat)
    (hph : (t1 + φ) % 3 = 1) (hk : 13 ≤ k) (hw : half x φ (t1 + 3 * k) 1 = false) :
    ∃ d, 1 ≤ d ∧ d ≤ 5 ∧ half x φ (t1 + 3 * (k + d)) 1 = false := by
  apply Classical.byContradiction
  intro hall
  refine gate_avoids_from_13 x φ t1 k hph hk
    (pat := [false, true, true, true, true, true]) (by simp [gateForbidden14]) ?_
  intro i hi; simp only [List.length_cons, List.length_nil] at hi
  rcases (by omega : i = 0 ∨ i = 1 ∨ i = 2 ∨ i = 3 ∨ i = 4 ∨ i = 5) with
    rfl | rfl | rfl | rfl | rfl | rfl
  · rw [Nat.add_zero]; exact hw
  all_goals
    cases h : half x φ (t1 + 3 * (k + _)) 1
    · exfalso; exact hall ⟨_, by omega, by omega, h⟩
    · rfl

theorem gate_osc_aux (x : Nat → Bool) (φ t1 k0 : Nat)
    (hph : (t1 + φ) % 3 = 1) (hk0 : 13 ≤ k0)
    (h1 : half x φ (t1 + 3 * k0) 1 = true) (h0 : half x φ (t1 + 3 * (k0 + 1)) 1 = false) :
    ∀ n, (∃ k, k0 + n ≤ k ∧ half x φ (t1 + 3 * k) 1 = true) ∧
         (∃ k, k0 + n ≤ k ∧ half x φ (t1 + 3 * k) 1 = false)
  | 0 => ⟨⟨k0, by omega, h1⟩, ⟨k0 + 1, by omega, h0⟩⟩
  | n + 1 => by
    obtain ⟨⟨kb, hkb, hb⟩, ⟨kw, hkw, hw⟩⟩ := gate_osc_aux x φ t1 k0 hph hk0 h1 h0 n
    refine ⟨?_, ?_⟩
    · by_cases hlt : k0 + (n + 1) ≤ kb
      · exact ⟨kb, hlt, hb⟩
      · have heq : kb = k0 + n := by omega
        obtain ⟨d, hd1, _, hbd⟩ := gate_next_black_within_six x φ t1 kb hph (by omega) hb
        exact ⟨kb + d, by omega, hbd⟩
    · by_cases hlt : k0 + (n + 1) ≤ kw
      · exact ⟨kw, hlt, hw⟩
      · have heq : kw = k0 + n := by omega
        obtain ⟨d, hd1, _, hwd⟩ := gate_next_white_within_five x φ t1 kw hph (by omega) hw
        exact ⟨kw + d, by omega, hwd⟩

theorem gate_oscillates_after_10 (x : Nat → Bool) (φ t1 k0 : Nat)
    (hph : (t1 + φ) % 3 = 1) (hk0 : 13 ≤ k0)
    (h1 : half x φ (t1 + 3 * k0) 1 = true) (h0 : half x φ (t1 + 3 * (k0 + 1)) 1 = false) :
    ∀ K, k0 ≤ K → (∃ k, K ≤ k ∧ half x φ (t1 + 3 * k) 1 = true) ∧
                  (∃ k, K ≤ k ∧ half x φ (t1 + 3 * k) 1 = false) := by
  intro K hK
  have h := gate_osc_aux x φ t1 k0 hph hk0 h1 h0 (K - k0)
  rw [show k0 + (K - k0) = K by omega] at h; exact h

def perWordValid (p m : Nat) : Bool :=
  let w := decBits p m
  (List.range p).all fun start =>
    gateForbidden14.all fun pat =>
      !(List.range pat.length).all fun i =>
        w.getD ((start + i) % p) false == pat.getD i false

theorem rowW_getD_gate (f : Nat → Bool) : ∀ len off idx, idx < len →
    (rowW len f off).getD idx false = f (off + idx)
  | 0, _, _, hi => by omega
  | len + 1, off, 0, _ => by simp [rowW]
  | len + 1, off, idx + 1, hi => by
    simp only [rowW, List.getD_cons_succ]
    rw [rowW_getD_gate f len (off + 1) idx (by omega), show off + 1 + idx = off + (idx + 1) by omega]

theorem perWordValid_of_periodic_gate {x : Nat → Bool} {φ t1 K p : Nat}
    (hp : 0 < p) (hph : (t1 + φ) % 3 = 1) (hK : 13 ≤ K)
    (hper : ∀ k, K ≤ k → half x φ (t1 + 3 * (k + p)) 1 = half x φ (t1 + 3 * k) 1) :
    perWordValid p (encBits (rowW p (fun j => half x φ (t1 + 3 * (K + j)) 1) 0)) = true := by
  have hper_mul : ∀ j q, half x φ (t1 + 3 * (K + (j + p * q))) 1 = half x φ (t1 + 3 * (K + j)) 1 := by
    intro j q; induction q with
    | zero => simp
    | succ q ih =>
      rw [Nat.mul_succ p q, show K + (j + (p * q + p)) = (K + (j + p * q)) + p by omega,
          hper _ (by omega), ih]
  have hd : decBits p (encBits (rowW p (fun j => half x φ (t1 + 3 * (K + j)) 1) 0)) =
      rowW p (fun j => half x φ (t1 + 3 * (K + j)) 1) 0 :=
    decBits_encBits_of_len (rowW_length p _ 0)
  have hget : ∀ u, (decBits p (encBits (rowW p (fun j => half x φ (t1 + 3 * (K + j)) 1) 0))).getD
      (u % p) false = half x φ (t1 + 3 * (K + u)) 1 := by
    intro u; rw [hd, rowW_getD_gate _ p 0 (u % p) (Nat.mod_lt u hp), Nat.zero_add]
    have hdiv : u = u % p + p * (u / p) := (Nat.mod_add_div u p).symm
    conv => rhs; rw [hdiv]
    exact (hper_mul (u % p) (u / p)).symm
  unfold perWordValid
  rw [List.all_eq_true]; intro start _
  rw [List.all_eq_true]; intro pat hpat
  rw [Bool.not_eq_true']
  by_cases hall : (List.range pat.length).all (fun i =>
      (decBits p (encBits (rowW p (fun j => half x φ (t1 + 3 * (K + j)) 1) 0))).getD
        ((start + i) % p) false == pat.getD i false) = true
  · exfalso
    refine gate_avoids_from_13 x φ t1 (K + start) hph (by omega) hpat ?_
    intro i hi
    have he := beq_iff_eq.1 (List.all_eq_true.1 hall i (List.mem_range.2 hi))
    rw [hget (start + i), show K + (start + i) = K + start + i by omega] at he; exact he
  · exact Bool.eq_false_iff.2 hall

def isConstWord (p m : Nat) : Bool :=
  let w := decBits p m
  (List.range p).all fun j => w.getD j false == w.getD 0 false

def checkExcludedPer (p : Nat) : Bool :=
  (List.range (2 ^ p)).all fun m => !perWordValid p m || isConstWord p m

theorem check_excluded_periods :
    checkExcludedPer 2 = true ∧ checkExcludedPer 3 = true ∧ checkExcludedPer 4 = true ∧
    checkExcludedPer 8 = true ∧ checkExcludedPer 9 = true := by
  decide +kernel

theorem check_period_10_reduces_5 :
    ((List.range 1024).all fun m => !perWordValid 10 m ||
      (List.range 10).all fun j =>
        (decBits 10 m).getD ((j + 5) % 10) false == (decBits 10 m).getD j false) = true := by
  decide +kernel

theorem check_period_5_gate5 :
    ((List.range 32).all fun m => !perWordValid 5 m || isConstWord 5 m ||
      (List.range 5).any fun r => (List.range 5).all fun j =>
        (decBits 5 m).getD j false == gate5 (j + r)) = true := by
  decide +kernel

def gate7Four (k : Nat) : Bool := decide (k % 7 < 4)

theorem check_period_7_dichotomy :
    ((List.range 128).all fun m => !perWordValid 7 m || isConstWord 7 m ||
      (List.range 7).any fun r =>
        ((List.range 7).all fun j => (decBits 7 m).getD j false == gate7 (j + r)) ||
        ((List.range 7).all fun j => (decBits 7 m).getD j false == gate7Four (j + r))) = true := by
  decide +kernel

theorem periodic_gate_const_of_excluded {x : Nat → Bool} {φ t1 K p : Nat}
    (hp_mem : p = 2 ∨ p = 3 ∨ p = 4 ∨ p = 8 ∨ p = 9)
    (hph : (t1 + φ) % 3 = 1) (hK : 13 ≤ K)
    (hper : ∀ k, K ≤ k → half x φ (t1 + 3 * (k + p)) 1 = half x φ (t1 + 3 * k) 1) :
    ∀ k, K ≤ k → half x φ (t1 + 3 * k) 1 = half x φ (t1 + 3 * K) 1 := by
  have hp : 0 < p := by rcases hp_mem with rfl | rfl | rfl | rfl | rfl <;> decide
  let g : Nat → Bool := fun j => half x φ (t1 + 3 * (K + j)) 1
  let m : Nat := encBits (rowW p g 0)
  have hm_lt : m < 2 ^ p := by have h := encBits_lt (rowW p g 0); rw [rowW_length] at h; exact h
  have hv : perWordValid p m = true := perWordValid_of_periodic_gate hp hph hK hper
  have hc_chk : checkExcludedPer p = true := by
    rcases hp_mem with rfl | rfl | rfl | rfl | rfl
    · exact check_excluded_periods.1
    · exact check_excluded_periods.2.1
    · exact check_excluded_periods.2.2.1
    · exact check_excluded_periods.2.2.2.1
    · exact check_excluded_periods.2.2.2.2
  have hcw : isConstWord p m = true := by
    have h1 := List.all_eq_true.1 hc_chk m (List.mem_range.2 hm_lt)
    rw [hv] at h1; simp only [Bool.not_true, Bool.false_or] at h1; exact h1
  have hd : decBits p m = rowW p g 0 := decBits_encBits_of_len (rowW_length p g 0)
  have hper_mul : ∀ j q, g (j + p * q) = g j := by
    intro j q; induction q with
    | zero => simp
    | succ q ih =>
      show half x φ (t1 + 3 * (K + (j + p * (q + 1)))) 1 = g j
      rw [Nat.mul_succ p q, show K + (j + (p * q + p)) = (K + (j + p * q)) + p by omega,
          hper _ (by omega)]; exact ih
  intro k hk
  have hk_eq : half x φ (t1 + 3 * k) 1 = g (k - K) := by
    show half x φ (t1 + 3 * k) 1 = half x φ (t1 + 3 * (K + (k - K))) 1
    rw [show K + (k - K) = k by omega]
  rw [hk_eq, show (k - K) = (k - K) % p + p * ((k - K) / p) from (Nat.mod_add_div _ _).symm,
      hper_mul]
  have hj := beq_iff_eq.1 (List.all_eq_true.1 hcw ((k - K) % p) (List.mem_range.2 (Nat.mod_lt _ hp)))
  rw [hd, rowW_getD_gate g p 0 _ (Nat.mod_lt _ hp), rowW_getD_gate g p 0 0 hp] at hj
  simpa [g] using hj

theorem periodic_gate_ten_reduces_to_five {x : Nat → Bool} {φ t1 K : Nat}
    (hph : (t1 + φ) % 3 = 1) (hK : 13 ≤ K)
    (hper : ∀ k, K ≤ k → half x φ (t1 + 3 * (k + 10)) 1 = half x φ (t1 + 3 * k) 1) :
    ∀ k, K ≤ k → half x φ (t1 + 3 * (k + 5)) 1 = half x φ (t1 + 3 * k) 1 := by
  let g : Nat → Bool := fun j => half x φ (t1 + 3 * (K + j)) 1
  let m : Nat := encBits (rowW 10 g 0)
  have hm_lt : m < 1024 := by have h := encBits_lt (rowW 10 g 0); rw [rowW_length] at h; exact h
  have hv : perWordValid 10 m = true := perWordValid_of_periodic_gate (by decide) hph hK hper
  have hd : decBits 10 m = rowW 10 g 0 := decBits_encBits_of_len (rowW_length 10 g 0)
  have hper_mul : ∀ j q, g (j + 10 * q) = g j := by
    intro j q; induction q with
    | zero => simp
    | succ q ih =>
      show half x φ (t1 + 3 * (K + (j + 10 * (q + 1)))) 1 = g j
      rw [Nat.mul_succ 10 q, show K + (j + (10 * q + 10)) = (K + (j + 10 * q)) + 10 by omega,
          hper _ (by omega)]; exact ih
  have h1 := List.all_eq_true.1 check_period_10_reduces_5 m (List.mem_range.2 hm_lt)
  rw [hv] at h1; simp only [Bool.not_true, Bool.false_or] at h1
  intro k hk
  have heq1 : half x φ (t1 + 3 * (k + 5)) 1 = g (((k - K) % 10 + 5) % 10) := by
    have ha : half x φ (t1 + 3 * (k + 5)) 1 = g (k - K + 5) := by
      show half x φ (t1 + 3 * (k + 5)) 1 = half x φ (t1 + 3 * (K + (k - K + 5))) 1
      rw [show K + (k - K + 5) = k + 5 by omega]
    have hdiv : k - K + 5 = ((k - K) % 10 + 5) % 10 + 10 * (((k - K) % 10 + 5) / 10 + (k - K) / 10) := by omega
    rw [ha, hdiv, hper_mul]
  have heq2 : half x φ (t1 + 3 * k) 1 = g ((k - K) % 10) := by
    have ha : half x φ (t1 + 3 * k) 1 = g (k - K) := by
      show half x φ (t1 + 3 * k) 1 = half x φ (t1 + 3 * (K + (k - K))) 1
      rw [show K + (k - K) = k by omega]
    have h2 : g (k - K) = g ((k - K) % 10) := by
      conv => lhs; rw [show k - K = (k - K) % 10 + 10 * ((k - K) / 10) from (Nat.mod_add_div _ _).symm]
      exact hper_mul _ _
    rw [ha, h2]
  have hj := beq_iff_eq.1 (List.all_eq_true.1 h1 ((k - K) % 10) (List.mem_range.2 (Nat.mod_lt _ (by decide))))
  rw [hd, rowW_getD_gate g 10 0 _ (Nat.mod_lt _ (by decide)),
      rowW_getD_gate g 10 0 _ (Nat.mod_lt _ (by decide)), Nat.zero_add, Nat.zero_add] at hj
  rw [heq1, heq2]; exact hj

theorem periodic_gate_five_eq_gate5 {x : Nat → Bool} {φ t1 K : Nat}
    (hph : (t1 + φ) % 3 = 1) (hK : 13 ≤ K)
    (hper : ∀ k, K ≤ k → half x φ (t1 + 3 * (k + 5)) 1 = half x φ (t1 + 3 * k) 1)
    (hnc : ∃ k, K ≤ k ∧ half x φ (t1 + 3 * k) 1 ≠ half x φ (t1 + 3 * K) 1) :
    ∃ r, r < 5 ∧ ∀ k, half x φ (t1 + 3 * (K + k)) 1 = gate5 (k + r) := by
  let g : Nat → Bool := fun j => half x φ (t1 + 3 * (K + j)) 1
  let m : Nat := encBits (rowW 5 g 0)
  have hm_lt : m < 32 := by have h := encBits_lt (rowW 5 g 0); rw [rowW_length] at h; exact h
  have hv : perWordValid 5 m = true := perWordValid_of_periodic_gate (by decide) hph hK hper
  have hd : decBits 5 m = rowW 5 g 0 := decBits_encBits_of_len (rowW_length 5 g 0)
  have hper_mul : ∀ j q, g (j + 5 * q) = g j := by
    intro j q; induction q with
    | zero => simp
    | succ q ih =>
      show half x φ (t1 + 3 * (K + (j + 5 * (q + 1)))) 1 = g j
      rw [Nat.mul_succ 5 q, show K + (j + (5 * q + 5)) = (K + (j + 5 * q)) + 5 by omega,
          hper _ (by omega)]; exact ih
  have hnotc : isConstWord 5 m = false := by
    by_cases hc : isConstWord 5 m = true
    · exfalso; obtain ⟨kn, hkn, hne⟩ := hnc; apply hne
      have heq : half x φ (t1 + 3 * kn) 1 = g ((kn - K) % 5) := by
        have h1 : half x φ (t1 + 3 * kn) 1 = g (kn - K) := by
          show half x φ (t1 + 3 * kn) 1 = half x φ (t1 + 3 * (K + (kn - K))) 1
          rw [show K + (kn - K) = kn by omega]
        have h2 : g (kn - K) = g ((kn - K) % 5) := by
          conv => lhs; rw [show kn - K = (kn - K) % 5 + 5 * ((kn - K) / 5) from (Nat.mod_add_div _ _).symm]
          exact hper_mul _ _
        rw [h1, h2]
      have hj := beq_iff_eq.1 (List.all_eq_true.1 hc ((kn - K) % 5)
        (List.mem_range.2 (Nat.mod_lt _ (by decide))))
      rw [hd, rowW_getD_gate g 5 0 _ (Nat.mod_lt _ (by decide)),
          rowW_getD_gate g 5 0 0 (by decide)] at hj
      rw [heq]; simpa [g] using hj
    · exact Bool.eq_false_iff.2 hc
  have h1 := List.all_eq_true.1 check_period_5_gate5 m (List.mem_range.2 hm_lt)
  rw [hv, hnotc] at h1; simp only [Bool.not_true, Bool.false_or] at h1
  have hany := h1
  obtain ⟨r, hr_mem, hr_all⟩ := List.any_eq_true.1 hany
  refine ⟨r, List.mem_range.1 hr_mem, fun k => ?_⟩
  have hk_div : k = k % 5 + 5 * (k / 5) := (Nat.mod_add_div k 5).symm
  change g k = gate5 (k + r)
  rw [hk_div, hper_mul]
  have hj := beq_iff_eq.1 (List.all_eq_true.1 hr_all (k % 5)
    (List.mem_range.2 (Nat.mod_lt k (by decide))))
  rw [hd, rowW_getD_gate g 5 0 (k % 5) (Nat.mod_lt k (by decide)), Nat.zero_add] at hj
  rw [hj]; unfold gate5
  rw [show (k % 5 + 5 * (k / 5) + r) % 5 = (k % 5 + r) % 5 by omega]

theorem periodic_gate_seven_dichotomy {x : Nat → Bool} {φ t1 K : Nat}
    (hph : (t1 + φ) % 3 = 1) (hK : 13 ≤ K)
    (hper : ∀ k, K ≤ k → half x φ (t1 + 3 * (k + 7)) 1 = half x φ (t1 + 3 * k) 1)
    (hnc : ∃ k, K ≤ k ∧ half x φ (t1 + 3 * k) 1 ≠ half x φ (t1 + 3 * K) 1) :
    ∃ r, r < 7 ∧ ((∀ k, half x φ (t1 + 3 * (K + k)) 1 = gate7 (k + r)) ∨
                  (∀ k, half x φ (t1 + 3 * (K + k)) 1 = gate7Four (k + r))) := by
  let g : Nat → Bool := fun j => half x φ (t1 + 3 * (K + j)) 1
  let m : Nat := encBits (rowW 7 g 0)
  have hm_lt : m < 128 := by have h := encBits_lt (rowW 7 g 0); rw [rowW_length] at h; exact h
  have hv : perWordValid 7 m = true := perWordValid_of_periodic_gate (by decide) hph hK hper
  have hd : decBits 7 m = rowW 7 g 0 := decBits_encBits_of_len (rowW_length 7 g 0)
  have hper_mul : ∀ j q, g (j + 7 * q) = g j := by
    intro j q; induction q with
    | zero => simp
    | succ q ih =>
      show half x φ (t1 + 3 * (K + (j + 7 * (q + 1)))) 1 = g j
      rw [Nat.mul_succ 7 q, show K + (j + (7 * q + 7)) = (K + (j + 7 * q)) + 7 by omega,
          hper _ (by omega)]; exact ih
  have hnotc : isConstWord 7 m = false := by
    by_cases hc : isConstWord 7 m = true
    · exfalso; obtain ⟨kn, hkn, hne⟩ := hnc; apply hne
      have heq : half x φ (t1 + 3 * kn) 1 = g ((kn - K) % 7) := by
        have h1 : half x φ (t1 + 3 * kn) 1 = g (kn - K) := by
          show half x φ (t1 + 3 * kn) 1 = half x φ (t1 + 3 * (K + (kn - K))) 1
          rw [show K + (kn - K) = kn by omega]
        have h2 : g (kn - K) = g ((kn - K) % 7) := by
          conv => lhs; rw [show kn - K = (kn - K) % 7 + 7 * ((kn - K) / 7) from (Nat.mod_add_div _ _).symm]
          exact hper_mul _ _
        rw [h1, h2]
      have hj := beq_iff_eq.1 (List.all_eq_true.1 hc ((kn - K) % 7)
        (List.mem_range.2 (Nat.mod_lt _ (by decide))))
      rw [hd, rowW_getD_gate g 7 0 _ (Nat.mod_lt _ (by decide)),
          rowW_getD_gate g 7 0 0 (by decide)] at hj
      rw [heq]; simpa [g] using hj
    · exact Bool.eq_false_iff.2 hc
  have h1 := List.all_eq_true.1 check_period_7_dichotomy m (List.mem_range.2 hm_lt)
  rw [hv, hnotc] at h1; simp only [Bool.not_true, Bool.false_or] at h1
  have hany := h1
  obtain ⟨r, hr_mem, hr_or⟩ := List.any_eq_true.1 hany
  rw [Bool.or_eq_true] at hr_or
  refine ⟨r, List.mem_range.1 hr_mem, ?_⟩
  rcases hr_or with hr_all | hr_all
  · left; intro k
    have hk_div : k = k % 7 + 7 * (k / 7) := (Nat.mod_add_div k 7).symm
    change g k = gate7 (k + r); rw [hk_div, hper_mul]
    have hj := beq_iff_eq.1 (List.all_eq_true.1 hr_all (k % 7) (List.mem_range.2 (Nat.mod_lt k (by decide))))
    rw [hd, rowW_getD_gate g 7 0 (k % 7) (Nat.mod_lt k (by decide)), Nat.zero_add] at hj
    rw [hj]; unfold gate7; rw [show (k % 7 + 7 * (k / 7) + r) % 7 = (k % 7 + r) % 7 by omega]
  · right; intro k
    have hk_div : k = k % 7 + 7 * (k / 7) := (Nat.mod_add_div k 7).symm
    change g k = gate7Four (k + r); rw [hk_div, hper_mul]
    have hj := beq_iff_eq.1 (List.all_eq_true.1 hr_all (k % 7) (List.mem_range.2 (Nat.mod_lt k (by decide))))
    rw [hd, rowW_getD_gate g 7 0 (k % 7) (Nat.mod_lt k (by decide)), Nat.zero_add] at hj
    rw [hj]; unfold gate7Four; rw [show (k % 7 + 7 * (k / 7) + r) % 7 = (k % 7 + r) % 7 by omega]

/-! ### 5. Singleton `001` Center Squeeze & Sharpened Target `C3g001Sharp` -/

def col1Forbidden001Sharp : List (List Bool) :=
  [[true, true, true, true, true], [false, false, false, false, false, false]] ++ gateForbidden14

theorem center_001_gate_not_const (T : Nat) (hT : ∀ t, T ≤ t → cell t 0 = wordAt3 w001 (t - T))
    (b : Bool) (K : Nat) :
    ¬ ∀ k, K ≤ k → cell (T + 1 + 3 * k) 1 = b := by
  intro hconst
  obtain ⟨T', _, hsk⟩ := skeleton_001 T hT
  refine Rule30MaskedJen.masked_jen_center (T := T) (P := 3) (by decide) ?_
    (max T' (T + 1 + 3 * K)) ?_
  · intro t ht
    rw [hT (t + 3) (by omega), hT t ht]; unfold wordAt3
    rw [show t + 3 - T = (t - T) + 1 * 3 by omega, Nat.add_mul_mod_self_right]
  · intro t ht hw
    rcases (by omega : (t - T) % 3 = 0 ∨ (t - T) % 3 = 1 ∨ (t - T) % 3 = 2) with h0 | h1 | h2
    · rw [hsk t (by omega) h0, hsk (t + 3) (by omega) (by omega)]
    · obtain ⟨k, rfl⟩ : ∃ k, t = T + 1 + 3 * k := ⟨(t - T - 1) / 3, by omega⟩
      rw [show T + 1 + 3 * k + 3 = T + 1 + 3 * (k + 1) by omega,
          hconst k (by omega), hconst (k + 1) (by omega)]
    · rw [hT t (by omega)] at hw; unfold wordAt3 at hw; rw [h2] at hw; nomatch hw

theorem no_five_ones_aux (x0 : Nat → Bool) (k2 : Nat) (hk2 : 13 ≤ k2)
    (hz : half x0 0 (1 + 3 * k2) 1 = false) :
    ∀ n, ¬ ∀ i, i < 5 → half x0 0 (1 + 3 * (k2 + n + i)) 1 = true
  | 0 => fun hall => by
    have h0 := hall 0 (by decide)
    simp only [Nat.add_zero] at h0; rw [hz] at h0; nomatch h0
  | n + 1 => fun hall => by
    cases hbm : half x0 0 (1 + 3 * (k2 + n)) 1
    · refine gate_avoids_from_13 x0 0 1 (k2 + n) (by decide) (by omega)
        (pat := [false, true, true, true, true, true]) (by simp [gateForbidden14]) ?_
      intro i hi; simp only [List.length_cons, List.length_nil] at hi
      by_cases hi0 : i = 0
      · subst hi0; rw [Nat.add_zero]; exact hbm
      · have hg : [false, true, true, true, true, true].getD i false = true := by
          rcases (by omega : i = 1 ∨ i = 2 ∨ i = 3 ∨ i = 4 ∨ i = 5) with rfl | rfl | rfl | rfl | rfl <;> rfl
        rw [hg, show k2 + n + i = k2 + (n + 1) + (i - 1) by omega]
        exact hall (i - 1) (by omega)
    · refine no_five_ones_aux x0 k2 hk2 hz n fun i hi => ?_
      by_cases hi0 : i = 0
      · subst hi0; rw [Nat.add_zero]; exact hbm
      · rw [show k2 + n + i = k2 + (n + 1) + (i - 1) by omega]
        exact hall (i - 1) (by omega)

theorem no_six_zeros_aux (x0 : Nat → Bool) (k1 : Nat) (hk1 : 13 ≤ k1)
    (ho : half x0 0 (1 + 3 * k1) 1 = true) :
    ∀ n, ¬ ∀ i, i < 6 → half x0 0 (1 + 3 * (k1 + n + i)) 1 = false
  | 0 => fun hall => by
    have h0 := hall 0 (by decide)
    simp only [Nat.add_zero] at h0; rw [ho] at h0; nomatch h0
  | n + 1 => fun hall => by
    cases hbm : half x0 0 (1 + 3 * (k1 + n)) 1
    · refine no_six_zeros_aux x0 k1 hk1 ho n fun i hi => ?_
      by_cases hi0 : i = 0
      · subst hi0; rw [Nat.add_zero]; exact hbm
      · rw [show k1 + n + i = k1 + (n + 1) + (i - 1) by omega]
        exact hall (i - 1) (by omega)
    · refine gate_avoids_from_13 x0 0 1 (k1 + n) (by decide) (by omega)
        (pat := [true, false, false, false, false, false, false]) (by simp [gateForbidden14]) ?_
      intro i hi; simp only [List.length_cons, List.length_nil] at hi
      by_cases hi0 : i = 0
      · subst hi0; rw [Nat.add_zero]; exact hbm
      · have hg : [true, false, false, false, false, false, false].getD i false = false := by
          rcases (by omega : i = 1 ∨ i = 2 ∨ i = 3 ∨ i = 4 ∨ i = 5 ∨ i = 6) with rfl | rfl | rfl | rfl | rfl | rfl <;> rfl
        rw [hg, show k1 + n + i = k1 + (n + 1) + (i - 1) by omega]
        exact hall (i - 1) (by omega)

theorem col1_001_sharp (T : Nat) (hT : ∀ t, T ≤ t → cell t 0 = wordAt3 w001 (t - T)) :
    ∃ T', T ≤ T' ∧ ∀ t, T' ≤ t → (t - T) % 3 = 1 → ∀ pat ∈ col1Forbidden001Sharp,
      ¬ ∀ i, i < pat.length → cell (t + 3 * i) 1 = pat.getD i false := by
  let x0 : Nat → Bool := fun p => cell T (p : Int)
  have hc : (fun u => cell (T + u) 0) = (fun u => wordAt3 w001 (u + 0)) := by
    funext u; rw [hT (T + u) (by omega)]; congr 1; omega
  have hcell : ∀ u, cell (T + u) 1 = half x0 0 u 1 := by
    intro u; unfold half; rw [← hc]; exact cell_eq_drv T u 1
  have ⟨k1, hk1_ge, hk1_val⟩ : ∃ k1, 13 ≤ k1 ∧ half x0 0 (1 + 3 * k1) 1 = true := by
    apply Classical.byContradiction; intro hall
    refine center_001_gate_not_const T hT false 13 fun k hk => ?_
    rw [show T + 1 + 3 * k = T + (1 + 3 * k) by omega, hcell]
    cases hb : half x0 0 (1 + 3 * k) 1
    · rfl
    · exfalso; exact hall ⟨k, hk, hb⟩
  have ⟨k2, hk2_ge, hk2_val⟩ : ∃ k2, k1 + 1 ≤ k2 ∧ half x0 0 (1 + 3 * k2) 1 = false := by
    apply Classical.byContradiction; intro hall
    refine center_001_gate_not_const T hT true (k1 + 1) fun k hk => ?_
    rw [show T + 1 + 3 * k = T + (1 + 3 * k) by omega, hcell]
    cases hb : half x0 0 (1 + 3 * k) 1
    · exfalso; exact hall ⟨k, hk, hb⟩
    · rfl
  refine ⟨T + 1 + 3 * k2, by omega, fun t ht hph pat hpat hm => ?_⟩
  obtain ⟨k, rfl⟩ : ∃ k, t = T + 1 + 3 * k := ⟨(t - T - 1) / 3, by omega⟩
  have hm_half : ∀ i, i < pat.length → half x0 0 (1 + 3 * (k + i)) 1 = pat.getD i false := by
    intro i hi; have e := hm i hi
    rw [show T + 1 + 3 * k + 3 * i = T + (1 + 3 * (k + i)) by omega, hcell] at e; exact e
  simp only [col1Forbidden001Sharp, List.mem_append, List.mem_cons, List.not_mem_nil, or_false] at hpat
  rcases hpat with (rfl | rfl) | hg
  · refine no_five_ones_aux x0 k2 (by omega) hk2_val (k - k2) fun i hi => ?_
    rw [show k2 + (k - k2) + i = k + i by omega]
    have e := hm_half i (by simp only [List.length_cons, List.length_nil]; omega)
    have hg : [true, true, true, true, true].getD i false = true := by
      rcases (by omega : i = 0 ∨ i = 1 ∨ i = 2 ∨ i = 3 ∨ i = 4) with rfl | rfl | rfl | rfl | rfl <;> rfl
    rw [hg] at e; exact e
  · refine no_six_zeros_aux x0 k1 hk1_ge hk1_val (k - k1) fun i hi => ?_
    rw [show k1 + (k - k1) + i = k + i by omega]
    have e := hm_half i (by simp only [List.length_cons, List.length_nil]; omega)
    have hg : [false, false, false, false, false, false].getD i false = false := by
      rcases (by omega : i = 0 ∨ i = 1 ∨ i = 2 ∨ i = 3 ∨ i = 4 ∨ i = 5) with
        rfl | rfl | rfl | rfl | rfl | rfl <;> rfl
    rw [hg] at e; exact e
  · exact gate_avoids_from_13 x0 0 1 k (by decide) (by omega) hg hm_half

theorem free_bits_001_sharp (T : Nat) (hT : ∀ t, T ≤ t → cell t 0 = wordAt3 w001 (t - T)) :
    ∃ T', T ≤ T' ∧ ∀ t, T' ≤ t → (t - T) % 3 = 1 → ∀ pat ∈ col1Forbidden001Sharp,
      ¬ ∀ i, i < pat.length → cell (t + 3 * i) (-1) = !pat.getD i false := by
  obtain ⟨T1, _, hc⟩ := col1_001_sharp T hT
  obtain ⟨T2, _, hs⟩ := col_m1_001_skeleton T hT
  refine ⟨T1 + T2, by omega, fun t ht hph pat hpat hm => hc t (by omega) hph pat hpat fun i hi => ?_⟩
  have e := (hs (t + 3 * i) (by omega)).2.1 (by omega)
  have e2 := e.symm.trans (hm i hi)
  simpa using e2

/-- **`C3g001Sharp`** (open). Strengthened restriction of `C3s001` incorporating `col1Forbidden001Sharp`. -/
def C3g001Sharp : Prop :=
  ∀ s : Int → Bool, (∃ M : Nat, ∀ p : Int, p < -(M : Int) → s p = false) →
    ¬ ∃ K, ∀ k, K ≤ k →
