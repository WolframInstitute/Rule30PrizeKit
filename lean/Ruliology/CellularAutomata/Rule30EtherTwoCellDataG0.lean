def dataAllG0 (p φ : Nat) : List (Nat × Nat × Nat) := (dataTabG0.getD (p - 1) []).getD φ []

def checkAllG0 : Bool :=
  (List.range 2).all (fun i =>
    (List.range 4).all (fun φ =>
      let p := i + 1
      ((dataAllG0 p φ).length == Mfun p φ - p - 1) && checkRange (dataAllG0 p φ) p φ))

theorem checkAllG0_ok : checkAllG0 = true := by decide

theorem checkAllG0_range (p φ : Nat) (hp0 : 1 ≤ p) (hp1 : p ≤ 2) (hφ : φ < 4) :
    (dataAllG0 p φ).length = Mfun p φ - p - 1 ∧ checkRange (dataAllG0 p φ) p φ = true := by
  have h := checkAllG0_ok
  unfold checkAllG0 at h
  have h1 := List.all_eq_true.1 h (p - 1) (List.mem_range.2 (by omega))
  have h2 := List.all_eq_true.1 h1 φ (List.mem_range.2 hφ)
  rw [show p - 1 + 1 = p by omega] at h2
  simp only [Bool.and_eq_true] at h2
  exact ⟨beq_iff_eq.1 h2.1, h2.2⟩

