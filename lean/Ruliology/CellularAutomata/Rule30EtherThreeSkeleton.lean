module

public import Ruliology.CellularAutomata.Rule30EtherThreeLeft
public import Ruliology.CellularAutomata.Rule30PeriodFourSkeleton

/-!
# Rule 30, least period 3: forced skeletons of the right half

Bad-class strip certificates (`Rule30PeriodFourSkeleton.Cert.sound_bad`, which works for any
period) for the words `001` and `011`:

* `skeleton_001`: if the center column is `001`-periodic from `T`, then eventually column `1` is
  white at phase `0`. (Strip width `4`; the bad class is the unique minimal closed set of the
  strip relaxation. Wider strips up to `13` force nothing more.)
* `skeleton_011`: if the center column is `011`-periodic from `T`, then eventually column `1` is
  black at phase `1` and white at phase `2` (strip width `3`; nothing more up to width `10`).

Consequence for the left half (`Rule30EtherThreeLeft`):
* `col_m1_001_skeleton`: under `001^∞`, column `-1` is eventually (white, `!` column `1`, black)
  at the phases (`0, 1, 2`); so `C3s001` (no finitely supported zero-boundary left configuration
  keeps column `-1` equal to `(0, *, 1)` for all large times) excludes `001^∞`
  (`not_eventually_001_of_C3s`). `C3s001` is weaker than the eventual form of `Q001`.
* For `011` the skeleton fixes column `1` only at the black phases, where column `-1` is already
  forced, so the left-only statement stays `C3w w011`.

Evidence for `C3s001` (C, not kernel-checked): every start of width `W ≤ 70` (all three phases)
violates the constraint `(0, *, 1)` by time `103`.
-/

@[expose] public section

namespace Ruliology.CellularAutomata
namespace Rule30EtherThree

open Rule30Jen Rule30StripCertificates Rule30PeriodFourSkeleton Rule30DrivenLeft

-- bad-class certificate for w = 001, strip width b = 4; generated by skel_export.py
def k001_w : List Bool := [false, false, true]
def k001_b : Nat := 4
def k001_nranks : Nat := 24
def k001_bad : Nat := 0
def k001_rankP : Nat := 213212421303344427838508674649118400400190746419365602602856074386364289303573589485016640806080348657122565938096435897015198183459314958195800626709598419339004665122940424266126163329678634322028496437612431562459608332173321
def k001_posP : Nat := 18347988927920572092886567162416695526372519918173340224413068222485105075154573938542859905789036108709888
def k001_perP : Nat := 24616085236810512799356036953755568740049862116637737217
def k001_wordP : Nat := 2967964817677254408726030252235766280421576189214542078968756673114766701278382406043796812734916539875172057112193672072216380411681014519610553861222718014999281265784389632

def K001 : Cert :=
  { w := k001_w, b := k001_b, nranks := k001_nranks, rankP := k001_rankP, posP := k001_posP, perP := k001_perP, wordP := k001_wordP }

/-- Skeleton predicate for `001` on the strip of columns `1..4`: column `1` white at phase `0`. -/
def skel001 (φ : Nat) (s : List Bool) : Bool := if φ = 0 then !(s.getD 0 false) else true

theorem K001_checkb : Cert.checkb K001 k001_bad = true := by decide +kernel
theorem K001_checkGb : Cert.checkGb K001 k001_bad = true := by decide +kernel
theorem K001_badImp : Cert.badImp K001 k001_bad skel001 = true := by decide +kernel

/-- **Skeleton for `001`.** If the center column is `001`-periodic from `T`, then eventually column
`1` is white at phase `0`. -/
theorem skeleton_001 (T : Nat) (h : ∀ t, T ≤ t → cell t 0 = wordAt3 w001 (t - T)) :
    ∃ T', T ≤ T' ∧ ∀ t, T' ≤ t → (t - T) % 3 = 0 → cell t 1 = false := by
  have hP : K001.P = 3 := by decide
  have h' : ∀ t, T ≤ t → cell t 0 = K001.wAt ((t - T) % K001.P) := by
    intro t ht; rw [h t ht, hP]; rfl
  obtain ⟨T', hT', hp⟩ := Cert.eventually_pred K001 k001_bad skel001 K001_checkb K001_checkGb
    K001_badImp (by decide) (by decide) T h'
  refine ⟨T', hT', fun t ht hφ => ?_⟩
  have e := hp t ht
  rw [hP, hφ] at e
  have h0 : (rowR t K001.b).getD 0 false = cell t 1 := rowR_getD t K001.b 0 (by decide)
  simp only [skel001, h0] at e
  simpa using e

-- bad-class certificate for w = 011, strip width b = 3; generated by skel_export.py
def k011_w : List Bool := [false, true, true]
def k011_b : Nat := 3
def k011_nranks : Nat := 10
def k011_bad : Nat := 0
def k011_rankP : Nat := 3607361407700544023876026429907536790974072451887713670943892148761564917026271248421661018053444207673140576262
def k011_posP : Nat := 0
def k011_perP : Nat := 4740885567116192841985
def k011_wordP : Nat := 0

def K011 : Cert :=
  { w := k011_w, b := k011_b, nranks := k011_nranks, rankP := k011_rankP, posP := k011_posP, perP := k011_perP, wordP := k011_wordP }

/-- Skeleton predicate for `011` on the strip of columns `1..3`: column `1` black at phase `1`,
white at phase `2`. -/
def skel011 (φ : Nat) (s : List Bool) : Bool :=
  if φ = 1 then s.getD 0 false else if φ = 2 then !(s.getD 0 false) else true

theorem K011_checkb : Cert.checkb K011 k011_bad = true := by decide +kernel
theorem K011_checkGb : Cert.checkGb K011 k011_bad = true := by decide +kernel
theorem K011_badImp : Cert.badImp K011 k011_bad skel011 = true := by decide +kernel

/-- **Skeleton for `011`.** If the center column is `011`-periodic from `T`, then eventually column
`1` is black at phase `1` and white at phase `2`. -/
theorem skeleton_011 (T : Nat) (h : ∀ t, T ≤ t → cell t 0 = wordAt3 w011 (t - T)) :
    ∃ T', T ≤ T' ∧ ∀ t, T' ≤ t →
      ((t - T) % 3 = 1 → cell t 1 = true) ∧ ((t - T) % 3 = 2 → cell t 1 = false) := by
  have hP : K011.P = 3 := by decide
  have h' : ∀ t, T ≤ t → cell t 0 = K011.wAt ((t - T) % K011.P) := by
    intro t ht; rw [h t ht, hP]; rfl
  obtain ⟨T', hT', hp⟩ := Cert.eventually_pred K011 k011_bad skel011 K011_checkb K011_checkGb
    K011_badImp (by decide) (by decide) T h'
  refine ⟨T', hT', fun t ht => ⟨fun hφ => ?_, fun hφ => ?_⟩⟩
  · have e := hp t ht
    rw [hP, hφ] at e
    have h0 : (rowR t K011.b).getD 0 false = cell t 1 := rowR_getD t K011.b 0 (by decide)
    simp only [skel011, h0] at e
    exact e
  · have e := hp t ht
    rw [hP, hφ] at e
    have h0 : (rowR t K011.b).getD 0 false = cell t 1 := rowR_getD t K011.b 0 (by decide)
    simp only [skel011, h0] at e
    simpa using e

/-! ### The left half for `001` with the skeleton -/

/-- **Column `-1` under `001`, with the skeleton**: eventually (white, `!` column `1`, black) at the
phases (`0, 1, 2`). -/
theorem col_m1_001_skeleton (T : Nat) (h : ∀ t, T ≤ t → cell t 0 = wordAt3 w001 (t - T)) :
    ∃ T', T ≤ T' ∧ ∀ t, T' ≤ t →
      ((t - T) % 3 = 0 → cell t (-1) = false) ∧ ((t - T) % 3 = 1 → cell t (-1) = !cell t 1) ∧
      ((t - T) % 3 = 2 → cell t (-1) = true) := by
  obtain ⟨T', hT', hs⟩ := skeleton_001 T h
  refine ⟨T', hT', fun t ht => ⟨fun hφ => ?_, fun hφ => ?_, fun hφ => ?_⟩⟩
  · rw [(col_m1_001 T h t (by omega)).1 hφ]; exact hs t ht hφ
  · exact (col_m1_001 T h t (by omega)).2.1 hφ
  · exact (col_m1_001 T h t (by omega)).2.2 hφ

/-- The pattern `(0, *, 1)` for column `-1` under `001` with the skeleton. -/
def colPattern001s : List (Option Bool) := [some false, none, some true]

/-- **`C3s001`** (open). No finitely supported left configuration of the zero-boundary left half
keeps column `-1` equal to `(0, *, 1)` (phases `0, 1, 2`) for all large times. -/
def C3s001 : Prop :=
  ∀ s : Int → Bool, (∃ M : Nat, ∀ p : Int, p < -(M : Int) → s p = false) →
    ¬ ∃ K, ∀ k, K ≤ k → fits3 colPattern001s (k % 3) (L (fun _ => false) s k (-1)) = true

theorem fits3_001s (φ : Nat) (b : Bool) :
    fits3 colPattern001s φ b = (if φ = 0 then b == false else if φ = 2 then b == true else true) := by
  rcases Nat.lt_or_ge φ 3 with h | h
  · have : φ = 0 ∨ φ = 1 ∨ φ = 2 := by omega
    rcases this with rfl | rfl | rfl <;> rfl
  · unfold fits3
    rw [List.getD_eq_getElem?_getD, List.getElem?_eq_none (by simp [colPattern001s]; omega)]
    simp [show φ ≠ 0 by omega, show φ ≠ 2 by omega]

/-- **`C3s001` excludes `001^∞`** as a tail of the center column, for every transient. -/
theorem not_eventually_001_of_C3s (hC : C3s001) :
    ¬ ∃ T, ∀ t, T ≤ t → cell t 0 = wordAt3 w001 (t - T) := by
  rintro ⟨T, hT⟩
  obtain ⟨T', hT', hs⟩ := col_m1_001_skeleton T hT
  have hfun : (fun k => Rule30Prize.center (T + k) && Rule30Prize.center (T + k + 1)) = fun _ => false := by
    funext k
    show (cell (T + k) 0 && cell (T + k + 1) 0) = false
    rw [hT (T + k) (by omega), hT (T + k + 1) (by omega), wordAt3_001, wordAt3_001,
      show T + k - T = k by omega, show T + k + 1 - T = k + 1 by omega]
    have : k % 3 = 0 ∨ k % 3 = 1 ∨ k % 3 = 2 := by omega
    rcases this with h | h | h
    · rw [h, show (k + 1) % 3 = 1 by omega]; rfl
    · rw [h, show (k + 1) % 3 = 2 by omega]; rfl
    · rw [h, show (k + 1) % 3 = 0 by omega]; rfl
  refine hC (fun p => cell T p) ⟨T, fun p hp => cell_eq_false_of_lt T p hp⟩ ⟨T' - T, fun k hk => ?_⟩
  have e := cell_eq_L_effective T k (-1) (by omega)
  rw [hfun] at e
  rw [e, fits3_001s]
  obtain ⟨s0, -, s2⟩ := hs (T + k) (by omega)
  have hk3 : (T + k - T) % 3 = k % 3 := by rw [show T + k - T = k by omega]
  have : k % 3 = 0 ∨ k % 3 = 1 ∨ k % 3 = 2 := by omega
  rcases this with h | h | h
  · rw [ite_eq_left h, s0 (by omega)]; rfl
  · rw [ite_eq_right (by omega), ite_eq_right (by omega)]
  · rw [ite_eq_right (by omega), ite_eq_left h, s2 (by omega)]; rfl

/-! ### Skeleton Pattern Monotonicity, Full Period-3 Exclusion, and `011` Phase Complementarity -/

/-- **Skeleton Pattern Refinement (`fits3_001s_imp_fits3_001`):** fitting the skeleton pattern
`colPattern001s` (`(0, *, 1)`) implies fitting the bare left-permutivity pattern `colPattern3 w001`
(`(*, *, 1)`). -/
theorem fits3_001s_imp_fits3_001 (φ : Nat) (b : Bool)
    (h : fits3 colPattern001s φ b = true) :
    fits3 (colPattern3 w001) φ b = true := by
  rw [fits3_001s] at h
  rcases Nat.lt_or_ge φ 3 with hlt | hge
  · have : φ = 0 ∨ φ = 1 ∨ φ = 2 := by omega
    rcases this with rfl | rfl | rfl
    · rfl
    · rfl
    · simpa [fits3, colPattern3, w001] using h
  · unfold fits3
    rw [List.getD_eq_getElem?_getD, List.getElem?_eq_none (by simp [colPattern3, w001]; omega)]; rfl

/-- **Effective Boundary Identity for `w001` (`wordAt3_effWord3_001`):** the effective boundary of
`w001` is identically `false` at every time step `k`. -/
theorem wordAt3_effWord3_001 (k : Nat) :
    wordAt3 (effWord3 w001) k = false := by
  rw [effWord3_001]
  unfold wordAt3
  have : k % 3 = 0 ∨ k % 3 = 1 ∨ k % 3 = 2 := by omega
  rcases this with h | h | h <;> rw [h] <;> rfl

/-- **`C3w w001` Implies `C3s001` (`C3s001_of_C3w_001`):** the skeleton-augmented statement `C3s001`
follows unconditionally from the bare left-only statement `C3w w001`. -/
theorem C3s001_of_C3w_001 (hC : C3w w001) : C3s001 := by
  intro s hs ⟨K, hK⟩
  have heff : (fun k => wordAt3 (effWord3 w001) k) = (fun _ => false) := by
    funext k; exact wordAt3_effWord3_001 k
  refine hC s hs ⟨K, fun k hk => ?_⟩
  rw [heff]
  exact fits3_001s_imp_fits3_001 (k % 3) _ (hK k hk)

/-- **Universal Neighbor Complementarity Under `011^∞` (`col_m1_eq_not_p1_all_phases_011`):** if the
center column is `011`-periodic from `T`, then once the right strip enters the bad class at `T'`,
column `-1` is the exact complement `!cell t 1` of column `1` at **every** time `t ≥ T'` across all
three phases `0, 1, 2`. -/
theorem col_m1_eq_not_p1_all_phases_011 (T : Nat)
    (h : ∀ t, T ≤ t → cell t 0 = wordAt3 w011 (t - T)) :
    ∃ T', T ≤ T' ∧ ∀ t, T' ≤ t → cell t (-1) = !cell t 1 := by
  obtain ⟨T', hT', hs⟩ := skeleton_011 T h
  refine ⟨T', hT', fun t ht => ?_⟩
  obtain ⟨m0, m1, m2⟩ := col_m1_011 T h t (by omega)
  obtain ⟨s1, s2⟩ := hs t ht
  have : (t - T) % 3 = 0 ∨ (t - T) % 3 = 1 ∨ (t - T) % 3 = 2 := by omega
  rcases this with hφ | hφ | hφ
  · exact m0 hφ
  · rw [m1 hφ, s1 hφ]; rfl
  · rw [m2 hφ, s2 hφ]; rfl

/-- **Phase-Locked Opposite Values at Black Steps Under `011^∞` (`col_m1_p1_black_phases_011`):**
under `011^∞`, for all `t ≥ T'`, `(cell t (-1), cell t 1) = (false, true)` at phase `1` and
`(true, false)` at phase `2`. -/
theorem col_m1_p1_black_phases_011 (T : Nat)
    (h : ∀ t, T ≤ t → cell t 0 = wordAt3 w011 (t - T)) :
    ∃ T', T ≤ T' ∧ ∀ t, T' ≤ t →
      ((t - T) % 3 = 1 → cell t (-1) = false ∧ cell t 1 = true) ∧
      ((t - T) % 3 = 2 → cell t (-1) = true ∧ cell t 1 = false) := by
  obtain ⟨T', hT', hs⟩ := skeleton_011 T h
  refine ⟨T', hT', fun t ht => ⟨fun h1 => ?_, fun h2 => ?_⟩⟩
  · exact ⟨(col_m1_011 T h t (by omega)).2.1 h1, (hs t ht).1 h1⟩
  · exact ⟨(col_m1_011 T h t (by omega)).2.2 h2, (hs t ht).2 h2⟩

/-- **Three-Step Phase-Locking Under `001^∞` (`col_m1_001_skeleton_triple`):** under `001^∞`, for
every `k` with `T' ≤ T + 3 * k`, column `-1` satisfies `cell (T + 3 * k) (-1) = false`,
`cell (T + 3 * k + 1) (-1) = !cell (T + 3 * k + 1) 1`, and `cell (T + 3 * k + 2) (-1) = true`. -/
theorem col_m1_001_skeleton_triple (T : Nat)
    (h : ∀ t, T ≤ t → cell t 0 = wordAt3 w001 (t - T)) :
    ∃ T', T ≤ T' ∧ ∀ k, T' ≤ T + 3 * k →
      cell (T + 3 * k) (-1) = false ∧
      cell (T + 3 * k + 1) (-1) = !cell (T + 3 * k + 1) 1 ∧
      cell (T + 3 * k + 2) (-1) = true := by
  obtain ⟨T', hT', hs⟩ := col_m1_001_skeleton T h
  refine ⟨T', hT', fun k hk => ⟨?_, ?_, ?_⟩⟩
  · exact (hs (T + 3 * k) hk).1 (by omega)
  · exact (hs (T + 3 * k + 1) (by omega)).2.1 (by omega)
  · exact (hs (T + 3 * k + 2) (by omega)).2.2 (by omega)

/-! ### Free-Phase Aperiodicity for `C3s001` and `C3w w011`, Closed-Form Left Columns `-1` Through `-6`, and Exact Column-`-6` Phase-1 Return -/

/-- **Eventual Periodicity of `wordAt3` (`eventuallyPeriodic_wordAt3`):** for any 3-bit word `w`,
`fun k => wordAt3 w k` is 3-periodic and hence `EventuallyPeriodic`. -/
theorem eventuallyPeriodic_wordAt3 (w : List Bool) :
    EventuallyPeriodic (fun k => wordAt3 w k) :=
  ⟨0, 3, by decide, fun t _ => by simp [wordAt3]⟩

/-- **Fixed-Phase Readout for `colPattern001s` (`phase_periodic_of_fits3_001s`):** if column `-1`
fits `colPattern001s` (`(0, *, 1)`) from `K` on, then every phase `φ < 3` with `φ ≠ 1` is
3-periodic from `K` on. -/
theorem phase_periodic_of_fits3_001s {c : Nat → Bool} {s : Int → Bool} {K : Nat}
    (hfits : ∀ k, K ≤ k → fits3 colPattern001s (k % 3) (L c s k (-1)) = true) :
    ∀ k, K ≤ k → k % 3 ≠ 1 → L c s (k + 3) (-1) = L c s k (-1) := by
  intro k hk hne
  have hk1 := hfits k hk
  have hk2 := hfits (k + 3) (by omega)
  rw [Nat.add_mod_right, fits3_001s] at hk2
  rw [fits3_001s] at hk1
  have : k % 3 = 0 ∨ k % 3 = 2 := by omega
  rcases this with hmod | hmod <;> rw [hmod] at hk1 hk2
  · simp only [↓reduceIte, beq_iff_eq] at hk1 hk2; rw [hk1, hk2]
  · simp only [show (2 : Nat) ≠ 0 by decide, ↓reduceIte, beq_iff_eq] at hk1 hk2; rw [hk1, hk2]

/-- **Free-Phase Aperiodicity Under `colPattern001s` (`not_eventuallyPeriodic_free_phase_of_fits3_001s`):**
for any left-bounded start `s` with a black cell on `p < 0`, if column `-1` under the zero driver
`fun _ => false` fits `colPattern001s` from `K` on, then the phase-1 free bit stream
`fun m => L (fun _ => false) s (3 * m + 1) (-1)` is not eventually periodic. -/
theorem not_eventuallyPeriodic_free_phase_of_fits3_001s {s : Int → Bool} {M K : Nat}
    (hM : ∀ p : Int, p < -(M : Int) → s p = false)
    (hne : ∃ p : Int, p < 0 ∧ s p = true)
    (hfits : ∀ k, K ≤ k → fits3 colPattern001s (k % 3) (L (fun _ => false) s k (-1)) = true) :
    ¬ EventuallyPeriodic (fun m => L (fun _ => false) s (3 * m + 1) (-1)) :=
  not_eventuallyPeriodic_free_phase_of_bounded (by decide : 0 < 3) (by decide : 1 < 3) hM (Or.inl hne)
    ⟨0, 1, by decide, fun _ _ => rfl⟩
    (phase_periodic_of_fits3_001s hfits)

/-- **Cofinal Free-Phase Oscillation Under `colPattern001s` (`cofinal_free_phase_of_fits3_001s`):**
under the hypotheses of `not_eventuallyPeriodic_free_phase_of_fits3_001s`, the phase-1 free bit
stream `L (fun _ => false) s (3 * m + 1) (-1)` takes both `true` and `false` infinitely often. -/
theorem cofinal_free_phase_of_fits3_001s {s : Int → Bool} {M K : Nat}
    (hM : ∀ p : Int, p < -(M : Int) → s p = false)
    (hne : ∃ p : Int, p < 0 ∧ s p = true)
    (hfits : ∀ k, K ≤ k → fits3 colPattern001s (k % 3) (L (fun _ => false) s k (-1)) = true)
    (N : Nat) :
    (∃ m, N ≤ m ∧ L (fun _ => false) s (3 * m + 1) (-1) = true) ∧
    (∃ m, N ≤ m ∧ L (fun _ => false) s (3 * m + 1) (-1) = false) :=
  cofinal_true_and_false_free_phase_of_bounded (by decide : 0 < 3) (by decide : 1 < 3) hM (Or.inl hne)
    ⟨0, 1, by decide, fun _ _ => rfl⟩
    (phase_periodic_of_fits3_001s hfits) N

/-- **Free-Phase Aperiodicity Under `colPattern3 w011` (`not_eventuallyPeriodic_free_phase_of_fits3_011`):**
for any left-bounded start `s`, if column `-1` under `effWord3 w011` fits `colPattern3 w011` from
`K` on, then the phase-0 free bit stream `fun m => L (fun k => wordAt3 (effWord3 w011) k) s (3 * m) (-1)`
is not eventually periodic. -/
theorem not_eventuallyPeriodic_free_phase_of_fits3_011 {s : Int → Bool} {M K : Nat}
    (hM : ∀ p : Int, p < -(M : Int) → s p = false)
    (hfits : ∀ k, K ≤ k →
      fits3 (colPattern3 w011) (k % 3) (L (fun k => wordAt3 (effWord3 w011) k) s k (-1)) = true) :
    ¬ EventuallyPeriodic (fun m => L (fun k => wordAt3 (effWord3 w011) k) s (3 * m) (-1)) := by
  have hact : (∃ p : Int, p < 0 ∧ s p = true) ∨ (∃ t : Nat, wordAt3 (effWord3 w011) t = true) :=
    Or.inr ⟨1, by decide⟩
  have hper : ∀ k, K ≤ k → k % 3 ≠ 0 →
      L (fun k => wordAt3 (effWord3 w011) k) s (k + 3) (-1) =
        L (fun k => wordAt3 (effWord3 w011) k) s k (-1) := by
    intro k hk hne
    have hk1 := hfits k hk
    have hk2 := hfits (k + 3) (by omega)
    rw [Nat.add_mod_right] at hk2
    have : k % 3 = 1 ∨ k % 3 = 2 := by omega
    rcases this with hmod | hmod <;> rw [hmod] at hk1 hk2
    · have e1 : L (fun k => wordAt3 (effWord3 w011) k) s k (-1) = false := by
        revert hk1; cases L (fun k => wordAt3 (effWord3 w011) k) s k (-1) <;> decide
      have e2 : L (fun k => wordAt3 (effWord3 w011) k) s (k + 3) (-1) = false := by
        revert hk2; cases L (fun k => wordAt3 (effWord3 w011) k) s (k + 3) (-1) <;> decide
      rw [e1, e2]
    · have e1 : L (fun k => wordAt3 (effWord3 w011) k) s k (-1) = true := by
        revert hk1; cases L (fun k => wordAt3 (effWord3 w011) k) s k (-1) <;> decide
      have e2 : L (fun k => wordAt3 (effWord3 w011) k) s (k + 3) (-1) = true := by
        revert hk2; cases L (fun k => wordAt3 (effWord3 w011) k) s (k + 3) (-1) <;> decide
      rw [e1, e2]
  simpa using not_eventuallyPeriodic_free_phase_of_bounded (by decide : 0 < 3) (by decide : 0 < 3) hM hact
    (eventuallyPeriodic_wordAt3 (effWord3 w011)) hper

/-- **Column `-1` Phase Table Under `colPattern001s` (`col3_neg1_of_fits3_001s`):** for `K ≤ 3 * m`,
column `-1` at steps `3 * m` and `3 * m + 2` is `(false, true)`. -/
theorem col3_neg1_of_fits3_001s {c : Nat → Bool} {s : Int → Bool} {K m : Nat}
    (hfits : ∀ k, K ≤ k → fits3 colPattern001s (k % 3) (L c s k (-1)) = true)
    (hm : K ≤ 3 * m) :
    L c s (3 * m) (-1) = false ∧ L c s (3 * m + 2) (-1) = true := by
  have h0 := hfits (3 * m) hm
  have h2 := hfits (3 * m + 2) (by omega)
  rw [show (3 * m) % 3 = 0 by omega, fits3_001s] at h0
  rw [show (3 * m + 2) % 3 = 2 by omega, fits3_001s] at h2
  simp only [show (2 : Nat) ≠ 0 by decide, ↓reduceIte, beq_iff_eq] at h0 h2
  exact ⟨h0, h2⟩

/-- **Column `-2` Closed Form Under `colPattern001s` (`col3_neg2_of_fits3_001s`):** for `K ≤ 3 * m`
under the zero driver `fun _ => false`, column `-2` at phases `0, 1, 2` equals
`(u m, !u m, true)` where `u m = L (fun _ => false) s (3 * m + 1) (-1)`. -/
theorem col3_neg2_of_fits3_001s {s : Int → Bool} {K m : Nat}
    (hfits : ∀ k, K ≤ k → fits3 colPattern001s (k % 3) (L (fun _ => false) s k (-1)) = true)
    (hm : K ≤ 3 * m) :
    let c0 : Nat → Bool := fun _ => false
    L c0 s (3 * m) (-2) = L c0 s (3 * m + 1) (-1) ∧
    L c0 s (3 * m + 1) (-2) = !L c0 s (3 * m + 1) (-1) ∧
    L c0 s (3 * m + 2) (-2) = true := by
  intro c0
  obtain ⟨h1_0, h1_2⟩ := col3_neg1_of_fits3_001s hfits hm
  obtain ⟨h1_3, _⟩ := col3_neg1_of_fits3_001s hfits (m := m + 1) (by omega)
  have step0 := L_left (c := c0) (s := s) (p := -1) (3 * m) (by decide)
  have step1 := L_left (c := c0) (s := s) (p := -1) (3 * m + 1) (by decide)
  have step2 := L_left (c := c0) (s := s) (p := -1) (3 * m + 2) (by decide)
  simp only [show (-1 : Int) - 1 = -2 by decide, show (-1 : Int) + 1 = 0 by decide,
    show 3 * m + 2 + 1 = 3 * (m + 1) by omega] at step0 step1 step2
  have hz0 : L c0 s (3 * m) 0 = false := by cases (3 * m) <;> rfl
  have hz1 : L c0 s (3 * m + 1) 0 = false := rfl
  have hz2 : L c0 s (3 * m + 2) 0 = false := rfl
  rw [hz2] at step2
  rw [hz0] at step0
  rw [hz1] at step1
  rw [h1_0] at step0
  rw [h1_2] at step1
  rw [h1_2, h1_3] at step2
  refine ⟨?_, ?_, ?_⟩
  · rw [step0]; cases L c0 s (3 * m + 1) (-1) <;> rfl
  · rw [step1]; cases L c0 s (3 * m + 1) (-1) <;> rfl
  · rw [step2]; rfl

/-- **Column `-3` Closed Form Under `colPattern001s` (`col3_neg3_of_fits3_001s`):** for `K ≤ 3 * m`
under `fun _ => false`, column `-3` at phases `0, 1, 2` equals `(true, false, !u (m + 1))`. -/
theorem col3_neg3_of_fits3_001s {s : Int → Bool} {K m : Nat}
    (hfits : ∀ k, K ≤ k → fits3 colPattern001s (k % 3) (L (fun _ => false) s k (-1)) = true)
    (hm : K ≤ 3 * m) :
    let c0 : Nat → Bool := fun _ => false
    L c0 s (3 * m) (-3) = true ∧
    L c0 s (3 * m + 1) (-3) = false ∧
    L c0 s (3 * m + 2) (-3) = !L c0 s (3 * (m + 1) + 1) (-1) := by
  intro c0
  obtain ⟨h1_0, h1_2⟩ := col3_neg1_of_fits3_001s hfits hm
  obtain ⟨h2_0, h2_1, h2_2⟩ := col3_neg2_of_fits3_001s hfits hm
  obtain ⟨h2_3, _, _⟩ := col3_neg2_of_fits3_001s hfits (m := m + 1) (by omega)
  have step0 := L_left (c := c0) (s := s) (p := -2) (3 * m) (by decide)
  have step1 := L_left (c := c0) (s := s) (p := -2) (3 * m + 1) (by decide)
  have step2 := L_left (c := c0) (s := s) (p := -2) (3 * m + 2) (by decide)
  simp only [show (-2 : Int) - 1 = -3 by decide, show (-2 : Int) + 1 = -1 by decide,
    show 3 * m + 2 + 1 = 3 * (m + 1) by omega] at step0 step1 step2
  rw [h2_0, h2_1, h1_0] at step0
  rw [h2_1, h2_2] at step1
  rw [h2_2, h2_3, h1_2] at step2
  refine ⟨?_, ?_, ?_⟩
  · rw [step0]; cases L c0 s (3 * m + 1) (-1) <;> rfl
  · rw [step1]; cases L c0 s (3 * m + 1) (-1) <;> rfl
  · rw [step2]; cases L c0 s (3 * (m + 1) + 1) (-1) <;> rfl

/-- **Column `-4` Closed Form Under `colPattern001s` (`col3_neg4_of_fits3_001s`):** for `K ≤ 3 * m`
under `fun _ => false`, column `-4` restores unconditional `(true, false)` walls at phases `0, 2`
and computes the 1-step XOR derivative `xor (u m) (u (m + 1))` at phase `1`. -/
theorem col3_neg4_of_fits3_001s {s : Int → Bool} {K m : Nat}
    (hfits : ∀ k, K ≤ k → fits3 colPattern001s (k % 3) (L (fun _ => false) s k (-1)) = true)
    (hm : K ≤ 3 * m) :
    let c0 : Nat → Bool := fun _ => false
    L c0 s (3 * m) (-4) = true ∧
    L c0 s (3 * m + 1) (-4) = xor (L c0 s (3 * m + 1) (-1)) (L c0 s (3 * (m + 1) + 1) (-1)) ∧
    L c0 s (3 * m + 2) (-4) = false := by
  intro c0
  obtain ⟨h2_0, h2_1, h2_2⟩ := col3_neg2_of_fits3_001s hfits hm
  obtain ⟨h3_0, h3_1, h3_2⟩ := col3_neg3_of_fits3_001s hfits hm
  obtain ⟨h3_3, _, _⟩ := col3_neg3_of_fits3_001s hfits (m := m + 1) (by omega)
  have step0 := L_left (c := c0) (s := s) (p := -3) (3 * m) (by decide)
  have step1 := L_left (c := c0) (s := s) (p := -3) (3 * m + 1) (by decide)
  have step2 := L_left (c := c0) (s := s) (p := -3) (3 * m + 2) (by decide)
  simp only [show (-3 : Int) - 1 = -4 by decide, show (-3 : Int) + 1 = -2 by decide,
    show 3 * m + 2 + 1 = 3 * (m + 1) by omega] at step0 step1 step2
  rw [h3_0, h3_1, h2_0] at step0
  rw [h3_1, h3_2, h2_1] at step1
  rw [h3_2, h3_3, h2_2] at step2
  refine ⟨?_, ?_, ?_⟩
  · rw [step0]; cases L c0 s (3 * m + 1) (-1) <;> rfl
  · rw [step1]; cases L c0 s (3 * m + 1) (-1) <;> cases L c0 s (3 * (m + 1) + 1) (-1) <;> rfl
  · rw [step2]; cases L c0 s (3 * (m + 1) + 1) (-1) <;> rfl

/-- **Column `-5` Closed Form Under `colPattern001s` (`col3_neg5_of_fits3_001s`):** for `K ≤ 3 * m`
under `fun _ => false`, column `-5` at phases `0, 1, 2` equals
