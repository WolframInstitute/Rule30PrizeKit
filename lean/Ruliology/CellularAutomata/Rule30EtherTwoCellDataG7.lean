def dataAllG7 (p φ : Nat) : List (Nat × Nat × Nat) := (dataTabG7.getD (p - 12) []).getD φ []

def checkAllG7 : Bool :=
  (List.range 1).all (fun i =>
    (List.range 4).all (fun φ =>
      let p := i + 12
      ((dataAllG7 p φ).length == Mfun p φ - p - 1) && checkRange (dataAllG7 p φ) p φ))

theorem checkAllG7_ok : checkAllG7 = true := by decide

theorem checkAllG7_range (p φ : Nat) (hp0 : 12 ≤ p) (hp1 : p ≤ 12) (hφ : φ < 4) :
    (dataAllG7 p φ).length = Mfun p φ - p - 1 ∧ checkRange (dataAllG7 p φ) p φ = true := by
  have h := checkAllG7_ok
  unfold checkAllG7 at h
  have h1 := List.all_eq_true.1 h (p - 12) (List.mem_range.2 (by omega))
  have h2 := List.all_eq_true.1 h1 φ (List.mem_range.2 hφ)
  rw [show p - 12 + 12 = p by omega] at h2
  simp only [Bool.and_eq_true] at h2
  exact ⟨beq_iff_eq.1 h2.1, h2.2⟩

