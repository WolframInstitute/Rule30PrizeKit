def dataAllG10 (p φ : Nat) : List (Nat × Nat × Nat) := (dataTabG10.getD (p - 16) []).getD φ []

def checkAllG10 : Bool :=
  (List.range 2).all (fun i =>
    (List.range 4).all (fun φ =>
      let p := i + 16
      ((dataAllG10 p φ).length == Mfun p φ - p - 1) && checkRange (dataAllG10 p φ) p φ))

theorem checkAllG10_ok : checkAllG10 = true := by decide

theorem checkAllG10_range (p φ : Nat) (hp0 : 16 ≤ p) (hp1 : p ≤ 17) (hφ : φ < 4) :
    (dataAllG10 p φ).length = Mfun p φ - p - 1 ∧ checkRange (dataAllG10 p φ) p φ = true := by
  have h := checkAllG10_ok
  unfold checkAllG10 at h
  have h1 := List.all_eq_true.1 h (p - 16) (List.mem_range.2 (by omega))
  have h2 := List.all_eq_true.1 h1 φ (List.mem_range.2 hφ)
  rw [show p - 16 + 16 = p by omega] at h2
  simp only [Bool.and_eq_true] at h2
  exact ⟨beq_iff_eq.1 h2.1, h2.2⟩

